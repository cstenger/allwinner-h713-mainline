From 1ff9c9ea2da73bb4a0a42d5fc3e517407d03fee1 Mon Sep 17 00:00:00 2001
From: Christopher Stenger <chris.h.stenger@gmail.com>
Date: Sat, 22 Aug 2026 18:02:55 -0700
Subject: [PATCH] h265: do not claim DEBLOCKING_FILTER_CONTROL_PRESENT for
 every stream

UNTESTED BEYOND COMPILING -- offered as a suggestion, not as a validated
change. It is inert on cedrus, which references neither this flag nor
UNIFORM_SPACING, so this project's bit-exactness gate cannot score it
either way.

The current derivation sets the flag whenever deblocking is enabled, which
is the common case, so it reports "control present" for the many streams
whose PPS codes deblocking_filter_control_present_flag = 0. VA-API does not
expose that field, so an inference is unavoidable -- but per 7.3.2.3.1 both
deblocking_filter_override_enabled_flag and
pps_deblocking_filter_disabled_flag are only coded when it is 1, so either
being set implies it and neither being set leaves it unknowable. Inferring
from those two is never wrong, where the current form frequently is.
---
 src/h265.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/src/h265.c b/src/h265.c
index 8c1f5e8..17bab3e 100644
--- a/src/h265.c
+++ b/src/h265.c
@@ -114,8 +114,15 @@ static void h265_fill_pps(VAPictureParameterBufferHEVC *picture,
 		pps->flags |= V4L2_HEVC_PPS_FLAG_LISTS_MODIFICATION_PRESENT;
 	if (picture->slice_parsing_fields.bits.slice_segment_header_extension_present_flag)
 		pps->flags |= V4L2_HEVC_PPS_FLAG_SLICE_SEGMENT_HEADER_EXTENSION_PRESENT;
+	/*
+	 * VA-API does not expose deblocking_filter_control_present_flag, so it
+	 * has to be inferred. Both of the flags below are only *coded* in the
+	 * PPS when it is 1 (7.3.2.3.1), so either one being set implies it;
+	 * neither being set leaves it genuinely unknown, and claiming "present"
+	 * there is wrong for every stream that simply leaves deblocking on.
+	 */
 	if (picture->slice_parsing_fields.bits.deblocking_filter_override_enabled_flag ||
-	    !picture->slice_parsing_fields.bits.pps_disable_deblocking_filter_flag)
+	    picture->slice_parsing_fields.bits.pps_disable_deblocking_filter_flag)
 		pps->flags |= V4L2_HEVC_PPS_FLAG_DEBLOCKING_FILTER_CONTROL_PRESENT;
 }
 
