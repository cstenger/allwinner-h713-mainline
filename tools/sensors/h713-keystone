#!/bin/sh
# h713-keystone -- the projector's tilt, for automatic keystone and ceiling
# detection. RUNS ON THE TARGET, as root. Needs kernel 0168 (the SC7A20
# accelerometer on st_accel, with the projector's mount-matrix).
#
#   h713-keystone                          status: settings, tilt, what is applied
#   h713-keystone auto|off [--persist]     keystone follows the tilt, or none
#   h713-keystone manual DEG [--persist]   a fixed correction, in degrees
#   h713-keystone ceiling auto|off [--persist]
#                                          top/bottom flip follows gravity
#   h713-keystone daemon                   the sensor loop (h713-keystone.service)
#
# The daemon samples the sensor about ten times a second and acts only once
# the projector has been still for about a second, so a hand on the stand
# does not make the picture swim. It publishes /run/h713-keystone/state:
#
#   keystone_deg   the correction the picture warp applies: the settled pitch
#                  in auto, DEG in manual, 0 when off
#   pitch_deg      lens tilt toward the projector's own top (its +Y), so it
#                  keeps its meaning upside down; +90 = pointing at its top
#   roll_deg       the projector's right side above the horizon
#   inverted       1 when upside down (ceiling); held near vertical
#   settled        0 while it is moving; the last correction stays applied
#
# Both angles are in the projector's frame before the panel mirror; the warp
# composes h713-mirror's mode itself.
#
# Ceiling auto changes only the top/bottom half of the installation mode:
# turning the projector over is front <-> ceiling and rear <-> rear-ceiling
# (h713-mirror's number XOR 3), so front/rear stays your choice. It is off by
# default, so an h713-mirror --persist setting is left alone.
#
# Settings: /etc/h713-keystone.conf with --persist, else /run/h713-keystone/conf
# until the next boot. The daemon rereads them every second.
#
# Tests point H713_KEYSTONE_DEV, _RUN, _ETC and H713_MIRROR_ATTR at fakes.
set -u
RUN=${H713_KEYSTONE_RUN:-/run/h713-keystone}
ETC=${H713_KEYSTONE_ETC:-/etc/h713-keystone.conf}
STATE=$RUN/state
MIRROR=${H713_MIRROR_ATTR-$(ls /sys/bus/platform/drivers/sun50i-h713-afbd/*/mirror_mode 2>/dev/null | head -1)}

usage() { sed -n '6,11p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
die() { echo "h713-keystone: $*" >&2; exit 1; }

find_dev() {
	[ -n "${H713_KEYSTONE_DEV:-}" ] && { echo "$H713_KEYSTONE_DEV"; return 0; }
	for n in /sys/bus/iio/devices/iio:device*/name; do
		[ -r "$n" ] && [ "$(cat "$n")" = sc7a20 ] && { dirname "$n"; return 0; }
	done
	return 1
}

# The settings file in force: the runtime one if a non-persisted change made it.
conf() { if [ -f "$RUN/conf" ]; then echo "$RUN/conf"; else echo "$ETC"; fi; }

get() { # KEY DEFAULT
	v=$(sed -n "s/^$1=//p" "$(conf)" 2>/dev/null | tail -1)
	echo "${v:-$2}"
}

set_conf() { # PERSIST KEY=VALUE...
	p=$1; shift
	src=$(conf); tmp=$(mktemp) || die "mktemp failed"
	[ -f "$src" ] && grep -v '^#' "$src" > "$tmp"
	for kv in "$@"; do
		k=${kv%%=*}
		grep -v "^$k=" "$tmp" > "$tmp.n"; mv "$tmp.n" "$tmp"
		echo "$kv" >> "$tmp"
	done
	if [ "$p" = 1 ]; then
		{ echo "# Written by h713-keystone --persist."; cat "$tmp"; } > "$ETC.tmp" &&
			mv "$ETC.tmp" "$ETC" || die "could not write $ETC"
		rm -f "$RUN/conf" "$tmp"
		echo "h713-keystone: saved to $ETC"
	else
		mkdir -p "$RUN" && mv "$tmp" "$RUN/conf" || die "could not write $RUN/conf"
		chmod 0644 "$RUN/conf"
	fi
}

# The sensor loop. ONCE=1 takes one settled window, prints it and exits.
loop() { # DEV ONCE
	dev=$1
	# Every sysfs read powers the chip up for one sample; at the 1 Hz default
	# that is a second per axis. 100 Hz makes a read about 25 ms.
	echo 100 > "$dev/sampling_frequency" 2>/dev/null
	awk -v dev="$dev" -v once="$2" -v run="$RUN" -v etc="$ETC" \
	    -v mirror="$MIRROR" '
	function rd(f,   v) { v = ""; getline v < f; close(f); return v }
	function now(   u) { split(rd("/proc/uptime"), u, " "); return u[1] + 0 }
	function abs(x) { return x < 0 ? -x : x }
	function deg(r) { return r * 57.29577951 }
	function conf(   f, line, k, v) {
		ks = "auto"; manual = 0; ceil = "off"
		f = run "/conf"
		if ((getline line < f) < 0) f = etc
		close(run "/conf")	# reopened below, from its first line
		while ((getline line < f) > 0) {
			if (line ~ /^#/ || line !~ /=/) continue
			k = substr(line, 1, index(line, "=") - 1)
			v = substr(line, index(line, "=") + 1)
			if (k == "keystone") ks = v
			else if (k == "manual_deg") manual = v + 0
			else if (k == "ceiling") ceil = v
		}
		close(f)
	}
	function sample(   i, c) {
		for (i = 0; i < 3; i++) c[i] = rd(dev "/in_accel_" ax[i] "_raw") * scale
		# The mount-matrix maps the chip onto the projector frame.
		for (i = 0; i < 3; i++)
			g[i] = (mm[i,0] * c[0] + mm[i,1] * c[1] + mm[i,2] * c[2]) / 9.80665
	}
	function d1(x) { x = sprintf("%.1f", x); return x == "-0.0" ? "0.0" : x }
	function publish(   f) {
		f = run "/state.tmp"
		printf "keystone_deg=%s\n", d1(applied) > f
		printf "pitch_deg=%s\nroll_deg=%s\n", d1(pitch), d1(roll) > f
		printf "inverted=%d\nsettled=%d\n", inverted, settled > f
		printf "keystone=%s\nceiling=%s\nupdated=%.1f\n", ks, ceil, now() > f
		close(f)
		system("mv " f " " run "/state")
	}
	function follow_gravity(   m, want, r) {
		if (ceil != "auto" || mirror == "") return
		m = rd(mirror) + 0
		if (int(m / 2) % 2 == inverted) return
		if (now() < retry_at) return
		want = 3 - m		# m XOR 3: flips top/bottom, keeps front/rear
		r = system("h713-mirror " want " >/dev/null 2>&1")
		if (r == 0)
			printf "h713-keystone: %s -> installation mode %d\n", inverted ? "upside down" : "upright", want
		else {
			printf "h713-keystone: h713-mirror %d refused (10-bit video on the plane?); retrying in 10 s\n", want
			retry_at = now() + 10
		}
		fflush()
	}
	BEGIN {
		split("x y z", t, " "); ax[0] = t[1]; ax[1] = t[2]; ax[2] = t[3]
		scale = rd(dev "/in_accel_x_scale") + 0
		n = split(rd(dev "/mount_matrix"), t, /[;,] */)
		for (i = 0; i < 9; i++) mm[int(i / 3), i % 3] = (n == 9) ? t[i + 1] + 0 : (i % 4 == 0)
		W = 10			# window, samples: ~0.7 s at ODR 100
		STILL = 0.06		# g, per-axis SD; the sensor alone is 0.015-0.037
		inverted = 0; settled = 0; applied = 0; pitch = 0; roll = 0
		have = 0; retry_at = 0; fresh = 0
		system("mkdir -p " run)
		conf()
		for (;;) {
			for (k = 0; k < W; k++) {
				sample()
				for (i = 0; i < 3; i++) win[k, i] = g[i]
			}
			moving = 0
			for (i = 0; i < 3; i++) {
				s = 0; for (k = 0; k < W; k++) s += win[k, i]; m[i] = s / W
				s = 0; for (k = 0; k < W; k++) s += (win[k, i] - m[i]) ^ 2
				if (sqrt(s / W) > STILL) moving = 1
			}
			conf()
			if (moving) {
				fresh = 0
				if (settled) { settled = 0; if (!once) publish() }
				continue
			}
			# Upside down past half a g either way; held in between, so a
			# lens pointing at the ceiling does not flip the picture.
			if (m[1] < -0.5) inverted = 1
			else if (m[1] > 0.5) inverted = 0
			sgn = inverted ? -1 : 1
			p = deg(atan2(-m[2] * sgn, abs(m[1])))
			r = deg(atan2(m[0], sqrt(m[1] ^ 2 + m[2] ^ 2)))
			# One window is ~0.6 deg of noise. Average the still windows since
			# the last move, so a new pose shows at once and then steadies;
			# a jump past 1.5 deg is a new pose, not noise.
			if (!fresh || abs(p - ep) > 1.5 || abs(r - er) > 1.5) { ep = p; er = r; fresh = 1 }
			else { ep += 0.2 * (p - ep); er += 0.2 * (r - er) }
			# Half a degree of hysteresis: noise must not redraw the warp.
			if (!have || abs(ep - pitch) >= 0.5 || abs(er - roll) >= 0.5) { pitch = ep; roll = er }
			want = (ks == "auto") ? pitch : (ks == "manual") ? manual : 0
			changed = !have || !settled || want != applied || ks != last_ks || ceil != last_ceil
			last_ks = ks; last_ceil = ceil
			settled = 1; applied = want; have = 1
			if (once) break
			follow_gravity()
			if (changed) publish()
		}
		if (once) {
			printf "pitch %+.1f deg  roll %+.1f deg  %s  (g %+.3f %+.3f %+.3f)\n", pitch, roll, inverted ? "upside down" : "upright", m[0], m[1], m[2]
		}
	}'
}

status() {
	echo "keystone: $(get keystone auto)$( [ "$(get keystone auto)" = manual ] && echo " $(get manual_deg 0) deg")   ceiling: $(get ceiling off)   ($(conf))"
	[ -n "$MIRROR" ] && echo "installation mode: $(h713-mirror 2>/dev/null)"
	if [ -f "$STATE" ] && systemctl is-active -q h713-keystone 2>/dev/null; then
		echo "daemon: running; $STATE:"
		sed 's/^/  /' "$STATE"
	else
		echo "daemon: not running; one live reading:"
		dev=$(find_dev) || die "no sc7a20 IIO device -- kernel without 0168?"
		printf '  '; loop "$dev" 1
	fi
}

persist=0; args=
for a in "$@"; do
	case $a in
	--persist) persist=1 ;;
	-h|--help) usage ;;
	*) args="$args $a" ;;
	esac
done
set -- $args

case ${1:-} in
'')	status ;;
auto|off)
	[ $# = 1 ] || usage
	set_conf $persist "keystone=$1"
	echo "h713-keystone: keystone $1" ;;
manual)
	[ $# = 2 ] || usage
	case $2 in *[!0-9.+-]*|'') die "manual takes degrees, e.g. 'manual 12' or 'manual -5'" ;; esac
	set_conf $persist keystone=manual "manual_deg=$2"
	echo "h713-keystone: keystone manual $2 deg" ;;
ceiling)
	[ $# = 2 ] || usage
	case $2 in auto|off) ;; *) usage ;; esac
	[ "$2" = auto ] && [ -z "$MIRROR" ] && die "no mirror_mode attribute -- kernel without 0166?"
	set_conf $persist "ceiling=$2"
	echo "h713-keystone: ceiling $2" ;;
daemon)
	dev=$(find_dev) || die "no sc7a20 IIO device -- kernel without 0168?"
	echo "h713-keystone: sensor $dev, mirror ${MIRROR:-unavailable}"
	loop "$dev" 0 ;;
*)	usage ;;
esac
