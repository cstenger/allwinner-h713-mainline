#!/bin/bash
# Play a video file on the H713 projector by the cheapest route that can show
# it correctly. RUNS ON THE TARGET.
#
# WP4 of docs/gpu-fallback-plan.md. Three routes, all on stock players:
#
#   plane-native  a picture already at its fit size (1280x720; with letterbox
#                 also e.g. 960x720 or 1280x536), any of H.264/HEVC/VP9/AV1:
#                 stock v4l2sl*dec ! kmssink, zero-copy onto the video plane.
#   plane-ve      H.264/HEVC/VP9 larger than its fit: va*dec with the VE
#                 decode-time scaler down to the fit size, onto the video
#                 plane. Without letterbox only a 1280x720 fit qualifies.
#                 VP9 needs kernel 0167, detected by asking cedrus.
#   plane-up      a picture SMALLER than its fit (480p, 576p, 360p), any of
#                 H.264/HEVC/VP9/AV1: stock v4l2sl*dec ! kmssink; kmssink
#                 commits its aspect-fit destination and the display's proc
#                 block magnifies (kernel 0163, up to 4x per axis). Square
#                 pixels only: stock kmssink mishandles the source rectangle
#                 for any other SAR, so those take the GPU.
#   gpu           everything else: stock mpv --vo=gpu with the cheap scaling
#                 settings WP2 measured (1080p real time in every codec).
#
# The plane routes leave the GPU idle and cost ~5% whole-board CPU with audio,
# against ~17% on the GPU path (2026-10-03). They exist only where the plane
# can show the picture as is. With kernel 0161 (letterbox, detected from the
# DRM minimum framebuffer size) the plane shows any NV12 picture up to the
# panel unscaled and centred by kmssink, with black bars; without it, exactly
# 1280x720. Kernel 0163 adds magnification, detected from the plane's
# SCALING_FILTER property. The plane cannot rotate 90/270 and has no
# downscaler;
# the VE scaler downscales H.264,
# HEVC and VP9 (kernel 0167, WP6); AV1 has none. 10-bit goes to the GPU route: the VE
# scaler cannot output it. There, V4L2_REQUEST_LSB10_LINEAR=1 lets mpv's
# interop accept P010 at all (libva patch 0008). 10-bit AV1 then arrives as
# the AV1 core's LSB-aligned samples and needs shaders/lsb10.glsl (x64; 10-bit
# intermediates keep it at ~40% GPU); 10-bit HEVC arrives as cedrus's 8-bit
# NV12 and must NOT get the shader.
#
#   usage: h713-play [--dry-run] [--route=auto|plane|gpu] FILE [-- MPV-ARGS...]
#
# Prints one "h713-play:" line with the probe and the decision, then plays.
# --route=plane fails if the plane cannot show FILE; MPV-ARGS reach mpv only.
set -euo pipefail

PANEL_W=1280
PANEL_H=720
VA_MAX=4096	# cedrus and megi's VA driver: 4K bit-exact (2026-10-03)
CHEAP=(--scale=bilinear --dscale=bilinear --cscale=bilinear --dither-depth=no
       --deband=no --correct-downscaling=no --linear-downscaling=no
       --sigmoid-upscaling=no --hdr-compute-peak=no)

dry=0 route=auto
while [ $# -gt 0 ]; do
	case $1 in
	--dry-run) dry=1 ;;
	--route=*) route=${1#--route=} ;;
	-h|--help) sed -n '2,/^set -e/p' "$0" | sed 's/^# \{0,1\}//;$d'; exit 0 ;;
	--) shift; break ;;
	-*) echo "h713-play: unknown option $1" >&2; exit 2 ;;
	*) [ -z "${file:-}" ] && file=$1 || { echo "h713-play: one FILE" >&2; exit 2; } ;;
	esac
	shift
done
case $route in auto|plane|gpu) ;; *) echo "h713-play: bad --route" >&2; exit 2 ;; esac
[ -n "${file:-}" ] && [ -r "$file" ] || { echo "usage: h713-play [--dry-run] [--route=auto|plane|gpu] FILE [-- MPV-ARGS...]" >&2; exit 2; }

# --- probe -------------------------------------------------------------------
codec= w=0 h=0 cw=0 ch=0 sar= pix= rot=0
while IFS== read -r k v; do
	case $k in
	codec_name) codec=$v ;;
	width) w=$v ;;
	height) h=$v ;;
	coded_width) cw=$v ;;
	coded_height) ch=$v ;;
	sample_aspect_ratio) sar=$v ;;
	pix_fmt) pix=$v ;;
	rotation) rot=$v ;;
	esac
done < <(ffprobe -v error -select_streams v:0 \
	-show_entries stream=codec_name,width,height,coded_width,coded_height,sample_aspect_ratio,pix_fmt:stream_side_data=rotation \
	-of default=nw=1 "$file")
[ -n "$codec" ] && [ "$w" -gt 0 ] && [ "$h" -gt 0 ] || { echo "h713-play: no video stream in $file" >&2; exit 1; }

case $pix in *10*|*12*) depth=10 ;; *) depth=8 ;; esac
rot=$(( ((${rot%.*} % 360) + 360) % 360 ))
case $sar in [1-9]*:[1-9]*) sn=${sar%:*} sd=${sar#*:} ;; *) sn=1 sd=1 ;; esac

# Display size (SAR applied, then rotation), aspect-fit into the panel, even.
dw=$(( w * sn )) dh=$(( h * sd ))
if [ $rot = 90 ] || [ $rot = 270 ]; then t=$dw; dw=$dh; dh=$t; fi
if [ $(( dw * PANEL_H )) -ge $(( dh * PANEL_W )) ]; then
	fw=$PANEL_W fh=$(( (PANEL_W * dh / dw + 1) / 2 * 2 ))
else
	fh=$PANEL_H fw=$(( (PANEL_H * dw / dh + 1) / 2 * 2 ))
fi

# --- route ---------------------------------------------------------------------
case $codec in
h264) gst=h264 ;;
hevc) gst=h265 ;;
vp9) gst=vp9 ;;
av1) gst=av1 ;;
*) gst= ;;
esac

# Read what the kernel can do from DRM, never from a kernel version.
# Letterbox (kernel 0161) lowers the minimum framebuffer width below the
# panel's (DRM_IOCTL_MODE_GETRESOURCES). Magnification (kernel 0163) gives
# the video plane a SCALING_FILTER property, the standard "this plane scales".
# Neither needs DRM master. Prints "MIN_W SCALES".
read -r min_w scales < <(python3 - <<'PY' 2>/dev/null || echo "$PANEL_W 0"
import ctypes, fcntl, glob, os, struct
def ioctl(fd, req, buf):
    fcntl.ioctl(fd, req, buf, True)
for dev in sorted(glob.glob("/dev/dri/card*")):
    fd = os.open(dev, os.O_RDWR)
    try:
        res = bytearray(64)
        ioctl(fd, 0xC04064A0, res)              # DRM_IOCTL_MODE_GETRESOURCES
    except OSError:
        os.close(fd)
        continue
    min_w, scales = struct.unpack_from("<I", res, 48)[0], 0
    pr = bytearray(16)
    ioctl(fd, 0xC01064B5, pr)                   # DRM_IOCTL_MODE_GETPLANERESOURCES
    n = struct.unpack_from("<I", pr, 8)[0]
    ids = (ctypes.c_uint32 * max(n, 1))()
    struct.pack_into("<QI", pr, 0, ctypes.addressof(ids), n)
    ioctl(fd, 0xC01064B5, pr)
    for plane in ids[:n]:
        op = bytearray(32)
        struct.pack_into("<QQIII", op, 0, 0, 0, 0, plane, 0xEEEEEEEE)
        ioctl(fd, 0xC02064B9, op)               # DRM_IOCTL_MODE_OBJ_GETPROPERTIES
        cnt = struct.unpack_from("<I", op, 16)[0]
        props = (ctypes.c_uint32 * max(cnt, 1))()
        vals = (ctypes.c_uint64 * max(cnt, 1))()
        struct.pack_into("<QQIII", op, 0, ctypes.addressof(props),
                         ctypes.addressof(vals), cnt, plane, 0xEEEEEEEE)
        ioctl(fd, 0xC02064B9, op)
        for pid in props[:cnt]:
            gp = bytearray(64)
            struct.pack_into("<QQI", gp, 0, 0, 0, pid)
            ioctl(fd, 0xC04064AA, gp)           # DRM_IOCTL_MODE_GETPROPERTY
            if gp[24:56].split(b"\0")[0] == b"SCALING_FILTER":
                scales = 1
    os.close(fd)
    print(min_w, scales)
    break
PY
)
letterbox=0
[ "${min_w:-$PANEL_W}" -lt $PANEL_W ] && letterbox=1

# Whether cedrus scales VP9 (kernel 0167): with VP9 on a fresh context's
# OUTPUT queue, VIDIOC_ENUM_FRAMESIZES offers NV12 as a STEPWISE range only
# where the scaler is admitted (0119), and the single coded size otherwise.
# A fresh m2m context touches no running decode. Prints 1 or 0.
ve_scales_vp9() {
	python3 - <<'PY' 2>/dev/null || echo 0
import fcntl, glob, os, struct
def fourcc(s): return struct.unpack("<I", s.encode())[0]
for dev in sorted(glob.glob("/dev/video*")):
    try:
        fd = os.open(dev, os.O_RDWR)
    except OSError:
        continue
    try:
        cap = bytearray(104)
        fcntl.ioctl(fd, 0x80685600, cap, True)          # VIDIOC_QUERYCAP
        if cap[:16].split(b"\0")[0] != b"cedrus":
            continue
        fmt = bytearray(208)                            # v4l2_format, OUTPUT
        struct.pack_into("<I", fmt, 0, 2)
        struct.pack_into("<III", fmt, 8, 1920, 1080, fourcc("VP9F"))
        fcntl.ioctl(fd, 0xC0D05605, fmt, True)          # VIDIOC_S_FMT
        fs = bytearray(44)                              # v4l2_frmsizeenum
        struct.pack_into("<II", fs, 0, 0, fourcc("NV12"))
        fcntl.ioctl(fd, 0xC02C564A, fs, True)           # VIDIOC_ENUM_FRAMESIZES
        print(1 if struct.unpack_from("<I", fs, 8)[0] == 3 else 0)
        raise SystemExit
    except OSError:
        pass
    finally:
        os.close(fd)
print(0)
PY
}
magnify=0
[ $letterbox = 1 ] && [ "${scales:-0}" = 1 ] && magnify=1

why=
if [ -z "$gst" ]; then why="codec $codec has no plane decoder"
elif [ $depth != 8 ]; then why="10-bit"
elif [ $rot != 0 ]; then why="rotated $rot"
elif [ $letterbox = 0 ] && { [ $fw != $PANEL_W ] || [ $fh != $PANEL_H ]; }; then why="fits as ${fw}x${fh}, the plane shows only ${PANEL_W}x${PANEL_H} (no letterbox in this kernel)"
elif [ $gst = h265 ] && { [ $cw != $w ] || [ $ch != $h ]; } && [ $w -le $fw ] && [ $h -le $fh ]; then
	# Stock v4l2slh265dec copies every frame of a conformance-cropped stream
	# (852x480 coded as 856) instead of passing the crop on; the CPU reads
	# cedrus's buffers uncached, ~53 ms a frame (2026-10-05), so the copy
	# alone cannot keep up. The GPU path decodes through VA-API, no copy.
	why="HEVC with a conformance crop (coded ${cw}x${ch}); stock v4l2slh265dec copies every frame"
elif [ $w = $fw ] && [ $h = $fh ]; then plane=native
elif [ $sn != $sd ] && [ $w -le $fw ] && [ $h -le $fh ]; then
	# Stock kmssink (1.26) puts the pixel-aspect correction into the SOURCE
	# rectangle (720x576 at 16:15 is read as 768x576 from a 720-wide
	# buffer), which no driver can honour. plane-ve is unaffected: the VE
	# lands on square pixels and gst-plane-play declares them 1:1.
	why="non-square pixels (sar $sn:$sd); stock kmssink cannot show them scaled"
elif [ $w -le $fw ] && [ $h -le $fh ]; then
	# Smaller than its fit on both axes (anamorphic SAR included): proc
	# magnifies, up to 4x per axis, in display (SAR-corrected) units.
	if [ $magnify = 0 ]; then why="smaller than its ${fw}x${fh} fit and this kernel cannot magnify (kernel 0163)"
	elif [ $fw -gt $(( 4 * w )) ] || [ $fh -gt $(( 4 * h )) ]; then why="more than 4x to its ${fw}x${fh} fit"
	elif [ $(( w % 2 )) = 1 ] || [ $(( h % 2 )) = 1 ]; then why="odd size ${w}x${h}"
	else plane=up
	fi
elif [ $gst = av1 ]; then why="no VE scaler for $codec"
elif [ $gst = vp9 ] && [ "$(ve_scales_vp9)" != 1 ]; then why="this kernel's VE does not scale VP9 (kernel 0167)"
elif [ $w -lt $fw ] || [ $h -lt $fh ]; then why="needs magnifying on one axis and shrinking on the other (${w}x${h} -> ${fw}x${fh})"
elif [ $w -gt $VA_MAX ] || [ $h -gt $VA_MAX ]; then why="larger than the VA driver's ${VA_MAX} cap"
else plane=ve
fi

if [ $route = plane ] && [ -n "$why" ]; then
	echo "h713-play: $file cannot go on the plane: $why" >&2
	exit 1
fi
[ $route = gpu ] && { plane=; why="--route=gpu"; }
[ -n "$why" ] && plane=

probe="$codec ${w}x${h} sar $sn:$sd rot $rot ${depth}-bit -> fit ${fw}x${fh}"
player=$(command -v gst-plane-play || echo "$(dirname "$0")/gst-plane-play")

case ${plane:-} in
native)
	echo "h713-play: $probe: plane-native (v4l2sl${gst}dec ! kmssink)"
	cmd=("$player" "$file" "$gst" "v4l2sl${gst}dec")
	;;
up)
	echo "h713-play: $probe: plane-up (v4l2sl${gst}dec ! kmssink, proc magnifies ${w}x${h} -> ${fw}x${fh})"
	cmd=("$player" "$file" "$gst" "v4l2sl${gst}dec")
	;;
ve)
	echo "h713-play: $probe: plane-ve (va${gst}dec, VE scaler ${w}x${h} -> ${fw}x${fh}, kmssink)"
	export LIBVA_DRIVER_NAME=v4l2_request GST_VA_ALL_DRIVERS=1
	export V4L2_REQUEST_SCALE=${fw}x${fh} V4L2_REQUEST_CROP=${w}x${h}
	cmd=("$player" "$file" "$gst" "va${gst}dec" "${fw}x${fh}")
	;;
*)
	export LIBVA_DRIVER_NAME=v4l2_request
	extra=()
	note=
	if [ $depth = 10 ]; then
		export V4L2_REQUEST_LSB10_LINEAR=1
		if [ "$codec" = av1 ]; then
			shader=
			for d in "${H713_SHARE:-/usr/local/share/h713}" "$(dirname "$0")/shaders"; do
				[ -r "$d/lsb10.glsl" ] && { shader=$d/lsb10.glsl; break; }
			done
			[ -n "$shader" ] || { echo "h713-play: lsb10.glsl not found" >&2; exit 1; }
			extra=(--glsl-shaders="$shader" --fbo-format=rgb10_a2)
			note=", LSB10 x64 shader"
		fi
	fi
	echo "h713-play: $probe: gpu ($why; mpv --vo=gpu$note)"
	cmd=(mpv --vo=gpu --gpu-context=drm --hwdec=vaapi "${CHEAP[@]}" "${extra[@]}" "$@" "$file")
	;;
esac

[ $dry = 1 ] && { printf 'h713-play: would run:'; printf ' %q' "${cmd[@]}"; echo; exit 0; }
exec "${cmd[@]}"
