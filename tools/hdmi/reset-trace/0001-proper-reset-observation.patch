--- /dev/null
+++ b/include/h713_reset_trace.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/* Bench-only observation. No peripheral, SRAM, DSP protocol or reset writes. */
+#ifndef H713_RESET_TRACE_H
+#define H713_RESET_TRACE_H
+#include <asm/io.h>
+#include <linux/types.h>
+#include <stdio.h>
+
+static inline void h713_reset_trace(const char *stage, bool with_status)
+{
+	u32 gp6 = readl(0x07090118UL);
+	u32 gp7 = readl(0x0709011cUL);
+	u32 mips_clk = readl(0x02001600UL);
+	u32 mips_reset = readl(0x0200160cUL);
+	u32 status = 0;
+
+	/* No MIPS CPUCFG access from the optional pre-DRAM SPL probe. */
+	if (with_status)
+		status = readl(0x0306101cUL);
+	printf("H713 RESET v1 stage=%s gp6=%08x gp7=%08x "
+	       "mips_clk=%08x mips_reset=%08x ",
+	       stage, gp6, gp7, mips_clk, mips_reset);
+	if (with_status)
+		printf("mips_status=%08x\n", status);
+	else
+		printf("mips_status=unread\n");
+}
+#endif
