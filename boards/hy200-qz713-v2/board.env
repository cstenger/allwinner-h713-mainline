# Board identity for installer guards (tools/board-guard.py). Sources:
# DT from patches/kernel (sun50i-h713-hy200-qz713-v2.dts); DRAM from the
# board's own stock boot0 header (capture 2026-11-18, LBA 16: type 7, 720 MHz);
# serial# as U-Boot prints it (sid[0], then crc32 of sid[1..3]); SID
# 03400042:2c004818:01059514:5c821e57.
BOARD_ID=hy200-qz713-v2
BOARD_ROLE="projector"
DT_COMPATIBLE=cstenger,hy200-qz713-v2
DT_MODEL="HY200 QZ713_V2 Projector (Allwinner H713)"
DRAM_TYPE=7
DRAM_CLK=720
UBOOT_DEFCONFIG=hy200_qz713_v2_defconfig
UBOOT_SERIAL=034000427a29544e
UBOOT_SERIAL_SOURCE="observed: our U-Boot printenv serial# on this board, 2026-11-19"
