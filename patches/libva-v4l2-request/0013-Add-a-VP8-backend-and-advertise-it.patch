+ * THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+ * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+ * FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+ * DEALINGS IN THE SOFTWARE.
+ */
+
+#include "vp8.h"
+#include "context.h"
+#include "request.h"
+#include "surface.h"
+
+#include <assert.h>
+#include <string.h>
+
+#include <linux/videodev2.h>
+
+#include "v4l2.h"
+
+/*
+ * VA-API's key_frame is INVERTED with respect to the name: the header says
+ * "0 means a key frame", and ffmpeg fills it as !s->keyframe.  V4L2's flag is
+ * set when the frame IS a key frame, so the two are not a straight copy.
+ */
+static bool vp8_is_key_frame(const VAPictureParameterBufferVP8 *picture)
+{
+	return picture->pic_fields.bits.key_frame == 0;
+}
+
+/*
+ * The size of the first (control) partition, which V4L2 wants and VA-API does
+ * not send directly.  ffmpeg computes what it does send as
+ *
+ *	partition_size[0] = header_partition_size - ((macroblock_offset + 7) / 8)
+ *
+ * -- the bytes of the control partition still unread once it has parsed the
+ * frame header itself -- so inverting that recovers the whole partition
+ * exactly.  Deriving it from slice_data_size instead is wrong as soon as there
+ * is more than one token partition.
+ */
+static unsigned int vp8_first_part_size(const VASliceParameterBufferVP8 *slice)
+{
+	return slice->partition_size[0] + ((slice->macroblock_offset + 7) / 8);
+}
+
+/*
+ * ffmpeg hands over the slice data with the uncompressed data chunk already
+ * stripped:
+ *
+ *	header_size = 3 + 7 * s->keyframe;
+ *	data = buffer + header_size;
+ *
+ * cedrus wants it back.  It starts the bitstream engine at header_size * 8
+ * (VE_H264_VLD_OFFSET) and looks for the partition size table at
+ * first_part_size + header_size (VE_VP8_PART_SIZE_OFFSET), so the chunk has to
+ * occupy its normal place or every offset after it is wrong.
+ */
+unsigned int vp8_prefix_size(struct object_surface *surface_object)
+{
+	return vp8_is_key_frame(&surface_object->params.vp8.picture) ? 10 : 3;
+}
+
+/*
+ * The engine never reads these bytes -- it is pointed past them -- so only the
+ * LENGTH is load-bearing.  They are written correctly anyway: it costs nothing,
+ * it makes a dumped OUTPUT buffer a valid VP8 frame that other tools can parse,
+ * and it does not quietly depend on the engine continuing to skip them.
+ */
+void vp8_fill_prefix(struct object_surface *surface_object, void *dest)
+{
+	const VAPictureParameterBufferVP8 *picture =
+		&surface_object->params.vp8.picture;
+	const VASliceParameterBufferVP8 *slice =
+		&surface_object->params.vp8.slice;
+	bool key_frame = vp8_is_key_frame(picture);
+	unsigned int first_part_size = vp8_first_part_size(slice);
+	uint8_t *out = dest;
+	uint32_t tag;
+	uint16_t v;
+
+	/* Frame tag: type, version, show_frame, then the partition size. */
+	tag = (key_frame ? 0 : 1) |
+	      (picture->pic_fields.bits.version << 1) |
+	      (1 << 4) |
+	      (first_part_size << 5);
+
+	out[0] = tag & 0xff;
+	out[1] = (tag >> 8) & 0xff;
+	out[2] = (tag >> 16) & 0xff;
+
+	if (!key_frame)
+		return;
+
+	/* Key frames carry the start code and the dimensions. */
+	out[3] = 0x9d;
+	out[4] = 0x01;
+	out[5] = 0x2a;
+
+	v = picture->frame_width & 0x3fff;
+	out[6] = v & 0xff;
+	out[7] = v >> 8;
+
+	v = picture->frame_height & 0x3fff;
+	out[8] = v & 0xff;
+	out[9] = v >> 8;
+}
+
+int vp8_set_controls(struct request_data *driver_data,
+		     struct object_context *context_object,
+		     struct object_surface *surface_object)
+{
+	VAPictureParameterBufferVP8 *picture =
+		&surface_object->params.vp8.picture;
+	VASliceParameterBufferVP8 *slice = &surface_object->params.vp8.slice;
+	VAIQMatrixBufferVP8 *iqmatrix = &surface_object->params.vp8.iqmatrix;
+	VAProbabilityDataBufferVP8 *probs =
+		&surface_object->params.vp8.probabilities;
+	struct object_surface *last_surface;
+	struct object_surface *golden_surface;
+	struct object_surface *alt_surface;
+	struct v4l2_ctrl_vp8_frame frame;
+	unsigned int base_qi;
+	unsigned int i;
+	int rc;
+
+	memset(&frame, 0, sizeof(frame));
+
+	/*
+	 * Segmentation.  VA-API reports the per-segment quantiser and loop
+	 * filter values ALREADY ADJUSTED -- absolute, not deltas -- so
+	 * V4L2_VP8_SEGMENT_FLAG_DELTA_VALUE_MODE is deliberately left clear and
+	 * the values go across as they are.  cedrus reads that as
+	 * VE_VP8_PPS_MB_SEGMENT_ABS_DELTA, which is exactly this meaning.
+	 * Reconstructing deltas would need the base the encoder used and would
+	 * be lossy where the spec's clamp bit.
+	 */
+	for (i = 0; i < 4; i++) {
+		frame.segment.quant_update[i] =
+			(__s8)iqmatrix->quantization_index[i][0];
+		frame.segment.lf_update[i] = (__s8)picture->loop_filter_level[i];
+	}
+
+	memcpy(frame.segment.segment_probs, picture->mb_segment_tree_probs,
+	       sizeof(frame.segment.segment_probs));
+
+	if (picture->pic_fields.bits.segmentation_enabled)
+		frame.segment.flags |= V4L2_VP8_SEGMENT_FLAG_ENABLED;
+	if (picture->pic_fields.bits.update_mb_segmentation_map)
+		frame.segment.flags |= V4L2_VP8_SEGMENT_FLAG_UPDATE_MAP;
+	if (picture->pic_fields.bits.update_segment_feature_data)
+		frame.segment.flags |= V4L2_VP8_SEGMENT_FLAG_UPDATE_FEATURE_DATA;
+
+	/* Loop filter. */
+	memcpy(frame.lf.ref_frm_delta, picture->loop_filter_deltas_ref_frame,
+	       sizeof(frame.lf.ref_frm_delta));
+	memcpy(frame.lf.mb_mode_delta, picture->loop_filter_deltas_mode,
+	       sizeof(frame.lf.mb_mode_delta));
+
+	frame.lf.sharpness_level = picture->pic_fields.bits.sharpness_level;
+	/*
+	 * The frame-level filter strength.  VA-API only sends the four
+	 * post-adjustment segment levels, and with segmentation off ffmpeg
+	 * fills all four with the frame level, so segment 0 is that level.
+	 * With segmentation on, the per-segment values above are what the
+	 * engine uses.  loop_filter_disable is already folded in: ffmpeg sets
+	 * it precisely when the level is 0.
+	 */
+	frame.lf.level = picture->loop_filter_level[0];
+
+	if (picture->pic_fields.bits.loop_filter_adj_enable)
+		frame.lf.flags |= V4L2_VP8_LF_ADJ_ENABLE;
+	if (picture->pic_fields.bits.mode_ref_lf_delta_update)
+		frame.lf.flags |= V4L2_VP8_LF_DELTA_UPDATE;
+	if (picture->pic_fields.bits.filter_type)
+		frame.lf.flags |= V4L2_VP8_LF_FILTER_TYPE_SIMPLE;
+
+	/*
+	 * Quantisation.  VA-API sends six absolute indices per segment, where
+	 * V4L2 wants one base index plus five per-plane deltas, so the deltas
+	 * are recovered by subtraction against segment 0.
+	 *
+	 * This stays exact even where ffmpeg's clamp to [0,127] bit.  It emits
+	 * index[n] = clip(base + delta), so the recovered delta' is
+	 * clip(base + delta) - base, and the engine then computes
+	 * clip(base + delta') == clip(base + delta) -- the same value.  delta'
+	 * lies in [-127, 127] and fits the signed field.
+	 */
+	base_qi = iqmatrix->quantization_index[0][0];
+
+	frame.quant.y_ac_qi = base_qi;
+	frame.quant.y_dc_delta =
+		(__s8)((int)iqmatrix->quantization_index[0][1] - (int)base_qi);
+	frame.quant.y2_dc_delta =
+		(__s8)((int)iqmatrix->quantization_index[0][2] - (int)base_qi);
+	frame.quant.y2_ac_delta =
+		(__s8)((int)iqmatrix->quantization_index[0][3] - (int)base_qi);
+	frame.quant.uv_dc_delta =
+		(__s8)((int)iqmatrix->quantization_index[0][4] - (int)base_qi);
+	frame.quant.uv_ac_delta =
+		(__s8)((int)iqmatrix->quantization_index[0][5] - (int)base_qi);
+
+	/*
+	 * Entropy.  The coefficient probabilities arrive in their own buffer
+	 * and the two layouts agree dimension for dimension ([4][8][3][11]);
+	 * the mode and motion-vector probabilities ride in the picture
+	 * parameters.
+	 */
+	memcpy(frame.entropy.coeff_probs, probs->dct_coeff_probs,
+	       sizeof(frame.entropy.coeff_probs));
+	memcpy(frame.entropy.y_mode_probs, picture->y_mode_probs,
+	       sizeof(frame.entropy.y_mode_probs));
+	memcpy(frame.entropy.uv_mode_probs, picture->uv_mode_probs,
+	       sizeof(frame.entropy.uv_mode_probs));
+	memcpy(frame.entropy.mv_probs, picture->mv_probs,
+	       sizeof(frame.entropy.mv_probs));
+
+	/* Boolean decoder state at the end of the frame header. */
+	frame.coder_state.range = picture->bool_coder_ctx.range;
+	frame.coder_state.value = picture->bool_coder_ctx.value;
+	frame.coder_state.bit_count = picture->bool_coder_ctx.count;
+
+	frame.width = picture->frame_width;
+	frame.height = picture->frame_height;
+	/*
+	 * VA-API carries no scaling factors -- they live in the key frame's
+	 * uncompressed chunk, which it does not forward -- so these stay 0.
+	 * cedrus does not read them.
+	 */
+	frame.horizontal_scale = 0;
+	frame.vertical_scale = 0;
+
+	frame.version = picture->pic_fields.bits.version;
+
+	frame.prob_skip_false = picture->prob_skip_false;
+	frame.prob_intra = picture->prob_intra;
+	frame.prob_last = picture->prob_last;
+	frame.prob_gf = picture->prob_gf;
+
+	/*
+	 * VA-API counts the control partition, V4L2 counts only the token
+	 * partitions, and their sizes follow in the same order.
+	 */
+	frame.num_dct_parts = slice->num_of_partitions - 1;
+	for (i = 0; i < frame.num_dct_parts && i < 8; i++)
+		frame.dct_part_sizes[i] = slice->partition_size[i + 1];
+
+	frame.first_part_size = vp8_first_part_size(slice);
+	frame.first_part_header_bits = slice->macroblock_offset;
+
+	last_surface = SURFACE(driver_data, picture->last_ref_frame);
+	golden_surface = SURFACE(driver_data, picture->golden_ref_frame);
+	alt_surface = SURFACE(driver_data, picture->alt_ref_frame);
+
+	if (last_surface != NULL)
+		frame.last_frame_ts =
+			v4l2_timeval_to_ns(&last_surface->timestamp);
+	if (golden_surface != NULL)
+		frame.golden_frame_ts =
+			v4l2_timeval_to_ns(&golden_surface->timestamp);
+	if (alt_surface != NULL)
+		frame.alt_frame_ts = v4l2_timeval_to_ns(&alt_surface->timestamp);
+
+	if (vp8_is_key_frame(picture))
+		frame.flags |= V4L2_VP8_FRAME_FLAG_KEY_FRAME;
+	/*
+	 * Anything handed to a decoder here is being decoded for output, and
+	 * VA-API has no show_frame field to say otherwise.
+	 */
+	frame.flags |= V4L2_VP8_FRAME_FLAG_SHOW_FRAME;
+	if (picture->pic_fields.bits.mb_no_coeff_skip)
+		frame.flags |= V4L2_VP8_FRAME_FLAG_MB_NO_SKIP_COEFF;
+	if (picture->pic_fields.bits.sign_bias_golden)
+		frame.flags |= V4L2_VP8_FRAME_FLAG_SIGN_BIAS_GOLDEN;
+	if (picture->pic_fields.bits.sign_bias_alternate)
+		frame.flags |= V4L2_VP8_FRAME_FLAG_SIGN_BIAS_ALT;
+
+	rc = v4l2_set_control(driver_data->video_fd, surface_object->request_fd,
+			      V4L2_CID_STATELESS_VP8_FRAME,
+			      &frame, sizeof(frame));
+	if (rc < 0)
+		return VA_STATUS_ERROR_OPERATION_FAILED;
+
+	return VA_STATUS_SUCCESS;
+}
