+/*
+ * What a VP9 frame header leaves in force for the next: the loop-filter
+ * deltas and the segmentation features persist until a frame updates them
+ * or resets the past, so the parser carries them per context.
+ */
+struct vp9_state {
+	int8_t lf_ref_deltas[4];
+	int8_t lf_mode_deltas[2];
+	struct v4l2_vp9_segmentation seg;
