+/*
+ * Let go of the queues while surfaces still refer to them, so the device can
+ * be renegotiated: a client changing resolution or bit depth creates the new
+ * surfaces before it destroys the old ones, and ffmpeg does exactly that on
+ * a VP9 or HEVC resolution change. Until now that S_FMT met EBUSY and the
+ * client fell back to software.
+ *
+ * Only with DMABUF capture, where each surface's pixels are its own dma-buf
+ * and outlive the queue. The OUTPUT buffers are MMAP and still mapped by
+ * their surfaces; vb2 orphans those on REQBUFS(0) rather than refusing, and
+ * the surfaces unmap them when destroyed. Bumping the generation retires
+ * every surface the device had: they stay readable and exportable, and are
+ * refused as decode targets.
+ */
+static VAStatus surface_retire_queues(struct request_data *driver_data,
+				      unsigned int width, unsigned int height)
+{
+	struct request_device *device = &driver_data->devices[driver_data->device];
+	struct video_format *video_format = driver_data->video_format;
+	unsigned int output_type, capture_type;
+	int rc;
+
+	output_type = v4l2_type_video_output(video_format->v4l2_mplane);
+	capture_type = v4l2_type_video_capture(video_format->v4l2_mplane);
+
+	v4l2_set_stream(driver_data->video_fd, output_type, false);
+	v4l2_set_stream(driver_data->video_fd, capture_type, false);
+
+	rc = v4l2_request_buffers(driver_data->video_fd, output_type,
+				  V4L2_MEMORY_MMAP, 0);
+	if (rc < 0)
+		return VA_STATUS_ERROR_OPERATION_FAILED;
+
+	rc = v4l2_request_buffers(driver_data->video_fd, capture_type,
+				  V4L2_MEMORY_DMABUF, 0);
+	if (rc < 0)
+		return VA_STATUS_ERROR_OPERATION_FAILED;
+
+	request_log("Renegotiating %ux%u/%u-bit -> %ux%u/%u-bit; earlier surfaces retired\n",
+		    driver_data->configured_width,
+		    driver_data->configured_height,
+		    driver_data->configured_bit_depth, width, height,
+		    driver_data->coded_bit_depth);
+
+	device->generation++;
+	driver_data->configured_pixelformat = 0;
+	driver_data->configured_width = 0;
+	driver_data->configured_height = 0;
+	driver_data->configured_bit_depth = 0;
+	driver_data->video_format = NULL;
+
+	return VA_STATUS_SUCCESS;
+}
