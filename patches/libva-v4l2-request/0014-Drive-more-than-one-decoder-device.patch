+/*
+ * One stateless decoder: a video node, the media device its requests are
+ * allocated from, and the state of its two queues.
+ *
+ * A board can have more than one. The H713 has the Allwinner video engine
+ * (cedrus: MPEG-2, H.264, HEVC, VP8, VP9) and, as a separate device with its
+ * own nodes, a Google AV1 core. A V4L2 mem2mem queue pair has one format and
+ * one set of buffers, so each device carries its own copy of that state.
+ */
+struct request_device {
+	int video_fd;
+	int media_fd;
+	struct video_format *video_format;
+	unsigned int configured_pixelformat;
+	unsigned int configured_width;
+	unsigned int configured_height;
+};
+
 struct request_data {
 	struct object_heap config_heap;
 	struct object_heap context_heap;
 	struct object_heap surface_heap;
 	struct object_heap buffer_heap;
 	struct object_heap image_heap;
+	/*
+	 * The ACTIVE device's state. Every function below was written for a
+	 * single device and reads these; request_use_device() swaps another
+	 * device's state in, so an entry point says which device its object
+	 * lives on once, at the top, and the rest of it is unchanged.
+	 */
