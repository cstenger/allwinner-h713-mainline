+void request_use_device(struct request_data *driver_data, unsigned int device)
+{
+	struct request_device *from = &driver_data->devices[driver_data->device];
+	struct request_device *to;
+
+	if (device == driver_data->device || device >= driver_data->devices_count)
+		return;
+
+	from->video_format = driver_data->video_format;
+	from->configured_pixelformat = driver_data->configured_pixelformat;
+	from->configured_width = driver_data->configured_width;
+	from->configured_height = driver_data->configured_height;
+
+	to = &driver_data->devices[device];
+	driver_data->video_fd = to->video_fd;
+	driver_data->media_fd = to->media_fd;
+	driver_data->video_format = to->video_format;
+	driver_data->configured_pixelformat = to->configured_pixelformat;
+	driver_data->configured_width = to->configured_width;
+	driver_data->configured_height = to->configured_height;
+	driver_data->device = device;
+}
+
+/*
+ * The device that decodes a coded format: the first that offers it, so the
+ * primary device keeps everything it can do.
+ */
+int request_find_device(struct request_data *driver_data,
+			unsigned int pixelformat)
+{
+	unsigned int i;
+
+	for (i = 0; i < driver_data->devices_count; i++)
+		if (v4l2_find_format(driver_data->devices[i].video_fd,
+				     V4L2_BUF_TYPE_VIDEO_OUTPUT, pixelformat) ||
+		    v4l2_find_format(driver_data->devices[i].video_fd,
+				     V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE,
+				     pixelformat))
+			return i;
+
+	return -1;
+}
+
+/* Whether any surface or context still lives on a device's queues. */
+bool request_device_in_use(struct request_data *driver_data,
+			   unsigned int device)
+{
+	struct object_surface *surface_object;
+	struct object_context *context_object;
+	int iterator;
+
+	surface_object = (struct object_surface *)
+		object_heap_first(&driver_data->surface_heap, &iterator);
+	while (surface_object != NULL) {
+		if (surface_object->device == device)
+			return true;
+		surface_object = (struct object_surface *)
+			object_heap_next(&driver_data->surface_heap, &iterator);
+	}
+
+	context_object = (struct object_context *)
+		object_heap_first(&driver_data->context_heap, &iterator);
+	while (context_object != NULL) {
+		if (context_object->device == device)
+			return true;
+		context_object = (struct object_context *)
+			object_heap_next(&driver_data->context_heap, &iterator);
+	}
+
+	return false;
+}
+
+#define ARRAY_SIZE(a)	(sizeof(a) / sizeof((a)[0]))
+
+static const unsigned int request_coded_formats[] = {
+	V4L2_PIX_FMT_MPEG2_SLICE, V4L2_PIX_FMT_H264_SLICE,
+	V4L2_PIX_FMT_HEVC_SLICE, V4L2_PIX_FMT_VP8_FRAME,
+	V4L2_PIX_FMT_VP9_FRAME, V4L2_PIX_FMT_AV1_FRAME,
+};
+
+/*
+ * Find the media device that belongs to a video node. They are siblings
+ * under the same parent device in sysfs, which is the only place the pairing
+ * is recorded: the node numbers say nothing (video1 need not go with media1).
+ */
+static int request_open_media_for(const char *video_name)
+{
+	char path[PATH_MAX], video_parent[PATH_MAX], media_real[PATH_MAX];
+	struct dirent *entry;
+	int media_fd = -1;
+	char *slash;
+	DIR *dir;
+
+	snprintf(path, sizeof(path), "/sys/class/video4linux/%s/device",
+		 video_name);
+	if (realpath(path, video_parent) == NULL)
+		return -1;
+
+	dir = opendir("/sys/bus/media/devices");
+	if (dir == NULL)
+		return -1;
+
+	while ((entry = readdir(dir)) != NULL) {
+		if (strncmp(entry->d_name, "media", 5) != 0)
+			continue;
+
+		snprintf(path, sizeof(path), "/sys/bus/media/devices/%s",
+			 entry->d_name);
+		if (realpath(path, media_real) == NULL)
+			continue;
+
+		slash = strrchr(media_real, '/');
+		if (slash == NULL)
+			continue;
+		*slash = '\0';
+
+		if (strcmp(media_real, video_parent) != 0)
+			continue;
+
+		snprintf(path, sizeof(path), "/dev/%s", entry->d_name);
+		media_fd = open(path, O_RDWR | O_NONBLOCK);
+		break;
+	}
+
+	closedir(dir);
+
+	return media_fd;
+}
+
+/*
+ * Add every other stateless decoder on the system: a streaming video node
+ * that offers one of the coded formats this driver has a backend for and has
+ * a media device to allocate requests from. Anything else -- a camera, an
+ * encoder, a scaler -- fails one of those tests and is left alone.
+ */
+static void request_probe_devices(struct request_data *driver_data)
+{
+	struct stat primary, other;
+	struct dirent *entry;
+	char path[PATH_MAX];
+	unsigned int capabilities;
+	unsigned int i;
+	int video_fd, media_fd;
+	bool decoder;
+	DIR *dir;
+
+	if (fstat(driver_data->devices[0].video_fd, &primary) < 0)
+		return;
+
+	dir = opendir("/sys/class/video4linux");
+	if (dir == NULL)
+		return;
+
+	while ((entry = readdir(dir)) != NULL &&
+	       driver_data->devices_count < V4L2_REQUEST_MAX_DEVICES) {
+		if (strncmp(entry->d_name, "video", 5) != 0)
+			continue;
+
+		snprintf(path, sizeof(path), "/dev/%s", entry->d_name);
+		video_fd = open(path, O_RDWR | O_NONBLOCK);
+		if (video_fd < 0)
+			continue;
+
+		decoder = false;
+		if (fstat(video_fd, &other) == 0 &&
+		    other.st_rdev != primary.st_rdev &&
+		    v4l2_query_capabilities(video_fd, &capabilities) == 0 &&
+		    (capabilities & V4L2_CAP_STREAMING))
+			for (i = 0; i < ARRAY_SIZE(request_coded_formats); i++)
+				if (v4l2_find_format(video_fd,
+						     V4L2_BUF_TYPE_VIDEO_OUTPUT,
+						     request_coded_formats[i]) ||
+				    v4l2_find_format(video_fd,
+						     V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE,
+						     request_coded_formats[i]))
+					decoder = true;
+
+		media_fd = decoder ? request_open_media_for(entry->d_name) : -1;
+		if (media_fd < 0) {
+			close(video_fd);
+			continue;
+		}
+
+		driver_data->devices[driver_data->devices_count].video_fd = video_fd;
+		driver_data->devices[driver_data->devices_count].media_fd = media_fd;
+		driver_data->devices_count++;
+	}
+
+	closedir(dir);
+}
