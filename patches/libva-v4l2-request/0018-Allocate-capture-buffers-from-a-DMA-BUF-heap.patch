+ * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE
+ * SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
+ */
+
+
+/*
+ * Capture memory from a DMA-BUF heap.
+ *
+ * With V4L2_MEMORY_MMAP every surface's pixels belong to the CAPTURE queue,
+ * so the queue cannot be released, or its format changed, while a single
+ * surface is still referenced. Allocating each surface's buffer here and
+ * queueing it as V4L2_MEMORY_DMABUF makes the surface the owner instead: the
+ * queues only borrow the memory for the length of a decode.
+ *
+ * The system heap, not CMA. The decoders and the display that import these
+ * buffers all sit behind an IOMMU, so scattered pages are mapped contiguously
+ * in each device's address space, and the CMA pool is far too small to hold
+ * a 4K surface pool next to the framebuffers.
+ */
+
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#include <linux/dma-buf.h>
+#include <linux/dma-heap.h>
+
+#include "dmaheap.h"
+#include "utils.h"
+
+#define DMAHEAP_PATH	"/dev/dma_heap/system"
+
+int dmaheap_open(void)
+{
+	return open(DMAHEAP_PATH, O_RDONLY | O_CLOEXEC);
+}
+
+int dmaheap_alloc(int heap_fd, size_t size)
+{
+	struct dma_heap_allocation_data data;
+	int rc;
+
+	memset(&data, 0, sizeof(data));
+	data.len = size;
+	data.fd_flags = O_RDWR | O_CLOEXEC;
+
+	rc = ioctl(heap_fd, DMA_HEAP_IOCTL_ALLOC, &data);
+	if (rc < 0) {
+		request_log("Unable to allocate %zu bytes from %s: %s\n", size,
+			    DMAHEAP_PATH, strerror(errno));
+		return -1;
+	}
+
+	return data.fd;
+}
+
+/*
+ * Bracket CPU access. Heap memory is cached, and nothing else does the cache
+ * maintenance for the CPU: vb2 only did it for buffers it allocated itself.
+ */
+int dmaheap_sync(int dmabuf_fd, bool start, bool write)
+{
+	struct dma_buf_sync sync;
+	int rc;
+
+	memset(&sync, 0, sizeof(sync));
+	sync.flags = (start ? DMA_BUF_SYNC_START : DMA_BUF_SYNC_END) |
+		     (write ? DMA_BUF_SYNC_WRITE : DMA_BUF_SYNC_READ);
+
+	do
+		rc = ioctl(dmabuf_fd, DMA_BUF_IOCTL_SYNC, &sync);
+	while (rc < 0 && (errno == EINTR || errno == EAGAIN));
+
+	if (rc < 0)
+		request_log("Unable to sync dma-buf: %s\n", strerror(errno));
+
+	return rc;
+}
