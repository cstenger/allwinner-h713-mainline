 	return false;
 }
 
+unsigned int request_capture_memory(struct request_data *driver_data)
+{
+	unsigned int memory =
+		driver_data->devices[driver_data->device].capture_memory;
+
+	return memory ? memory : V4L2_MEMORY_MMAP;
+}
+
+/*
+ * Decide how the active device's CAPTURE buffers are provided. Only called
+ * while that queue holds no buffers, since a vb2 queue takes one memory type
+ * for all of them.
+ *
+ * DMABUF from the system heap whenever the heap is there and the format is a
+ * single buffer, otherwise MMAP, which is how every version before this one
+ * worked. V4L2_REQUEST_CAPTURE_MEMORY=mmap|dmabuf forces either for A/B runs;
+ * a forced dmabuf that cannot be honoured fails rather than quietly testing
+ * the other one.
+ */
+int request_select_capture_memory(struct request_data *driver_data,
+				  struct video_format *video_format)
+{
+	const char *value = getenv("V4L2_REQUEST_CAPTURE_MEMORY");
+	bool possible = driver_data->heap_fd >= 0 &&
+			video_format->v4l2_buffers_count == 1;
+	unsigned int memory;
+
+	if (value != NULL && !strcmp(value, "mmap")) {
+		memory = V4L2_MEMORY_MMAP;
+	} else if (value != NULL && !strcmp(value, "dmabuf")) {
+		if (!possible) {
+			request_log("V4L2_REQUEST_CAPTURE_MEMORY=dmabuf, but %s\n",
+				    driver_data->heap_fd < 0 ?
+				    "/dev/dma_heap/system is not available" :
+				    "the capture format is not a single buffer");
+			return -1;
+		}
+		memory = V4L2_MEMORY_DMABUF;
+	} else {
+		if (value != NULL)
+			request_log("Ignoring V4L2_REQUEST_CAPTURE_MEMORY=%s (mmap or dmabuf)\n",
+				    value);
+		memory = possible ? V4L2_MEMORY_DMABUF : V4L2_MEMORY_MMAP;
+	}
+
+	if (memory != driver_data->devices[driver_data->device].capture_memory)
+		request_log("Capture memory: %s\n",
+			    memory == V4L2_MEMORY_DMABUF ?
+			    "dma-buf from the system heap" : "mmap");
+
+	driver_data->devices[driver_data->device].capture_memory = memory;
+
+	return 0;
+}
+
 #define ARRAY_SIZE(a)	(sizeof(a) / sizeof((a)[0]))
 
 static const unsigned int request_coded_formats[] = {
@@ -475,6 +532,9 @@ VAStatus VA_DRIVER_INIT_FUNC(VADriverContextP context)
 	driver_data->device = 0;
 	driver_data->config_device = 0;
 
+	/* Optional: without it, capture memory stays MMAP. */
+	driver_data->heap_fd = dmaheap_open();
+
 	request_probe_devices(driver_data);
 
 	status = VA_STATUS_SUCCESS;
@@ -566,6 +626,9 @@ VAStatus RequestTerminate(VADriverContextP context)
 		close(driver_data->devices[i].media_fd);
 	}
 
+	if (driver_data->heap_fd >= 0)
+		close(driver_data->heap_fd);
+
 	free(context->pDriverData);
 	context->pDriverData = NULL;
 
