+/* The fourcc a CPU sees a surface as: what its memory holds, MSB-aligned. */
+static unsigned int surface_image_fourcc(struct request_data *driver_data)
+{
+	return video_format_is_lsb10(driver_data->video_format) ?
+	       VA_FOURCC_P010 : VA_FOURCC_NV12;
+}
+
+/*
+ * LSB-aligned 10-bit samples into P010's MSB-aligned ones, in place: the
+ * copy is made first, so the device memory is read once and in bulk.
+ */
+static void lsb10_to_p010(void *data, unsigned int size)
+{
+	uint16_t *p = data;
+	unsigned int n = size / 2;
+
+	while (n--) {
+		*p = *p << 6;
+		p++;
+	}
+}
