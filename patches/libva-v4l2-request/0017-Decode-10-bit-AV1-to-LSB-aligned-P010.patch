+/*
+ * The same for AV1, whose Profile 0 is 8- or 10-bit: hantro lists only the
+ * capture formats of its current bit depth (match_depth), so a 10-bit stream
+ * must say so before the capture format is looked for. And it must say so
+ * after any OUTPUT S_FMT, which resets hantro to 8 bits. A sequence carrying
+ * nothing but the depth is all hantro reads; the real one sent with the first
+ * frame is then an equal and changes nothing.
+ */
+static void surface_declare_av1_bit_depth(struct request_data *driver_data)
+{
+	struct v4l2_ctrl_av1_sequence seq;
+
+	if (driver_data->coded_bit_depth <= 8 ||
+	    driver_data->coded_pixelformat != V4L2_PIX_FMT_AV1_FRAME)
+		return;
+
+	memset(&seq, 0, sizeof(seq));
+	seq.bit_depth = driver_data->coded_bit_depth;
+
+	v4l2_set_control(driver_data->video_fd, -1,
+			 V4L2_CID_STATELESS_AV1_SEQUENCE, &seq, sizeof(seq));
+}
