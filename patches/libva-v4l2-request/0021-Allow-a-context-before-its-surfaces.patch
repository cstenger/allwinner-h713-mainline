+
 	context_object->render_surface_id = VA_INVALID_ID;
 	context_object->surfaces_ids = ids;
 	context_object->surfaces_count = surfaces_count;
@@ -169,6 +167,35 @@ complete:
 	return status;
 }
 
+VAStatus context_start_streaming(struct request_data *driver_data,
+				 struct object_context *context_object)
+{
+	struct video_format *video_format;
+	unsigned int output_type, capture_type;
+
+	if (context_object->streaming)
+		return VA_STATUS_SUCCESS;
+
+	request_use_device(driver_data, context_object->device);
+	video_format = driver_data->video_format;
+	if (video_format == NULL)
+		return VA_STATUS_ERROR_OPERATION_FAILED;
+
+	output_type = v4l2_type_video_output(video_format->v4l2_mplane);
+	capture_type = v4l2_type_video_capture(video_format->v4l2_mplane);
+
+	if (v4l2_set_stream(driver_data->video_fd, output_type, true) < 0)
+		return VA_STATUS_ERROR_OPERATION_FAILED;
+
+	if (v4l2_set_stream(driver_data->video_fd, capture_type, true) < 0) {
+		v4l2_set_stream(driver_data->video_fd, output_type, false);
+		return VA_STATUS_ERROR_OPERATION_FAILED;
+	}
+
+	context_object->streaming = true;
+	return VA_STATUS_SUCCESS;
+}
+
 VAStatus RequestDestroyContext(VADriverContextP context, VAContextID context_id)
 {
 	struct request_data *driver_data = context->pDriverData;
@@ -186,20 +213,23 @@ VAStatus RequestDestroyContext(VADriverContextP context, VAContextID context_id)
 	device = context_object->device;
 	request_use_device(driver_data, device);
 
+	/* A context that never decoded never started its queues. */
 	video_format = driver_data->video_format;
-	if (video_format == NULL)
+	if (video_format == NULL && context_object->streaming)
 		return VA_STATUS_ERROR_OPERATION_FAILED;
 
-	output_type = v4l2_type_video_output(video_format->v4l2_mplane);
-	capture_type = v4l2_type_video_capture(video_format->v4l2_mplane);
+	if (context_object->streaming) {
+		output_type = v4l2_type_video_output(video_format->v4l2_mplane);
+		capture_type = v4l2_type_video_capture(video_format->v4l2_mplane);
 
-	rc = v4l2_set_stream(driver_data->video_fd, output_type, false);
-	if (rc < 0)
-		return VA_STATUS_ERROR_OPERATION_FAILED;
+		rc = v4l2_set_stream(driver_data->video_fd, output_type, false);
+		if (rc < 0)
+			return VA_STATUS_ERROR_OPERATION_FAILED;
 
-	rc = v4l2_set_stream(driver_data->video_fd, capture_type, false);
-	if (rc < 0)
-		return VA_STATUS_ERROR_OPERATION_FAILED;
+		rc = v4l2_set_stream(driver_data->video_fd, capture_type, false);
+		if (rc < 0)
+			return VA_STATUS_ERROR_OPERATION_FAILED;
+	}
 
 	/* Buffers liberation */
 
