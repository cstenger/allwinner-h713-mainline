+/*
+ * AV1 through VA-API to a V4L2 stateless decoder.
+ *
+ * Unlike VP9, VA-API's AV1 picture parameters carry nearly the whole frame
+ * header, and ffmpeg sends only the tile data, so there is nothing to parse:
+ * this is a translation. The gaps are the things a hardware decoder with its
+ * own DPB does not need told and a V4L2 one does:
+ *
+ *  - the order hint of every reference, which the V4L2 driver uses for motion
+ *    field projection and skip mode. Each surface remembers the order hint it
+ *    was decoded with, and VA-API names the surface in every slot;
+ *  - skip_mode_frame[], derived here from those order hints exactly as the
+ *    specification's skip_mode_params() does;
+ *  - tile_size_bytes, which VA-API does not pass, recovered from the gap a
+ *    tile's size field leaves between two tiles of one tile group;
+ *  - refresh_frame_flags, which VA-API does not pass either. The kernel
+ *    driver this was written for keeps no state per slot -- it finds every
+ *    reference, CDFs included, by the timestamp of the surface in the slot --
+ *    so it is sent as 0.
+ */
+
+#define AV1_PRIMARY_REF_NONE	7
+
+static uint64_t av1_surface_ts(struct request_data *driver_data, VASurfaceID id)
+{
+	struct object_surface *surface = SURFACE(driver_data, id);
+
+	return surface ? v4l2_timeval_to_ns(&surface->timestamp) : 0;
+}
+
+static int av1_relative_dist(unsigned int bits, int a, int b)
+{
+	int diff, m;
+
+	if (!bits)
+		return 0;
+	diff = a - b;
+	m = 1 << (bits - 1);
+	return (diff & (m - 1)) - (diff & m);
+}
+
+/* 5.9.22 skip_mode_params() */
+static void av1_skip_mode(const struct v4l2_ctrl_av1_frame *frame,
+			  unsigned int bits, uint8_t skip[2])
+{
+	int fwd = -1, bwd = -1, fwd2 = -1, fwd_hint = 0, bwd_hint = 0, fwd2_hint = 0;
+	int i, hint;
+
+	skip[0] = skip[1] = 0;
+	for (i = 0; i < V4L2_AV1_REFS_PER_FRAME; i++) {
+		hint = frame->order_hints[V4L2_AV1_REF_LAST_FRAME + i];
+		if (av1_relative_dist(bits, hint, frame->order_hint) < 0) {
+			if (fwd < 0 || av1_relative_dist(bits, hint, fwd_hint) > 0) {
+				fwd = i;
+				fwd_hint = hint;
+			}
+		} else if (av1_relative_dist(bits, hint, frame->order_hint) > 0) {
+			if (bwd < 0 || av1_relative_dist(bits, hint, bwd_hint) < 0) {
+				bwd = i;
+				bwd_hint = hint;
+			}
+		}
+	}
+	if (fwd < 0)
+		return;
+	if (bwd >= 0) {
+		skip[0] = V4L2_AV1_REF_LAST_FRAME + (fwd < bwd ? fwd : bwd);
+		skip[1] = V4L2_AV1_REF_LAST_FRAME + (fwd < bwd ? bwd : fwd);
+		return;
+	}
+	for (i = 0; i < V4L2_AV1_REFS_PER_FRAME; i++) {
+		hint = frame->order_hints[V4L2_AV1_REF_LAST_FRAME + i];
+		if (av1_relative_dist(bits, hint, fwd_hint) < 0 &&
+		    (fwd2 < 0 || av1_relative_dist(bits, hint, fwd2_hint) > 0)) {
+			fwd2 = i;
+			fwd2_hint = hint;
+		}
+	}
+	if (fwd2 < 0)
+		return;
+	skip[0] = V4L2_AV1_REF_LAST_FRAME + (fwd < fwd2 ? fwd : fwd2);
+	skip[1] = V4L2_AV1_REF_LAST_FRAME + (fwd < fwd2 ? fwd2 : fwd);
+}
+
+/*
+ * The tiles of one slice-parameter buffer (one tile group), placed after the
+ * data already stored: ffmpeg renders a tile group's parameters before its
+ * data, so slices_size is where that data is about to go.
+ */
+void av1_store_tiles(struct object_surface *surface_object,
+		     const VASliceParameterBufferAV1 *slices, unsigned int count)
+{
+	struct av1_params *p = &surface_object->params.av1;
+	unsigned int base = surface_object->slices_size + AV1_DATA_PAD;
+	unsigned int i;
+
+	/* the pad goes in with the first data; see av1_data_prefix() */
+	if (surface_object->slices_count)
+		base -= AV1_DATA_PAD;
+
+	for (i = 0; i < count && p->tiles_count < AV1_MAX_TILES; i++) {
+		struct v4l2_ctrl_av1_tile_group_entry *t = &p->tiles[p->tiles_count++];
+
+		t->tile_offset = base + slices[i].slice_data_offset;
+		t->tile_size = slices[i].slice_data_size;
+		t->tile_row = slices[i].tile_row;
+		t->tile_col = slices[i].tile_column;
+	}
+	if (i < count)
+		p->tiles_overflow = true;
+}
+
+/*
+ * Room in front of the first tile group. With several tiles the kernel
+ * driver points the core at tile 0's size field, tile_size_bytes before the
+ * tile; when tile 0 is alone in its group it has no size field, and that
+ * address would fall before the buffer.
+ */
+unsigned int av1_data_prefix(struct object_surface *surface_object)
+{
+	return surface_object->slices_count ? 0 : AV1_DATA_PAD;
+}
+
+static unsigned int av1_tile_size_bytes(const struct av1_params *p)
+{
+	unsigned int i;
+
+	for (i = 0; i + 1 < p->tiles_count; i++) {
+		unsigned int end = p->tiles[i].tile_offset + p->tiles[i].tile_size;
+		unsigned int gap = p->tiles[i + 1].tile_offset - end;
+
+		if (p->tiles[i + 1].tile_offset > end && gap <= 4)
+			return gap;
+	}
+	return 4;
+}
+
+int av1_set_controls(struct request_data *driver_data,
+		     struct object_context *context_object,
+		     struct object_surface *surface_object)
+{
+	struct av1_params *p = &surface_object->params.av1;
+	const VADecPictureParameterBufferAV1 *pic = &p->picture;
+	const VAFilmGrainStructAV1 *fg = &pic->film_grain_info;
+	struct v4l2_ctrl_av1_sequence seq;
+	struct v4l2_ctrl_av1_frame frame;
+	struct v4l2_ctrl_av1_film_grain grain;
+	struct v4l2_ext_control controls[4];
+	struct object_surface *ref;
+	unsigned int bits, i, j, n = 0;
+	int rc;
+
+	/*
+	 * After a failed frame, nothing until the next key frame. Everything
+	 * in between predicts from the failure, so it could only be garbage --
+	 * and worse: ffmpeg abandons the rest of a temporal unit once one frame
+	 * in it fails, but has already parsed the whole unit, so its idea of
+	 * the reference state (order hints, and with them skip mode and every
+	 * header field parsed conditionally on it) no longer matches the frames
+	 * that were decoded. Headers read that way are nonsense to the core, and
+	 * on the H713 one of them hung the SoC outright. Refuse instead; ffmpeg
+	 * treats it as another decode error.
+	 */
+	if (pic->pic_info_fields.bits.frame_type == 0)
+		context_object->av1_broken = false;
+	else if (context_object->av1_broken) {
+		request_log("AV1: skipping a frame until the next key frame\n");
+		return -1;
+	}
+
+	if (p->tiles_overflow || !p->tiles_count) {
+		request_log("AV1: %s tiles\n", p->tiles_count ? "too many" : "no");
+		return -1;
+	}
+
+	/* ---- the sequence ---- */
+	memset(&seq, 0, sizeof(seq));
+	seq.seq_profile = pic->profile;
+	seq.bit_depth = pic->bit_depth_idx == 0 ? 8 : pic->bit_depth_idx == 1 ? 10 : 12;
+	bits = pic->seq_info_fields.fields.enable_order_hint ?
+	       pic->order_hint_bits_minus_1 + 1 : 0;
+	seq.order_hint_bits = bits;
+	seq.max_frame_width_minus_1 = context_object->picture_width - 1;
+	seq.max_frame_height_minus_1 = context_object->picture_height - 1;
+#define SEQ(field, flag) \
+	if (pic->seq_info_fields.fields.field) seq.flags |= V4L2_AV1_SEQUENCE_FLAG_##flag
+	SEQ(still_picture, STILL_PICTURE);
+	SEQ(use_128x128_superblock, USE_128X128_SUPERBLOCK);
+	SEQ(enable_filter_intra, ENABLE_FILTER_INTRA);
+	SEQ(enable_intra_edge_filter, ENABLE_INTRA_EDGE_FILTER);
+	SEQ(enable_interintra_compound, ENABLE_INTERINTRA_COMPOUND);
+	SEQ(enable_masked_compound, ENABLE_MASKED_COMPOUND);
+	SEQ(enable_dual_filter, ENABLE_DUAL_FILTER);
+	SEQ(enable_order_hint, ENABLE_ORDER_HINT);
+	SEQ(enable_jnt_comp, ENABLE_JNT_COMP);
+	SEQ(enable_cdef, ENABLE_CDEF);
+	SEQ(mono_chrome, MONO_CHROME);
+	SEQ(color_range, COLOR_RANGE);
+	SEQ(subsampling_x, SUBSAMPLING_X);
+	SEQ(subsampling_y, SUBSAMPLING_Y);
+	SEQ(film_grain_params_present, FILM_GRAIN_PARAMS_PRESENT);
+#undef SEQ
+	/* not in VA-API; a frame can only use a tool its sequence enables */
+	seq.flags |= V4L2_AV1_SEQUENCE_FLAG_ENABLE_WARPED_MOTION |
+		     V4L2_AV1_SEQUENCE_FLAG_ENABLE_SUPERRES |
+		     V4L2_AV1_SEQUENCE_FLAG_ENABLE_RESTORATION |
+		     V4L2_AV1_SEQUENCE_FLAG_ENABLE_REF_FRAME_MVS;
+
+	/* ---- the frame ---- */
+	memset(&frame, 0, sizeof(frame));
+
+	frame.tile_info.tile_cols = pic->tile_cols;
+	frame.tile_info.tile_rows = pic->tile_rows;
+	frame.tile_info.context_update_tile_id = pic->context_update_tile_id;
+	if (pic->pic_info_fields.bits.uniform_tile_spacing_flag)
+		frame.tile_info.flags |= V4L2_AV1_TILE_INFO_FLAG_UNIFORM_TILE_SPACING;
+	for (i = 0; i < pic->tile_cols && i < 63; i++) {
+		frame.tile_info.width_in_sbs_minus_1[i] = pic->width_in_sbs_minus_1[i];
+		frame.tile_info.mi_col_starts[i + 1] = frame.tile_info.mi_col_starts[i] +
+			((pic->width_in_sbs_minus_1[i] + 1) <<
+			 (pic->seq_info_fields.fields.use_128x128_superblock ? 5 : 4));
+	}
+	for (i = 0; i < pic->tile_rows && i < 63; i++) {
+		frame.tile_info.height_in_sbs_minus_1[i] = pic->height_in_sbs_minus_1[i];
+		frame.tile_info.mi_row_starts[i + 1] = frame.tile_info.mi_row_starts[i] +
+			((pic->height_in_sbs_minus_1[i] + 1) <<
+			 (pic->seq_info_fields.fields.use_128x128_superblock ? 5 : 4));
+	}
+	frame.tile_info.tile_size_bytes = av1_tile_size_bytes(p);
+
+	frame.quantization.base_q_idx = pic->base_qindex;
+	frame.quantization.delta_q_y_dc = pic->y_dc_delta_q;
+	frame.quantization.delta_q_u_dc = pic->u_dc_delta_q;
+	frame.quantization.delta_q_u_ac = pic->u_ac_delta_q;
+	frame.quantization.delta_q_v_dc = pic->v_dc_delta_q;
+	frame.quantization.delta_q_v_ac = pic->v_ac_delta_q;
+	frame.quantization.qm_y = pic->qmatrix_fields.bits.qm_y;
+	frame.quantization.qm_u = pic->qmatrix_fields.bits.qm_u;
+	frame.quantization.qm_v = pic->qmatrix_fields.bits.qm_v;
+	frame.quantization.delta_q_res = pic->mode_control_fields.bits.log2_delta_q_res;
+	if (pic->u_dc_delta_q != pic->v_dc_delta_q || pic->u_ac_delta_q != pic->v_ac_delta_q)
+		frame.quantization.flags |= V4L2_AV1_QUANTIZATION_FLAG_DIFF_UV_DELTA;
+	if (pic->qmatrix_fields.bits.using_qmatrix)
+		frame.quantization.flags |= V4L2_AV1_QUANTIZATION_FLAG_USING_QMATRIX;
+	if (pic->mode_control_fields.bits.delta_q_present_flag)
+		frame.quantization.flags |= V4L2_AV1_QUANTIZATION_FLAG_DELTA_Q_PRESENT;
+
+	frame.superres_denom = pic->superres_scale_denominator;
+
+	if (pic->seg_info.segment_info_fields.bits.enabled)
+		frame.segmentation.flags |= V4L2_AV1_SEGMENTATION_FLAG_ENABLED;
+	if (pic->seg_info.segment_info_fields.bits.update_map)
+		frame.segmentation.flags |= V4L2_AV1_SEGMENTATION_FLAG_UPDATE_MAP;
+	if (pic->seg_info.segment_info_fields.bits.temporal_update)
+		frame.segmentation.flags |= V4L2_AV1_SEGMENTATION_FLAG_TEMPORAL_UPDATE;
+	if (pic->seg_info.segment_info_fields.bits.update_data)
+		frame.segmentation.flags |= V4L2_AV1_SEGMENTATION_FLAG_UPDATE_DATA;
+	for (i = 0; i < 8; i++) {
+		frame.segmentation.feature_enabled[i] = pic->seg_info.feature_mask[i];
+		for (j = 0; j < 8; j++) {
+			frame.segmentation.feature_data[i][j] = pic->seg_info.feature_data[i][j];
+			if (pic->seg_info.feature_mask[i] & (1 << j)) {
+				frame.segmentation.last_active_seg_id = i;
+				if (j >= V4L2_AV1_SEG_LVL_REF_FRAME)
+					frame.segmentation.flags |=
+						V4L2_AV1_SEGMENTATION_FLAG_SEG_ID_PRE_SKIP;
+			}
+		}
+	}
+
+	frame.loop_filter.level[0] = pic->filter_level[0];
+	frame.loop_filter.level[1] = pic->filter_level[1];
+	frame.loop_filter.level[2] = pic->filter_level_u;
+	frame.loop_filter.level[3] = pic->filter_level_v;
+	frame.loop_filter.sharpness = pic->loop_filter_info_fields.bits.sharpness_level;
+	memcpy(frame.loop_filter.ref_deltas, pic->ref_deltas, sizeof(frame.loop_filter.ref_deltas));
+	memcpy(frame.loop_filter.mode_deltas, pic->mode_deltas, sizeof(frame.loop_filter.mode_deltas));
+	frame.loop_filter.delta_lf_res = pic->mode_control_fields.bits.log2_delta_lf_res;
+	if (pic->loop_filter_info_fields.bits.mode_ref_delta_enabled)
+		frame.loop_filter.flags |= V4L2_AV1_LOOP_FILTER_FLAG_DELTA_ENABLED;
+	if (pic->loop_filter_info_fields.bits.mode_ref_delta_update)
+		frame.loop_filter.flags |= V4L2_AV1_LOOP_FILTER_FLAG_DELTA_UPDATE;
+	if (pic->mode_control_fields.bits.delta_lf_present_flag)
+		frame.loop_filter.flags |= V4L2_AV1_LOOP_FILTER_FLAG_DELTA_LF_PRESENT;
+	if (pic->mode_control_fields.bits.delta_lf_multi)
+		frame.loop_filter.flags |= V4L2_AV1_LOOP_FILTER_FLAG_DELTA_LF_MULTI;
+
+	/* VA-API packs each strength as primary << 2 | the CODED secondary */
+	frame.cdef.damping_minus_3 = pic->cdef_damping_minus_3;
+	frame.cdef.bits = pic->cdef_bits;
+	for (i = 0; i < 8; i++) {
+		frame.cdef.y_pri_strength[i] = pic->cdef_y_strengths[i] >> 2;
+		frame.cdef.y_sec_strength[i] = pic->cdef_y_strengths[i] & 3;
+		frame.cdef.uv_pri_strength[i] = pic->cdef_uv_strengths[i] >> 2;
+		frame.cdef.uv_sec_strength[i] = pic->cdef_uv_strengths[i] & 3;
+		if (frame.cdef.y_sec_strength[i] == 3)
+			frame.cdef.y_sec_strength[i] = 4;
+		if (frame.cdef.uv_sec_strength[i] == 3)
+			frame.cdef.uv_sec_strength[i] = 4;
+	}
+
+	frame.loop_restoration.frame_restoration_type[0] =
+		pic->loop_restoration_fields.bits.yframe_restoration_type;
+	frame.loop_restoration.frame_restoration_type[1] =
+		pic->loop_restoration_fields.bits.cbframe_restoration_type;
+	frame.loop_restoration.frame_restoration_type[2] =
+		pic->loop_restoration_fields.bits.crframe_restoration_type;
+	frame.loop_restoration.lr_unit_shift = pic->loop_restoration_fields.bits.lr_unit_shift;
+	frame.loop_restoration.lr_uv_shift = pic->loop_restoration_fields.bits.lr_uv_shift;
+	for (i = 0; i < 3; i++)
+		if (frame.loop_restoration.frame_restoration_type[i]) {
+			frame.loop_restoration.flags |= V4L2_AV1_LOOP_RESTORATION_FLAG_USES_LR;
+			if (i)
+				frame.loop_restoration.flags |=
+					V4L2_AV1_LOOP_RESTORATION_FLAG_USES_CHROMA_LR;
+		}
+
+	for (i = 0; i < 7; i++) {
+		const VAWarpedMotionParamsAV1 *wm = &pic->wm[i];
+
+		frame.global_motion.type[V4L2_AV1_REF_LAST_FRAME + i] = wm->wmtype;
+		for (j = 0; j < 6; j++)
+			frame.global_motion.params[V4L2_AV1_REF_LAST_FRAME + i][j] = wm->wmmat[j];
+		if (wm->wmtype != VAAV1TransformationIdentity)
+			frame.global_motion.flags[V4L2_AV1_REF_LAST_FRAME + i] |=
+				V4L2_AV1_GLOBAL_MOTION_FLAG_IS_GLOBAL;
+		if (wm->wmtype == VAAV1TransformationRotzoom)
+			frame.global_motion.flags[V4L2_AV1_REF_LAST_FRAME + i] |=
+				V4L2_AV1_GLOBAL_MOTION_FLAG_IS_ROT_ZOOM;
+		if (wm->wmtype == VAAV1TransformationTranslation)
+			frame.global_motion.flags[V4L2_AV1_REF_LAST_FRAME + i] |=
+				V4L2_AV1_GLOBAL_MOTION_FLAG_IS_TRANSLATION;
+		if (wm->invalid)
+			frame.global_motion.invalid |=
+				V4L2_AV1_GLOBAL_MOTION_IS_INVALID(V4L2_AV1_REF_LAST_FRAME + i);
+	}
+
+#define FLAG(field, flag) \
+	if (pic->pic_info_fields.bits.field) frame.flags |= V4L2_AV1_FRAME_FLAG_##flag
+	FLAG(show_frame, SHOW_FRAME);
+	FLAG(showable_frame, SHOWABLE_FRAME);
+	FLAG(error_resilient_mode, ERROR_RESILIENT_MODE);
+	FLAG(disable_cdf_update, DISABLE_CDF_UPDATE);
+	FLAG(allow_screen_content_tools, ALLOW_SCREEN_CONTENT_TOOLS);
+	FLAG(force_integer_mv, FORCE_INTEGER_MV);
+	FLAG(allow_intrabc, ALLOW_INTRABC);
+	FLAG(use_superres, USE_SUPERRES);
+	FLAG(allow_high_precision_mv, ALLOW_HIGH_PRECISION_MV);
+	FLAG(is_motion_mode_switchable, IS_MOTION_MODE_SWITCHABLE);
+	FLAG(use_ref_frame_mvs, USE_REF_FRAME_MVS);
+	FLAG(disable_frame_end_update_cdf, DISABLE_FRAME_END_UPDATE_CDF);
+	FLAG(allow_warped_motion, ALLOW_WARPED_MOTION);
+#undef FLAG
+	if (pic->mode_control_fields.bits.reference_select)
+		frame.flags |= V4L2_AV1_FRAME_FLAG_REFERENCE_SELECT;
+	if (pic->mode_control_fields.bits.reduced_tx_set_used)
+		frame.flags |= V4L2_AV1_FRAME_FLAG_REDUCED_TX_SET;
+	if (pic->mode_control_fields.bits.skip_mode_present)
+		frame.flags |= V4L2_AV1_FRAME_FLAG_SKIP_MODE_PRESENT |
+			       V4L2_AV1_FRAME_FLAG_SKIP_MODE_ALLOWED;
+
+	frame.frame_type = pic->pic_info_fields.bits.frame_type;
+	frame.order_hint = pic->order_hint;
+	frame.primary_ref_frame = pic->primary_ref_frame;
+	frame.interpolation_filter = pic->interp_filter;
+	frame.tx_mode = pic->mode_control_fields.bits.tx_mode;
+
+	/*
+	 * VA-API's frame width is the coded one, which with superres is the
+	 * UPSCALED width; the frame is decoded at the downscaled width the
+	 * specification derives from it (7.21 / superres_params()).
+	 */
+	frame.upscaled_width = pic->frame_width_minus1 + 1;
+	frame.frame_width_minus_1 = pic->frame_width_minus1;
+	if (pic->pic_info_fields.bits.use_superres && pic->superres_scale_denominator) {
+		unsigned int denom = pic->superres_scale_denominator;
+		unsigned int w = (frame.upscaled_width * 8 + denom / 2) / denom;
+
+		frame.frame_width_minus_1 = (w < 16 ? 16 : w) - 1;
+	}
+	frame.frame_height_minus_1 = pic->frame_height_minus1;
+	frame.render_width_minus_1 = frame.upscaled_width - 1;
+	frame.render_height_minus_1 = pic->frame_height_minus1;
+
+	for (i = 0; i < 8; i++)
+		frame.reference_frame_ts[i] = av1_surface_ts(driver_data, pic->ref_frame_map[i]);
+	for (i = 0; i < 7; i++) {
+		frame.ref_frame_idx[i] = pic->ref_frame_idx[i];
+		ref = SURFACE(driver_data, pic->ref_frame_map[pic->ref_frame_idx[i] & 7]);
+		if (ref != NULL && ref->av1_decoded)
+			frame.order_hints[V4L2_AV1_REF_LAST_FRAME + i] = ref->av1_order_hint;
+	}
+	if (frame.frame_type != V4L2_AV1_KEY_FRAME &&
+	    frame.frame_type != V4L2_AV1_INTRA_ONLY_FRAME &&
+	    pic->mode_control_fields.bits.skip_mode_present)
+		av1_skip_mode(&frame, bits, frame.skip_mode_frame);
+
+	/* what a later frame referencing this surface will need */
+	surface_object->av1_order_hint = pic->order_hint;
+	surface_object->av1_decoded = true;
+
+	/* ---- film grain ---- */
+	memset(&grain, 0, sizeof(grain));
+	if (fg->film_grain_info_fields.bits.apply_grain) {
+		grain.flags = V4L2_AV1_FILM_GRAIN_FLAG_APPLY_GRAIN |
+			      V4L2_AV1_FILM_GRAIN_FLAG_UPDATE_GRAIN;
+		if (fg->film_grain_info_fields.bits.chroma_scaling_from_luma)
+			grain.flags |= V4L2_AV1_FILM_GRAIN_FLAG_CHROMA_SCALING_FROM_LUMA;
+		if (fg->film_grain_info_fields.bits.overlap_flag)
+			grain.flags |= V4L2_AV1_FILM_GRAIN_FLAG_OVERLAP;
+		if (fg->film_grain_info_fields.bits.clip_to_restricted_range)
+			grain.flags |= V4L2_AV1_FILM_GRAIN_FLAG_CLIP_TO_RESTRICTED_RANGE;
+		grain.grain_seed = fg->grain_seed;
+		grain.num_y_points = fg->num_y_points;
+		memcpy(grain.point_y_value, fg->point_y_value, sizeof(fg->point_y_value));
+		memcpy(grain.point_y_scaling, fg->point_y_scaling, sizeof(fg->point_y_scaling));
+		grain.num_cb_points = fg->num_cb_points;
+		memcpy(grain.point_cb_value, fg->point_cb_value, sizeof(fg->point_cb_value));
+		memcpy(grain.point_cb_scaling, fg->point_cb_scaling, sizeof(fg->point_cb_scaling));
+		grain.num_cr_points = fg->num_cr_points;
+		memcpy(grain.point_cr_value, fg->point_cr_value, sizeof(fg->point_cr_value));
+		memcpy(grain.point_cr_scaling, fg->point_cr_scaling, sizeof(fg->point_cr_scaling));
+		grain.grain_scaling_minus_8 = fg->film_grain_info_fields.bits.grain_scaling_minus_8;
+		grain.ar_coeff_lag = fg->film_grain_info_fields.bits.ar_coeff_lag;
+		for (i = 0; i < 24; i++)
+			grain.ar_coeffs_y_plus_128[i] = fg->ar_coeffs_y[i] + 128;
+		for (i = 0; i < 25; i++) {
+			grain.ar_coeffs_cb_plus_128[i] = fg->ar_coeffs_cb[i] + 128;
+			grain.ar_coeffs_cr_plus_128[i] = fg->ar_coeffs_cr[i] + 128;
+		}
+		grain.ar_coeff_shift_minus_6 = fg->film_grain_info_fields.bits.ar_coeff_shift_minus_6;
+		grain.grain_scale_shift = fg->film_grain_info_fields.bits.grain_scale_shift;
+		grain.cb_mult = fg->cb_mult;
+		grain.cb_luma_mult = fg->cb_luma_mult;
+		grain.cb_offset = fg->cb_offset;
+		grain.cr_mult = fg->cr_mult;
+		grain.cr_luma_mult = fg->cr_luma_mult;
+		grain.cr_offset = fg->cr_offset;
+	}
+
+	memset(controls, 0, sizeof(controls));
+	controls[n].id = V4L2_CID_STATELESS_AV1_SEQUENCE;
+	controls[n].ptr = &seq;
+	controls[n++].size = sizeof(seq);
+	controls[n].id = V4L2_CID_STATELESS_AV1_FRAME;
+	controls[n].ptr = &frame;
+	controls[n++].size = sizeof(frame);
+	controls[n].id = V4L2_CID_STATELESS_AV1_TILE_GROUP_ENTRY;
+	controls[n].ptr = p->tiles;
+	controls[n++].size = p->tiles_count * sizeof(p->tiles[0]);
+	if (seq.flags & V4L2_AV1_SEQUENCE_FLAG_FILM_GRAIN_PARAMS_PRESENT) {
+		controls[n].id = V4L2_CID_STATELESS_AV1_FILM_GRAIN;
+		controls[n].ptr = &grain;
+		controls[n++].size = sizeof(grain);
+	}
+
+	rc = v4l2_set_controls(driver_data->video_fd, surface_object->request_fd,
+			       controls, n);
+	if (rc < 0)
+		return -1;
+
+	return 0;
+}
