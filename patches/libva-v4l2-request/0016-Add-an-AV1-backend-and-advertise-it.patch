+/* The largest coded size a device reports for a format; false if it says none. */
+bool v4l2_max_frame_size(int video_fd, unsigned int pixelformat,
+			 unsigned int *width, unsigned int *height)
+{
+	struct v4l2_frmsizeenum size;
+
+	memset(&size, 0, sizeof(size));
+	size.pixel_format = pixelformat;
+	if (ioctl(video_fd, VIDIOC_ENUM_FRAMESIZES, &size) < 0)
+		return false;
+
+	if (size.type == V4L2_FRMSIZE_TYPE_DISCRETE) {
+		*width = size.discrete.width;
+		*height = size.discrete.height;
+	} else {
+		*width = size.stepwise.max_width;
+		*height = size.stepwise.max_height;
+	}
+
+	return true;
+}
