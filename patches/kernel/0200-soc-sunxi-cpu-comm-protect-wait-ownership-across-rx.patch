+
+/* Complete under the active-wait list lock. Timeout cleanup uses that
+ * same lock, so it cannot recycle a wait while RX still holds a pointer.
+ * Publish the ACK before waking the caller: it may immediately recycle
+ * the return slot and wait object on another ARM CPU.
+ */
+void cpu_comm_complete_return(u32 cpu, u32 session, unsigned long entry,
+			      u8 status, u32 param, u64 peer_wait)
+{
+	u8 *list = (u8 *)(getSeq(cpu) + 40);
+	unsigned long sentinel = (unsigned long)(list + 56);
+	unsigned long node;
+	u32 *wait = NULL;
+	unsigned int walked = 0;
+	bool recycle = true;
+
+	cpu_comm_sem_down(list + 64);
+	node = cc_deref(*(u32 *)(list + 56));
+	while (node && node != sentinel && walked++ < MAX_WAIT_ENTRIES) {
+		unsigned long first = (unsigned long)&s_CommSockt[1248 * cpu + 73];
+		unsigned long candidate = node - 24;
+
+		/* Active-list nodes must be exact objects in this CPU's pool. */
+		if (candidate < first || candidate - first >= MAX_WAIT_ENTRIES * 32 ||
+		    (candidate - first) % 32)
+			break;
+		if (*(u32 *)candidate == session) {
+			wait = (u32 *)candidate;
+			break;
+		}
+		node = cc_deref(*(u32 *)node);
+	}
+	if (wait && !wait[3]) {
+		wait[3] = cc_ref((void *)entry); /* ARM-local completion claim */
+		AddReturn2Fifo((u32 *)(getShareSeqR(cpu, 1) + 32), (void *)entry);
+		*(u16 *)(entry + 10) |= 0x40;
+	} else {
+		/* A duplicate of a still-queued slot must not be freed. */
+		if (wait && wait[3] == cc_ref((void *)entry))
+			recycle = false;
+		wait = NULL;
+		pr_warn_ratelimited("cpu_comm: late/duplicate RETURN session=%x\n", session);
+	}
+
+	SendAckLow((void *)getShareSeqW(cpu, 1), FIFO_DEFAULT_CAP - 1,
+		   status, param, peer_wait);
+	if (wait)
+		cpu_comm_sem_up(wait + 2);
+	cpu_comm_sem_up(list + 64);
+	if (!wait && recycle)
+		Comm_ReleaseFreeCall((void *)getShareSeqR(cpu, 1), (void *)entry);
 }
 
