From: Christopher Stenger <chris.h.stenger@gmail.com>
Date: Sat, 14 Nov 2026 18:00:00 -0800
Subject: [PATCH] soc: sunxi: cpu_comm: protect ARM wait ownership across RX

The IRQ trial exposed latent concurrency hazards: the packed counter
helpers test then decrement without exclusion, and RETURN wakes the caller
before it finishes using the shared ACK header. Timeout cleanup can also
recycle a wait after lookup but before RX signals it.

Serialize counter claims, use an uninterruptible wait for void down(),
refuse recycling without a lock, and complete RETURN under the active-wait
list lock. Match ARM sessions rather than following peer wait handles.
Snapshot and echo all 64 bits of sender-owned ACK metadata before waking
the caller. Bound reference translation to registered arenas or reserved
shared memory; arbitrary peer values must not name kernel virtual memory.
ACKs may signal only the current ARM-owned completion counter for that CPU.

Keep IRQ opt-in. These source defects are independently testable; hardware
qualification must establish whether they account for the observed crash.

Link: https://github.com/cstenger/allwinner-h713-mainline/issues/4

--- a/drivers/soc/sunxi/cpu_comm/cpu_comm.h
+++ b/drivers/soc/sunxi/cpu_comm/cpu_comm.h
@@ -22,6 +22,7 @@
 #include <linux/cdev.h>
 #include <linux/wait.h>
 #include <linux/atomic.h>
+#include <linux/spinlock.h>
 #include <linux/sched.h>
 
 /*
@@ -39,49 +40,56 @@
 
 extern wait_queue_head_t cpu_comm_sem_wq;
 
+/* Protect a claim and the decrement together, including packed/uncached
+ * counters on which native atomic instructions cannot safely be used.
+ */
+extern spinlock_t cpu_comm_sem_lock;
+
+static inline bool cpu_comm_sem_try_down(void *addr)
+{
+	u32 *count = addr;
+	unsigned long flags;
+	bool taken = false;
+
+	spin_lock_irqsave(&cpu_comm_sem_lock, flags);
+	if (READ_ONCE(*count)) {
+		WRITE_ONCE(*count, *count - 1);
+		taken = true;
+	}
+	spin_unlock_irqrestore(&cpu_comm_sem_lock, flags);
+	return taken;
+}
+
 static inline void cpu_comm_sem_down(void *addr)
 {
-	u32 *count = (u32 *)addr;
-
-	wait_event_interruptible(cpu_comm_sem_wq, *count > 0);
-	(*count)--;
+	/* A void lock acquisition must not proceed after an ignored signal. */
+	wait_event(cpu_comm_sem_wq, cpu_comm_sem_try_down(addr));
 }
 
 static inline int cpu_comm_sem_down_interruptible(void *addr)
 {
-	u32 *count = (u32 *)addr;
-	int ret;
-
-	ret = wait_event_interruptible(cpu_comm_sem_wq, *count > 0);
-	if (ret)
-		return ret;
-	(*count)--;
-	return 0;
+	return wait_event_interruptible(cpu_comm_sem_wq,
+					cpu_comm_sem_try_down(addr));
 }
 
 static inline int cpu_comm_sem_down_timeout(void *addr, long jiffies)
 {
-	u32 *count = (u32 *)addr;
-	long ret;
-
-	ret = wait_event_interruptible_timeout(cpu_comm_sem_wq,
-					       *count > 0, jiffies);
-	if (ret == 0)
-		return -ETIME;	/* timeout */
-	if (ret < 0)
-		return (int)ret; /* interrupted */
-	(*count)--;
-	return 0;
+	long ret = wait_event_interruptible_timeout(cpu_comm_sem_wq,
+				cpu_comm_sem_try_down(addr), jiffies);
+
+	return ret > 0 ? 0 : ret == 0 ? -ETIME : (int)ret;
 }
 
 static inline void cpu_comm_sem_up(void *addr)
 {
-	u32 *count = (u32 *)addr;
+	u32 *count = addr;
+	unsigned long flags;
 
 	if (!count)
 		return;
-
-	(*count)++;
+	spin_lock_irqsave(&cpu_comm_sem_lock, flags);
+	WRITE_ONCE(*count, *count + 1);
+	spin_unlock_irqrestore(&cpu_comm_sem_lock, flags);
 	wake_up_all(&cpu_comm_sem_wq);
 }
 
