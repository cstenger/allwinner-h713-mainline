+/*
+ * LETTERBOX: a video picture smaller than the panel, placed anywhere on it.
+ *
+ * The MIPS display firmware's window layer does this for its capture inputs;
+ * with the MIPS parked, this driver writes the same registers itself. The
+ * model comes from static RE of display.bin and is hardware-checked
+ * (docs/reference/letterbox-recipe-2026-10-04.md and
+ * letterbox-phase1-2026-10-04.md). tools/display/letterbox-recipe.py is the
+ * single source of these formulas; the table below transcribes its FIELDS.
+ *
+ *  - Placement is an offset added to the NR (composition, 0x05000000) output
+ *    origin; proc copies its input position to its output; the panel's
+ *    program window stays put. The bars are the vblender border overlay
+ *    (0x05200000) -- which must stay programmed: with zero borders the lines
+ *    above the picture show garbage and the picture turns green.
+ *  - Fields marked ABS are the firmware's formula. REL fields are timing
+ *    positions whose fixed per-register delays are not all derived; they are
+ *    the probe snapshot plus f(new) - f(native).
+ *  - comp+0x858[31:16] is the PICTURE height: left at the panel's 720 it
+ *    clips the bottom of every vertically offset picture (bisected on
+ *    hardware 2026-10-05).
+ *
+ * Unscaled only (proc at unity) and NV12 only: the line-buffer descriptors
+ * are not derived for P010.
+ */
+enum { LB_COMP, LB_ROUTE, LB_PROC, LB_LVDS, LB_VBLEND };
+
+struct h713_lb_field {
+	u8 blk;
+	u16 off;
+	u8 lsb, width;
+	bool rel;
+	u32 (*f)(const struct h713_geom *g);
+};
+
+static u32 lb_w(const struct h713_geom *g) { return g->w; }
+static u32 lb_h(const struct h713_geom *g) { return g->h; }
+static u32 lb_dx(const struct h713_geom *g) { return g->dx; }
+static u32 lb_dy(const struct h713_geom *g) { return g->dy; }
+static u32 lb_even_w(const struct h713_geom *g) { return ALIGN(g->w, 2); }
+static u32 lb_even_h(const struct h713_geom *g) { return ALIGN(g->h, 2); }
+static u32 lb_half_h(const struct h713_geom *g) { return g->h / 2; }
+static u32 lb_h_plus1(const struct h713_geom *g) { return g->h + 1; }
+/* GetPsuPfuWin's compressed branch: ((0.8 W << 3) + 0x7f) >> 7 = ceil(W/20) */
+static u32 lb_rowbyte(const struct h713_geom *g) { return DIV_ROUND_UP(g->w, 20); }
+static u32 lb_one(const struct h713_geom *g) { return 1; }
+
+/* WriteBorderOverlay1 (0x8b1a55d8): panel 1280x720 assumed by the caller. */
+static u32 lb_right(const struct h713_geom *g) { return 1280 - g->dx - g->w; }
+static u32 lb_bottom(const struct h713_geom *g) { return 720 - g->dy - g->h; }
+static u32 lb_top_0(const struct h713_geom *g) { return g->dy & 0xf; }
+static u32 lb_top_1(const struct h713_geom *g) { return (g->dy >> 4) & 0xf; }
+static u32 lb_top_2(const struct h713_geom *g) { return (g->dy >> 8) & 0xf; }
+
+#define ABS(b, o, l, w, fn)	{ b, o, l, w, false, fn }
+#define REL(b, o, l, w, fn)	{ b, o, l, w, true, fn }
+
+/* In the firmware's write order: NR (flag order), route, proc, panel, vblend. */
+static const struct h713_lb_field h713_lb_fields[] = {
+	/* NR line-buffer descriptors, A (0x4) then B (0x2) */
+	ABS(LB_COMP, 0x0f0, 0, 8, lb_rowbyte),
+	ABS(LB_COMP, 0x0f0, 8, 8, lb_rowbyte),
+	ABS(LB_COMP, 0x174, 0, 16, lb_rowbyte),
+	ABS(LB_COMP, 0x174, 16, 12, lb_rowbyte),
+	ABS(LB_COMP, 0x1b4, 0, 16, lb_rowbyte),
+	ABS(LB_COMP, 0x1b4, 16, 12, lb_rowbyte),
+	ABS(LB_COMP, 0x210, 0, 8, lb_rowbyte),
+	ABS(LB_COMP, 0x210, 8, 8, lb_rowbyte),
+	ABS(LB_COMP, 0x224, 0, 16, lb_w),
+	ABS(LB_COMP, 0x224, 16, 16, lb_h),
+	ABS(LB_COMP, 0x274, 0, 16, lb_rowbyte),
+	ABS(LB_COMP, 0x274, 16, 12, lb_rowbyte),
+	ABS(LB_COMP, 0x278, 0, 16, lb_half_h),
+	ABS(LB_COMP, 0x2b4, 0, 16, lb_rowbyte),
+	ABS(LB_COMP, 0x2b4, 16, 12, lb_rowbyte),
+	ABS(LB_COMP, 0x2b8, 0, 16, lb_h),
+	/* NR fetch window (0x400, 0x1000, 0x2000, 0x4000) */
+	ABS(LB_COMP, 0x804, 0, 16, lb_even_w),
+	REL(LB_COMP, 0x804, 16, 16, lb_dx),
+	REL(LB_COMP, 0x808, 0, 16, lb_dx),
+	REL(LB_COMP, 0x80c, 0, 16, lb_h),
+	REL(LB_COMP, 0x80c, 16, 16, lb_dy),
+	REL(LB_COMP, 0x858, 0, 16, lb_dy),
+	ABS(LB_COMP, 0x858, 16, 16, lb_h),
+	REL(LB_COMP, 0x85c, 0, 16, lb_dx),
+	ABS(LB_COMP, 0x85c, 16, 16, lb_w),
+	REL(LB_COMP, 0x844, 0, 16, lb_dx),
+	ABS(LB_COMP, 0x844, 16, 16, lb_even_w),
+	REL(LB_COMP, 0x840, 0, 16, lb_dy),
+	ABS(LB_COMP, 0x840, 16, 16, lb_h_plus1),
+	/* route windows, all at (0, 0) */
+	ABS(LB_ROUTE, 0x104, 16, 16, lb_even_w),
+	ABS(LB_ROUTE, 0x108, 16, 16, lb_even_h),
+	ABS(LB_ROUTE, 0x11c, 16, 16, lb_h),
+	ABS(LB_ROUTE, 0x124, 16, 16, lb_w),
+	ABS(LB_ROUTE, 0x128, 16, 16, lb_h),
+	ABS(LB_ROUTE, 0xd40, 16, 16, lb_w),
+	ABS(LB_ROUTE, 0xd44, 16, 16, lb_h),
+	/* proc instance 0 at unity */
+	ABS(LB_PROC, 0x034, 16, 16, lb_w),
+	ABS(LB_PROC, 0x034, 0, 16, lb_h),
+	ABS(LB_PROC, 0x02c, 0, 16, lb_w),
+	REL(LB_PROC, 0x02c, 16, 16, lb_dx),
+	ABS(LB_PROC, 0x030, 0, 16, lb_h),
+	ABS(LB_PROC, 0x040, 0, 16, lb_w),
+	REL(LB_PROC, 0x044, 0, 16, lb_dx),
+	ABS(LB_PROC, 0x050, 0, 16, lb_h),
+	REL(LB_PROC, 0x050, 16, 16, lb_dy),
+	/* panel video_win_2 sizes; program and crtc windows stay */
+	ABS(LB_LVDS, 0x03c, 16, 16, lb_w),
+	ABS(LB_LVDS, 0x040, 16, 16, lb_h),
+	ABS(LB_LVDS, 0x0a4, 16, 16, lb_w),
+	ABS(LB_LVDS, 0x0a8, 16, 16, lb_h),
+	/* vblender border overlay */
+	ABS(LB_VBLEND, 0x000, 0, 12, lb_right),
+	ABS(LB_VBLEND, 0x000, 12, 4, lb_top_0),
+	ABS(LB_VBLEND, 0x000, 16, 12, lb_dx),
+	ABS(LB_VBLEND, 0x000, 28, 4, lb_top_1),
+	ABS(LB_VBLEND, 0x004, 0, 12, lb_bottom),
+	ABS(LB_VBLEND, 0x004, 12, 4, lb_top_2),
+	ABS(LB_VBLEND, 0x004, 30, 1, lb_one),
+};
+
+/* The NR hold/release bracket (NRWinNode::WriteReg flags 0x100c0 / 0x8120). */
+#define NR_ENABLE		0x040	/* bit 25 */
+#define NR_HOLD_A		0x860	/* bit 17 */
+#define NR_HOLD_B		0x138	/* bit 27 */
+#define NR_RELEASED		0x82c	/* [15:0] = 1 on release */
+
+static void __iomem *h713_lb_base(struct h713_afbd *h, u8 blk)
+{
+	switch (blk) {
+	case LB_COMP:	return h->comp_regs;
+	case LB_ROUTE:	return h->route_regs;
+	case LB_PROC:	return h->proc_regs;
+	case LB_LVDS:	return h->lvds_regs;
+	default:	return h->vblend_regs;
+	}
+}
+
+static int h713_lb_reg_index(struct h713_afbd *h, u8 blk, u16 off)
+{
+	unsigned int i;
+
+	for (i = 0; i < h->lb_nregs; i++)
+		if (h->lb_blk[i] == blk && h->lb_off[i] == off)
+			return i;
+	return -1;
+}
+
+/*
+ * Every register word for geometry @g, from the native snapshot. Returns
+ * -ERANGE if a field does not fit, so a geometry the model cannot express is
+ * refused in atomic_check, never written.
+ */
+static int h713_lb_words(struct h713_afbd *h, const struct h713_geom *g,
+			 u32 *words)
+{
+	unsigned int i;
+
+	memcpy(words, h->lb_snap, h->lb_nregs * sizeof(*words));
+	for (i = 0; i < ARRAY_SIZE(h713_lb_fields); i++) {
+		const struct h713_lb_field *fl = &h713_lb_fields[i];
+		int r = h713_lb_reg_index(h, fl->blk, fl->off);
+		u32 mask = GENMASK(fl->lsb + fl->width - 1, fl->lsb);
+		s64 val;
+
+		if (r < 0)
+			return -EINVAL;
+		if (fl->rel)
+			val = (s64)((h->lb_snap[r] & mask) >> fl->lsb) +
+			      fl->f(g) - fl->f(&h->native);
+		else
+			val = fl->f(g);
+		if (val < 0 || val > (s64)(mask >> fl->lsb))
+			return -ERANGE;
+		words[r] = (words[r] & ~mask) | ((u32)val << fl->lsb);
+	}
+	return 0;
+}
+
+/*
+ * Snapshot the registers at probe and require the model to reproduce them
+ * for the native geometry, field by field -- the same test
+ * letterbox-recipe.py --self-test runs. A board whose state differs keeps the
+ * native-only plane rather than writing values derived from a wrong base.
+ */
+static bool h713_lb_snapshot(struct h713_afbd *h)
+{
+	u32 words[H713_LB_MAX_REGS];
+	unsigned int i;
+
+	h->lb_nregs = 0;
+	for (i = 0; i < ARRAY_SIZE(h713_lb_fields); i++) {
+		const struct h713_lb_field *fl = &h713_lb_fields[i];
+
+		if (h713_lb_reg_index(h, fl->blk, fl->off) >= 0)
+			continue;
+		if (WARN_ON(h->lb_nregs == H713_LB_MAX_REGS))
+			return false;
+		h->lb_blk[h->lb_nregs] = fl->blk;
+		h->lb_off[h->lb_nregs] = fl->off;
+		h->lb_snap[h->lb_nregs] = readl(h713_lb_base(h, fl->blk) + fl->off);
+		h->lb_nregs++;
+	}
+	if (h713_lb_words(h, &h->native, words))
+		return false;
+	for (i = 0; i < h->lb_nregs; i++)
+		if (words[i] != h->lb_snap[i]) {
+			drm_warn(&h->drm,
+				 "letterbox off: block %u +0x%03x reads %08x, model %08x\n",
+				 h->lb_blk[i], h->lb_off[i], h->lb_snap[i], words[i]);
+			return false;
+		}
+	if (!(readl(h->comp_regs + NR_ENABLE) & BIT(25)) ||
+	    readl(h->comp_regs + NR_HOLD_A) & BIT(17) ||
+	    readl(h->comp_regs + NR_HOLD_B) & BIT(27)) {
+		drm_warn(&h->drm, "letterbox off: NR is not in its released state\n");
+		return false;
+	}
+	return true;
+}
+
+static void h713_lb_rmw(void __iomem *reg, u32 mask, u32 val)
+{
+	writel((readl(reg) & ~mask) | val, reg);
+}
+
+/*
+ * Program comp, route, proc, panel and vblender for @g, in the firmware's
+ * order and inside its NR hold/release bracket. The video source must be
+ * stopped; AFBD's own geometry is the caller's.
+ */
+static void h713_lb_program(struct h713_afbd *h, const struct h713_geom *g)
+{
+	u32 words[H713_LB_MAX_REGS];
+	unsigned int i;
+
+	if (h713_lb_words(h, g, words)) {
+		drm_err(&h->drm, "letterbox %ux%u at (%u,%u) is not expressible\n",
+			g->w, g->h, g->dx, g->dy);
+		return;
+	}
+
+	h713_lb_rmw(h->comp_regs + NR_HOLD_A, BIT(17), BIT(17));
+	h713_lb_rmw(h->comp_regs + NR_HOLD_B, BIT(27), BIT(27));
+	h713_lb_rmw(h->comp_regs + NR_ENABLE, BIT(25), 0);
+	for (i = 0; i < h->lb_nregs; i++)
+		if (h->lb_blk[i] == LB_COMP)
+			writel(words[i], h->comp_regs + h->lb_off[i]);
+	h713_lb_rmw(h->comp_regs + NR_HOLD_A, BIT(17), 0);
+	h713_lb_rmw(h->comp_regs + NR_HOLD_B, BIT(27), 0);
+	h713_lb_rmw(h->comp_regs + NR_RELEASED, GENMASK(15, 0), 1);
+	h713_lb_rmw(h->comp_regs + NR_ENABLE, BIT(25), BIT(25));
+	for (i = 0; i < h->lb_nregs; i++)
+		if (h->lb_blk[i] != LB_COMP)
+			writel(words[i], h713_lb_base(h, h->lb_blk[i]) +
+					 h->lb_off[i]);
+
+	h->hw_geom = *g;
+	drm_dbg_kms(&h->drm, "video picture %ux%u at (%u,%u)\n",
+		    g->w, g->h, g->dx, g->dy);
+}
+
+static bool h713_geom_eq(const struct h713_geom *a, const struct h713_geom *b)
+{
+	return a->w == b->w && a->h == b->h && a->dx == b->dx && a->dy == b->dy;
+}
