+static void h713_plane_geom(const struct drm_plane_state *s,
+			    struct h713_geom *g)
+{
+	g->w = s->src_w >> 16;
+	g->h = s->src_h >> 16;
+	g->dx = s->crtc_x;
+	g->dy = s->crtc_y;
+}
+
+/*
+ * A picture smaller than the panel, shown unscaled at (crtc_x, crtc_y).
+ * Everything the hardware cannot do is refused here, never in atomic_update:
+ * AFBD rounds the stride up to 16 samples (a pitch that is not a multiple
+ * shears) and fetches whole 16x16 blocks (the buffer must cover them, or the
+ * fetch runs past it and faults the IOMMU).
+ */
+static int h713_lb_check(struct h713_afbd *h,
+			 const struct drm_plane_state *s,
+			 const struct h713_geom *g)
+{
+	struct drm_framebuffer *fb = s->fb;
+	u32 words[H713_LB_MAX_REGS];
+	u32 pitch = fb->pitches[0];
+	u32 rows = ALIGN(g->h, 16);
+
+	if (!h->lb_ok || fb->format->format != DRM_FORMAT_NV12)
+		return -EINVAL;
+	if (s->src_x || s->src_y || (s->src_w & 0xffff) || (s->src_h & 0xffff) ||
+	    s->crtc_w != g->w || s->crtc_h != g->h ||
+	    s->crtc_x < 0 || s->crtc_y < 0 || (s->crtc_x & 1) ||
+	    g->w < 64 || g->h < 64 || (g->w & 1) || (g->h & 1) ||
+	    g->dx + g->w > h->native.w || g->dy + g->h > h->native.h)
+		return -EINVAL;
+	if (fb->pitches[1] != pitch || pitch % 16 || pitch < ALIGN(g->w, 16))
+		return -EINVAL;
+	if (fb->offsets[0] + (size_t)pitch * rows > drm_gem_fb_get_obj(fb, 0)->size ||
+	    fb->offsets[1] + (size_t)pitch * rows / 2 > drm_gem_fb_get_obj(fb, 1)->size)
+		return -ERANGE;
+	return h713_lb_words(h, g, words);
+}
