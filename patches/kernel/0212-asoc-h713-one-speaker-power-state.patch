From: Christopher Stenger <chris.h.stenger@gmail.com>
Subject: [PATCH] ASoC: sun4i-codec: h713: one speaker power state, not per stream

Every close of the playback PCM popped the speaker. Measured with a
microphone and the PA line, DAPM and PCM state logged every 2 ms
(docs/speaker-pop-evidence/2026-11-17):

- STOP alone, which 0181 used to drop PA, is silent;
- the PA rise, 700 ms after the analog path and 200 ms after START, is
  silent;
- close pops, 8 of 9 HDMI speaker stops, even with digital-zero samples
  and DAC volume 0. sun4i_codec_shutdown() stops the module clock
  microseconds after STOP dropped PA, while the amplifier is still winding
  down. Separating the two: 0-10 ms pops, 30 ms is still faint with the
  fan off, 100 ms and more is silent.

The speaker must never pop, so the clock, the analog path and PA become
one state that is held while the projector is awake:

  up:   clock on (48 kHz family if idle), DAC/HP-amp/line-out path forced
        on in DAPM, 700 ms settle, PA high;
  down: PA low, 300 ms hold, path released, clock off.

Streams start and stop inside it and no longer touch PA or stop the clock:
the clock reference taken in startup/shutdown is still balanced, but the
state's own reference keeps it running. A rate change while up (hw_params
for the other rate family) takes PA down around clk_set_rate() exactly
like a power-down. The Speaker widget has no event any more; DAPM's 700 ms
sleep on every stream start is gone with it.

"Speaker Power" (card control, default on) lets userspace take the state
down for standby and up again; it returns once the transition is complete.
Probe brings it up from a work item so boot does not wait 700 ms. Suspend,
.shutdown (power-off and reboot) and removal take it down and keep it
down; resume restores the control's setting.

Replaces the per-stream PA gate of 0180/0181. Other sun4i-codec variants
are unchanged.

---
--- a/sound/soc/sunxi/sun4i-codec.c
+++ b/sound/soc/sunxi/sun4i-codec.c
@@ -20,9 +20,9 @@
 #include <linux/regmap.h>
 #include <linux/reset.h>
 #include <linux/gpio/consumer.h>
-#include <linux/spinlock.h>
+#include <linux/clk-provider.h>
+#include <linux/mutex.h>
 #include <linux/workqueue.h>
-#include <linux/jiffies.h>
 
 #include <sound/core.h>
 #include <sound/jack.h>
@@ -346,13 +346,18 @@
 	struct gpio_desc *gpio_pa;
 	struct gpio_desc *gpio_hp;
 
-	/* H713 PA GPIO is non-sleeping; trigger and work share this lock. */
-	bool pa_on_playback;
-	bool pa_speaker_on;
-	bool pa_playback_on;
-	unsigned long pa_ready_at;
-	spinlock_t pa_lock;
-	struct delayed_work pa_work;
+	/*
+	 * H713 speaker power: the module clock, the analog path and the
+	 * external amplifier (PA) are one state, not per stream. See
+	 * sun50i_h713_spk_up_locked().
+	 */
+	bool spk_power;		/* this codec uses the speaker power state */
+	bool spk_want;		/* "Speaker Power" control */
+	bool spk_blocked;	/* suspended or shutting down */
+	bool spk_on;		/* clock held, path forced, PA high */
+	struct mutex spk_lock;
+	struct work_struct spk_work;
+	struct snd_soc_card *card;
 
 	/* ADC_FIFOC register is at different offset on different SoCs */
 	struct regmap_field *reg_adc_fifoc;
@@ -365,60 +370,192 @@
 	struct snd_dmaengine_dai_dma_data	playback_dma_data;
 };
 
-/* Enable PA only after the running DAC has consumed its initial samples. */
-static void sun50i_h713_codec_pa_work(struct work_struct *work)
+/* ── H713 speaker power: begin (tools/audio/test-speaker-power.py) ── */
+/*
+ * Every PCM close used to pop: sun4i_codec_shutdown() stopped the module
+ * clock microseconds after trigger STOP dropped PA, while the amplifier was
+ * still winding down. Measured with a microphone (docs/speaker-pop-evidence/
+ * 2026-11-17): STOP alone and the PA rise are silent; the clock stopping
+ * 0-10 ms after PA falls pops, 30 ms is still faint with the fan off, 100 ms
+ * and more is silent.
+ *
+ * So the speaker is one power state, held while the projector is awake:
+ * up = clock on, analog path forced on, settle, PA high; down = PA low,
+ * hold, analog path released, clock off. Streams start and stop inside it
+ * and never touch PA or stop the clock. Userspace turns it off for standby
+ * ("Speaker Power"); suspend, shutdown and removal turn it off too.
+ */
+#define SUN50I_H713_SPK_SETTLE_MS	700	/* analog up -> PA high (0180) */
+#define SUN50I_H713_SPK_PA_OFF_HOLD_MS	300	/* PA low -> clock off, >= 100 */
+#define SUN50I_H713_SPK_BASE_RATE	24576000	/* 48 kHz family, 512x */
+
+/* The playback path from the DAC's digital enable to the output pin. */
+static const char * const sun50i_h713_spk_widgets[] = {
+	"DAC Enable", "Left DAC", "Right DAC",
+	"Line Out Source Playback Route", "HP Amp", "LINEOUT",
+};
+
+static void sun50i_h713_spk_force_path(struct sun4i_codec *scodec, bool on)
+{
+	struct snd_soc_dapm_context *dapm = &scodec->card->dapm;
+	int i;
+
+	snd_soc_dapm_mutex_lock(dapm);
+	for (i = 0; i < ARRAY_SIZE(sun50i_h713_spk_widgets); i++) {
+		const char *w = sun50i_h713_spk_widgets[i];
+
+		if (on) {
+			snd_soc_dapm_force_enable_pin_unlocked(dapm, w);
+		} else {
+			/* Only disable clears force; enable restores connected. */
+			snd_soc_dapm_disable_pin_unlocked(dapm, w);
+			snd_soc_dapm_enable_pin_unlocked(dapm, w);
+		}
+	}
+	snd_soc_dapm_sync_unlocked(dapm);
+	snd_soc_dapm_mutex_unlock(dapm);
+}
+
+static int sun50i_h713_spk_up_locked(struct sun4i_codec *scodec)
 {
-	struct sun4i_codec *scodec = container_of(to_delayed_work(work),
-						struct sun4i_codec, pa_work);
-	unsigned long flags, now;
-
-	spin_lock_irqsave(&scodec->pa_lock, flags);
-	now = jiffies;
-	if (scodec->pa_speaker_on && scodec->pa_playback_on) {
-		/* A previous callback may race with a fresh START. */
-		if (time_before(now, scodec->pa_ready_at))
-			mod_delayed_work(system_wq, &scodec->pa_work,
-					 scodec->pa_ready_at - now);
-		else
-			gpiod_set_value(scodec->gpio_pa, 1);
+	int ret;
+
+	if (scodec->spk_on || !scodec->spk_want || scodec->spk_blocked)
+		return 0;
+
+	/* Never change the rate under a running stream: only from idle. */
+	if (!__clk_is_enabled(scodec->clk_module)) {
+		ret = clk_set_rate(scodec->clk_module,
+				   SUN50I_H713_SPK_BASE_RATE *
+				   scodec->mod_freq_mult);
+		if (ret)
+			return ret;
 	}
-	spin_unlock_irqrestore(&scodec->pa_lock, flags);
+	ret = clk_prepare_enable(scodec->clk_module);
+	if (ret)
+		return ret;
+
+	sun50i_h713_spk_force_path(scodec, true);
+	msleep(SUN50I_H713_SPK_SETTLE_MS);
+	gpiod_set_value_cansleep(scodec->gpio_pa, 1);
+	scodec->spk_on = true;
+	return 0;
 }
 
-static void sun50i_h713_codec_pa_update_locked(struct sun4i_codec *scodec)
+static void sun50i_h713_spk_down_locked(struct sun4i_codec *scodec)
 {
-	if (scodec->pa_speaker_on && scodec->pa_playback_on) {
-		/* Longer than the consumer's 80 ms playback ring. */
-		scodec->pa_ready_at = jiffies + msecs_to_jiffies(200);
-		mod_delayed_work(system_wq, &scodec->pa_work,
-				 msecs_to_jiffies(200));
-	} else {
-		cancel_delayed_work(&scodec->pa_work);
-		gpiod_set_value(scodec->gpio_pa, 0);
+	if (!scodec->spk_on)
+		return;
+
+	gpiod_set_value_cansleep(scodec->gpio_pa, 0);
+	msleep(SUN50I_H713_SPK_PA_OFF_HOLD_MS);
+	sun50i_h713_spk_force_path(scodec, false);
+	clk_disable_unprepare(scodec->clk_module);
+	scodec->spk_on = false;
+}
+
+/* Bring the state to what is wanted and allowed. */
+static int sun50i_h713_spk_apply_locked(struct sun4i_codec *scodec)
+{
+	if (scodec->spk_want && !scodec->spk_blocked)
+		return sun50i_h713_spk_up_locked(scodec);
+	sun50i_h713_spk_down_locked(scodec);
+	return 0;
+}
+
+static void sun50i_h713_spk_work(struct work_struct *work)
+{
+	struct sun4i_codec *scodec = container_of(work, struct sun4i_codec,
+						  spk_work);
+	int ret;
+
+	mutex_lock(&scodec->spk_lock);
+	ret = sun50i_h713_spk_apply_locked(scodec);
+	mutex_unlock(&scodec->spk_lock);
+	if (ret)
+		dev_err(scodec->dev, "speaker power up failed: %d\n", ret);
+}
+
+/*
+ * A rate change moves a running clock. With the speaker up, take PA down
+ * around it exactly as for a power-down, so the amplifier never sees it.
+ */
+static int sun50i_h713_spk_set_rate(struct sun4i_codec *scodec,
+				    unsigned long rate)
+{
+	bool was_on;
+	int ret;
+
+	mutex_lock(&scodec->spk_lock);
+	if (clk_get_rate(scodec->clk_module) ==
+	    clk_round_rate(scodec->clk_module, rate)) {
+		mutex_unlock(&scodec->spk_lock);
+		return 0;
+	}
+	was_on = scodec->spk_on;
+	if (was_on) {
+		gpiod_set_value_cansleep(scodec->gpio_pa, 0);
+		msleep(SUN50I_H713_SPK_PA_OFF_HOLD_MS);
+	}
+	ret = clk_set_rate(scodec->clk_module, rate);
+	if (was_on) {
+		msleep(SUN50I_H713_SPK_SETTLE_MS);
+		gpiod_set_value_cansleep(scodec->gpio_pa, 1);
 	}
+	mutex_unlock(&scodec->spk_lock);
+	return ret;
 }
 
-static void sun50i_h713_codec_pa_playback(struct sun4i_codec *scodec, bool on)
+/* Suspend, shutdown and removal: down now, and stay down. */
+static void sun50i_h713_spk_block(struct sun4i_codec *scodec)
 {
-	unsigned long flags;
+	mutex_lock(&scodec->spk_lock);
+	scodec->spk_blocked = true;
+	mutex_unlock(&scodec->spk_lock);
+	cancel_work_sync(&scodec->spk_work);
+	mutex_lock(&scodec->spk_lock);
+	sun50i_h713_spk_down_locked(scodec);
+	mutex_unlock(&scodec->spk_lock);
+}
 
-	if (!scodec->pa_on_playback)
-		return;
+static void sun50i_h713_spk_unblock(struct sun4i_codec *scodec)
+{
+	mutex_lock(&scodec->spk_lock);
+	scodec->spk_blocked = false;
+	mutex_unlock(&scodec->spk_lock);
+	schedule_work(&scodec->spk_work);
+}
+
+static int sun50i_h713_spk_power_get(struct snd_kcontrol *kcontrol,
+				     struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_card *card = snd_kcontrol_chip(kcontrol);
+	struct sun4i_codec *scodec = snd_soc_card_get_drvdata(card);
 
-	spin_lock_irqsave(&scodec->pa_lock, flags);
-	scodec->pa_playback_on = on;
-	sun50i_h713_codec_pa_update_locked(scodec);
-	spin_unlock_irqrestore(&scodec->pa_lock, flags);
+	ucontrol->value.integer.value[0] = scodec->spk_want;
+	return 0;
 }
 
-static void sun50i_h713_codec_pa_cleanup(void *data)
+/* Synchronous: returns once the speaker is fully up or fully down. */
+static int sun50i_h713_spk_power_put(struct snd_kcontrol *kcontrol,
+				     struct snd_ctl_elem_value *ucontrol)
 {
-	struct sun4i_codec *scodec = data;
+	struct snd_soc_card *card = snd_kcontrol_chip(kcontrol);
+	struct sun4i_codec *scodec = snd_soc_card_get_drvdata(card);
+	bool want = !!ucontrol->value.integer.value[0];
+	bool changed;
+	int ret;
 
-	sun50i_h713_codec_pa_playback(scodec, false);
-	cancel_delayed_work_sync(&scodec->pa_work);
+	mutex_lock(&scodec->spk_lock);
+	changed = scodec->spk_want != want;
+	scodec->spk_want = want;
+	ret = sun50i_h713_spk_apply_locked(scodec);
+	mutex_unlock(&scodec->spk_lock);
+	return ret ? ret : changed;
 }
 
+/* ── H713 speaker power: end ── */
+
 static void sun4i_codec_start_playback(struct sun4i_codec *scodec)
 {
 	/* Flush TX FIFO */
@@ -428,12 +565,10 @@
 	/* Enable DAC DRQ */
 	regmap_field_set_bits(scodec->reg_dac_fifoc,
 			      BIT(SUN4I_CODEC_DAC_FIFOC_DAC_DRQ_EN));
-	sun50i_h713_codec_pa_playback(scodec, true);
 }
 
 static void sun4i_codec_stop_playback(struct sun4i_codec *scodec)
 {
-	sun50i_h713_codec_pa_playback(scodec, false);
 	/* Disable DAC DRQ */
 	regmap_field_clear_bits(scodec->reg_dac_fifoc,
 				BIT(SUN4I_CODEC_DAC_FIFOC_DAC_DRQ_EN));
@@ -748,7 +883,10 @@
 	 */
 	clk_freq *= scodec->mod_freq_mult;
 
-	ret = clk_set_rate(scodec->clk_module, clk_freq);
+	if (scodec->spk_power)
+		ret = sun50i_h713_spk_set_rate(scodec, clk_freq);
+	else
+		ret = clk_set_rate(scodec->clk_module, clk_freq);
 	if (ret)
 		return ret;
 
@@ -2310,7 +2448,7 @@
 	unsigned int reg_adc_rxdata;	/* RX FIFO offset for DMA config */
 	bool has_reset;
 	bool playback_only;
-	bool pa_on_playback;
+	bool speaker_power;
 	u32 dma_max_burst;
 	/* Module clock multiple, when not the family default of 512x. 0 = 1x */
 	unsigned int mod_freq_mult;
@@ -2409,27 +2547,18 @@
 	{ "LINEOUT", NULL, "HP Amp" },
 };
 
-/* Keep the external amplifier off while the H713 analog path settles. */
-static int sun50i_h713_codec_spk_event(struct snd_soc_dapm_widget *w,
-				     struct snd_kcontrol *k, int event)
-{
-	struct sun4i_codec *scodec = snd_soc_card_get_drvdata(w->dapm->card);
-	unsigned long flags;
-
-	if (SND_SOC_DAPM_EVENT_ON(event))
-		msleep(700);
-
-	spin_lock_irqsave(&scodec->pa_lock, flags);
-	scodec->pa_speaker_on = !!SND_SOC_DAPM_EVENT_ON(event);
-	sun50i_h713_codec_pa_update_locked(scodec);
-	spin_unlock_irqrestore(&scodec->pa_lock, flags);
-	return 0;
-}
+/* The pin switch as on H616, plus the speaker power state. */
+static const struct snd_kcontrol_new sun50i_h713_card_controls[] = {
+	SOC_DAPM_PIN_SWITCH("Speaker"),
+	SOC_SINGLE_BOOL_EXT("Speaker Power", 0, sun50i_h713_spk_power_get,
+			    sun50i_h713_spk_power_put),
+};
 
 static const struct snd_soc_dapm_widget sun50i_h713_codec_card_dapm_widgets[] = {
 	SND_SOC_DAPM_HP("Headphone", NULL),
 	SND_SOC_DAPM_LINE("Line Out", NULL),
-	SND_SOC_DAPM_SPK("Speaker", sun50i_h713_codec_spk_event),
+	/* PA belongs to the speaker power state, not to this widget. */
+	SND_SOC_DAPM_SPK("Speaker", NULL),
 };
 
