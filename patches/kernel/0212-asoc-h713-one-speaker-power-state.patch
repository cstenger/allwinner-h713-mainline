 }
 
 static void sun4i_codec_remove(struct platform_device *pdev)
 {
 	struct snd_soc_card *card = platform_get_drvdata(pdev);
+	struct sun4i_codec *scodec = snd_soc_card_get_drvdata(card);
 
+	/* Down while the card still exists: the path is released through it. */
+	if (scodec->spk_power)
+		sun50i_h713_spk_block(scodec);
 	snd_soc_unregister_card(card);
 }
 
+/* Power-off and reboot: PA down well before the rails take the clock. */
+static void sun4i_codec_platform_shutdown(struct platform_device *pdev)
+{
+	struct snd_soc_card *card = platform_get_drvdata(pdev);
+	struct sun4i_codec *scodec;
+
+	if (!card)
+		return;
+	scodec = snd_soc_card_get_drvdata(card);
+	if (scodec && scodec->spk_power)
+		sun50i_h713_spk_block(scodec);
+}
+
+static int sun4i_codec_suspend(struct device *dev)
+{
+	struct snd_soc_card *card = dev_get_drvdata(dev);
+	struct sun4i_codec *scodec = snd_soc_card_get_drvdata(card);
+
+	if (scodec->spk_power)
+		sun50i_h713_spk_block(scodec);
+	return 0;
+}
+
+static int sun4i_codec_resume(struct device *dev)
+{
+	struct snd_soc_card *card = dev_get_drvdata(dev);
+	struct sun4i_codec *scodec = snd_soc_card_get_drvdata(card);
+
+	if (scodec->spk_power)
+		sun50i_h713_spk_unblock(scodec);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(sun4i_codec_pm_ops, sun4i_codec_suspend,
+				sun4i_codec_resume);
+
 static struct platform_driver sun4i_codec_driver = {
 	.driver = {
 		.name = "sun4i-codec",
 		.of_match_table = sun4i_codec_of_match,
+		.pm = pm_sleep_ptr(&sun4i_codec_pm_ops),
 	},
 	.probe = sun4i_codec_probe,
 	.remove = sun4i_codec_remove,
+	.shutdown = sun4i_codec_platform_shutdown,
 };
 module_platform_driver(sun4i_codec_driver);
 
