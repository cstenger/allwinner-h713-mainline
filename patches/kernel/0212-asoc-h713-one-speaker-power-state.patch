 };
@@ -2613,18 +2742,14 @@
 		return ret;
 	}
 
-	if (quirks->pa_on_playback) {
-		/* Trigger callbacks run in atomic context. Never use an expander. */
-		if (gpiod_cansleep(scodec->gpio_pa))
+	if (quirks->speaker_power) {
+		if (!scodec->gpio_pa)
 			return dev_err_probe(&pdev->dev, -EINVAL,
-					     "PA GPIO must be non-sleeping\n");
-		scodec->pa_on_playback = true;
-		spin_lock_init(&scodec->pa_lock);
-		INIT_DELAYED_WORK(&scodec->pa_work, sun50i_h713_codec_pa_work);
