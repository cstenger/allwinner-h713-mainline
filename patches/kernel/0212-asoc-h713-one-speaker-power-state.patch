@@ -2699,6 +2824,7 @@
 	}
 
 	snd_soc_card_set_drvdata(card, scodec);
+	scodec->card = card;
 
 	ret = snd_soc_register_card(card);
 	if (ret) {
@@ -2706,23 +2832,69 @@
 		return ret;
 	}
 
+	/* Up in the background: the analog path needs 700 ms to settle. */
+	if (scodec->spk_power)
