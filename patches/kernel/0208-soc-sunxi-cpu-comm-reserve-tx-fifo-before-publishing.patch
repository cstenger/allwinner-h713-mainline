 /*
- * sunxi_cpu_comm_send_intr_to_mips — ring the MIPS doorbell.
+ * The ARM -> MIPS FIFO holds eight words: the firmware's own msgbox send at
+ * 0x8b12199c waits while its target FIFO holds eight. A word written into a
+ * full FIFO is lost, leaving a published message the peer never reads.
+ */
+#define H713_MSGBOX_TX_FIFO_DEPTH	8
+#define H713_MSGBOX_TX_SPACE_TIMEOUT_US	(100 * USEC_PER_MSEC)
+
+/* Serializes the capacity check, publication, data write and pulse. */
+static DEFINE_SPINLOCK(msgbox_tx_lock);
+static atomic_t msgbox_tx_full = ATOMIC_INIT(0);
+module_param_cb(tx_fifo_full, &msgbox_counter_ops, &msgbox_tx_full, 0444);
+MODULE_PARM_DESC(tx_fifo_full, "sends refused before publication: ARM -> MIPS FIFO full");
+
+/*
+ * cpu_comm_msgbox_send — publish a message and ring the MIPS doorbell.
  *
  * The doorbell word is the message type and nothing else. The firmware's
  * msgbox LISR at 0x8b121698 drains the FIFO and hands the raw word to
@@ -1012,32 +1028,64 @@
  * and silently drops anything else. So a CALL is doorbell 0x00000000.
  * There is no msg_type<<16 field and no intr_type field — an earlier
  * comment here described such a packing, which this firmware does not
- * parse. @type is retained for call-site compatibility and is not sent.
+ * parse.
  *
- * @msg_type: 0=CALL, 1=RETURN, 2=CALL_ACK, 3=RETURN_ACK
- * @type:     stock intr_type; not part of the wire format, ignored
- * @value:    payload value (unused in current path)
- */
-void sunxi_cpu_comm_send_intr_to_mips(u32 msg_type, u32 type, u32 value)
-{
-	u32 raw;
+ * Only this function writes the ARM -> MIPS FIFO, always under
+ * msgbox_tx_lock, and the MIPS can only lower its count. A count below the
+ * depth observed under the lock therefore reserves room for this word.
+ * @publish, which writes the shared-memory message including its SENT flag,
+ * runs only after that reservation: a refusal leaves shared memory untouched,
+ * so the caller can unwind with nothing the peer could act on. The lock also
+ * keeps one sender's data write and TX_IRQ_EN pulse from interleaving with
+ * another's, whatever the receiver's trigger turns out to be.
+ *
+ * May sleep while waiting for room. Returns 0 once published and rung,
+ * -ENODEV if the msgbox is not mapped, or -EBUSY if no room appeared within
+ * the bound. @publish has not run in either error case.
+ */
+int cpu_comm_msgbox_send(u32 msg_type, void (*publish)(void *ctx), void *ctx)
+{
+	ktime_t deadline;
+	u32 raw = msg_type & 0x3;
+	u32 fifo;
+
+	might_sleep();
 
 	if (!msgbox_ctrl_base) {
-		pr_err("cpu_comm: msgbox not mapped, can't send intr!\n");
-		return;
+		pr_err("cpu_comm: msgbox not mapped, %s not published\n",
+		       cpu_comm_msgbox_type_name(raw));
+		return -ENODEV;
+	}
+
+	deadline = ktime_add_us(ktime_get(), H713_MSGBOX_TX_SPACE_TIMEOUT_US);
+	for (;;) {
+		spin_lock(&msgbox_tx_lock);
+		fifo = readl(msgbox_ctrl_base + H713_MSGBOX_TX_FIFO);
+		if (fifo < H713_MSGBOX_TX_FIFO_DEPTH)
+			break;
+		spin_unlock(&msgbox_tx_lock);
+
+		if (ktime_after(ktime_get(), deadline)) {
+			atomic_inc(&msgbox_tx_full);
+			pr_warn_ratelimited("cpu_comm: msgbox tx fifo full (%u), %s not published\n",
+					    fifo, cpu_comm_msgbox_type_name(raw));
+			return -EBUSY;
+		}
+		usleep_range(50, 100);
 	}
 
-	raw = msg_type & 0x3;
+	publish(ctx);
 
 	/*
-	 * Edge-triggered: MSG_DATA on its own leaves the word in the FIFO
-	 * with the receiver asleep. The TX_IRQ_EN pulse is what wakes it,
-	 * and it must follow the data write.
+	 * The data write is followed by a TX_IRQ_EN pulse. This is the
+	 * transport qualified on this board; whether the receiver needs the
+	 * edge or treats TX_IRQ_EN as a level is not settled, so it is kept.
 	 */
 	writel(raw, msgbox_ctrl_base + H713_MSGBOX_TX_DATA);
 	writel(H713_MSGBOX_TX_IRQ_BIT, msgbox_ctrl_base + H713_MSGBOX_TX_IRQ_EN);
 	udelay(10);
 	writel(0, msgbox_ctrl_base + H713_MSGBOX_TX_IRQ_EN);
+	spin_unlock(&msgbox_tx_lock);
 
 	/* A reply can only follow a send — poll fast for a while now. */
 	cpu_comm_msgbox_kick();
@@ -1045,6 +1093,7 @@
 	pr_info_ratelimited("cpu_comm: msgbox tx raw=0x%08x (%s), fifo now %u\n",
 			    raw, cpu_comm_msgbox_type_name(raw),
 			    readl(msgbox_ctrl_base + H713_MSGBOX_TX_FIFO));
+	return 0;
 }
 
