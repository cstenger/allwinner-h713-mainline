 	}
 
-	SendAckLow((void *)getShareSeqW(cpu, 1), FIFO_DEFAULT_CAP - 1,
-		   status, param, peer_wait);
+	acked = !SendAckLow((void *)getShareSeqW(cpu, 1), FIFO_DEFAULT_CAP - 1,
+			    status, param, peer_wait);
+	/* The return is ARM-owned once claimed, so wake its caller either way. */
