From: Christopher Stenger <chris.h.stenger@gmail.com>
Subject: [PATCH] media: cedrus: DEBUG fault-inject a spurious decode interrupt

DEBUG ONLY -- deliberately NOT in patches/kernel/series. Applies on top of
patch 0059 and exists to prove it, because the orphan it fixes cannot be
reached on demand any other way: it needs an interrupt that arrives while a
job is running and reports no status, which real hardware here does not
volunteer.

sunxi_cedrus.fault_irq_none=N makes the next N decode interrupts take the
"not ours" branch.

This injects into the DRIVER'S OWN LOGIC rather than into the hardware, which
is exactly why it works where patch 0058 did not. 0058 tried to stall the
engine by over-programming VE_DEC_H265_BITS_LEN and the engine decoded every
frame anyway, because that register is an upper bound rather than a promise
the hardware waits on. Here the branch is taken because the driver is told
to take it, so the experiment cannot silently fail to fire.

Signed-off-by: Christopher Stenger <chris.h.stenger@gmail.com>
---
--- a/drivers/staging/media/sunxi/cedrus/cedrus_hw.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_hw.c
@@ -19,6 +19,7 @@
 #include <linux/dma-mapping.h>
 #include <linux/interrupt.h>
 #include <linux/clk.h>
+#include <linux/moduleparam.h>
 #include <linux/pm_runtime.h>
 #include <linux/regmap.h>
 #include <linux/reset.h>
@@ -128,6 +129,23 @@
 	}
 }
 
+/*
+ * DEBUG ONLY -- fault injection for the job-orphan path in cedrus_irq()
+ * (sunxi_cedrus.fault_irq_none). Set it to N and the next N interrupts are
+ * treated as "not ours", exactly as a spurious interrupt or a status register
+ * read of zero would be.
+ *
+ * This one injects into the DRIVER'S OWN LOGIC rather than into the hardware,
+ * which is why it works where patch 0058 did not: 0058 tried to make the
+ * engine stall by over-programming VE_DEC_H265_BITS_LEN and the engine simply
+ * ignored it, because that register is an upper bound. There is no such
+ * uncertainty here -- the branch is taken because we say so.
+ */
+static int fault_irq_none;
+module_param(fault_irq_none, int, 0644);
+MODULE_PARM_DESC(fault_irq_none,
+		 "DEBUG: treat the next N decode interrupts as not ours");
+
 static irqreturn_t cedrus_irq(int irq, void *data)
 {
 	struct cedrus_dev *dev = data;
@@ -161,6 +179,14 @@
 	 * stay armed on every path that does not finish the job here.
 	 */
 	status = ctx->current_codec->irq_status(ctx);
+
+	if (fault_irq_none > 0) {
+		fault_irq_none--;
+		v4l2_info(&dev->v4l2_dev,
+			  "FAULT INJECTION: pretending this interrupt is not ours\n");
+		status = CEDRUS_IRQ_NONE;
+	}
+
 	if (status == CEDRUS_IRQ_NONE)
 		return IRQ_NONE;
 
