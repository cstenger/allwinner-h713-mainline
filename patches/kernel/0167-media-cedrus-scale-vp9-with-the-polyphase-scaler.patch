 }
 
-/* The group-7 datapath is validated on H713, not on its H6 DT fallback. */
+/*
+ * The group-7 datapath is validated on H713, not on its H6 DT fallback.
+ * VP9 runs on the H.265 engine and feeds the scaler the same way.
+ */
 static inline bool cedrus_can_scale(struct cedrus_ctx *ctx)
 {
 	return (ctx->dev->capabilities & CEDRUS_CAPABILITY_POLYPHASE) &&
 	       (ctx->src_fmt.pixelformat == V4L2_PIX_FMT_H264_SLICE ||
-		ctx->src_fmt.pixelformat == V4L2_PIX_FMT_HEVC_SLICE);
+		ctx->src_fmt.pixelformat == V4L2_PIX_FMT_HEVC_SLICE ||
+		ctx->src_fmt.pixelformat == V4L2_PIX_FMT_VP9_FRAME);
 }
 
 /*
--- a/drivers/staging/media/sunxi/cedrus/cedrus_hw.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_hw.c
@@ -283,6 +283,39 @@
 
 }
 
+/*
+ * VP9 runs on the H.265 engine, and its secondary output is the same three
+ * registers: ctrl at +0x50, luma and chroma at +0x54/+0x58 shifted right by 8,
+ * enabled by bit 9 of the engine's func_ctrl. Stock's 4K VP9 playback
+ * (cedarc's scaler open, 3840x2160 -> 1920x1080) programs exactly that,
+ * func_ctrl 0x207, and Jernej Skrabec's H6 VP9 P010 support drives the same
+ * bit and addresses. Two differences from H.265:
+ *
+ *  - +0x80 is not H.265's LOW_ADDR here, and stock leaves it 0. There is
+ *    nowhere for the chroma address's low byte to go, so the chroma base
+ *    must be 256-byte aligned; cedrus_prepare_capture_format() sees to it.
+ *  - cedrus_vp9_setup() has already written func_ctrl, including the DDR
+ *    consistency bit the vendor sets for one width band. Add bit 9 to it
+ *    rather than rebuilding it.
+ */
+static void cedrus_sd_program_vp9(struct cedrus_ctx *ctx, dma_addr_t luma,
+				  dma_addr_t chroma)
+{
+	struct cedrus_dev *dev = ctx->dev;
+
+	cedrus_write(dev, VE_DEC_H265_SDRT_LUMA_ADDR,
+		     (u32)(luma >> VE_DEC_H265_SDRT_ADDR_SHIFT));
+	cedrus_write(dev, VE_DEC_H265_SDRT_CHROMA_ADDR,
+		     (u32)(chroma >> VE_DEC_H265_SDRT_ADDR_SHIFT));
+
+	/* No power-of-two shift: TOP1 does all of the scaling, as for H.265. */
+	cedrus_write(dev, VE_DEC_H265_SDRT_CTRL, 0);
+
+	cedrus_write(dev, VE_DEC_H265_CTRL,
+		     cedrus_read(dev, VE_DEC_H265_CTRL) |
+		     VE_DEC_H265_CTRL_ROTATE_SCALE_OUT_EN);
+}
+
 void cedrus_sd_program(struct cedrus_ctx *ctx, struct vb2_buffer *dst)
 {
 	struct cedrus_dev *dev = ctx->dev;
@@ -310,6 +343,8 @@
 
 	if (ctx->src_fmt.pixelformat == V4L2_PIX_FMT_HEVC_SLICE) {
 		cedrus_sd_program_h265(ctx, luma, chroma);
+	} else if (ctx->src_fmt.pixelformat == V4L2_PIX_FMT_VP9_FRAME) {
+		cedrus_sd_program_vp9(ctx, luma, chroma);
 	} else {
 		cedrus_write(dev, VE_H264_SDROT_LUMA_ADDR, (u32)luma);
 		cedrus_write(dev, VE_H264_SDROT_CHROMA_ADDR, (u32)chroma);
