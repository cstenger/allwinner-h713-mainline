@@ -2269,6 +2361,30 @@
 	if (!host->cfg->supports_hs400)
 		mmc->caps2 &= ~MMC_CAP2_HS400;
 
+	/*
+	 * Debug knobs: lower the advertised UHS ceiling and/or the maximum
+	 * clock without rebuilding, so one kernel can A/B the H713 SDIO link.
+	 */
+	if (host->cfg->v5p3x && h713_uhs >= 0) {
+		u32 clear = 0;
+
+		if (h713_uhs < 104)
+			clear |= MMC_CAP_UHS_SDR104;
