# DRAM bring-up aid (LPDDR3 projector, Phase 3 of docs/lpddr3-bringup-plan.md).
# Boot with memtest=N: before the page allocator takes over, the kernel writes
# and checks N patterns over all free memory and reserves any bad range it
# finds ("... bad mem addr ... reserved"). Inert without the parameter.
CONFIG_MEMTEST=y
