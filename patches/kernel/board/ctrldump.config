# Kernel that prints the HEVC controls cedrus receives -- patch 0056.
#
#   echo 0056-media-cedrus-DEBUG-dump-hevc-controls.patch >> patches/kernel/series
#   KERNEL_CONFIG=ctrldump build/build.sh kernel
#     -> build/out/h713-kernel-ctrldump.fit
#
# DEBUG ONLY. 0056 must not stay in `series`; it prints several lines per
# decoded slice, which is far too loud for anything but this experiment.
#
# Changes no config symbol, and deliberately leaves CONFIG_LOCALVERSION empty
# so uname -r stays 6.18.38 and /lib/modules/6.18.38 -- including the
# out-of-tree aic8800 WiFi/BT modules -- still loads. Without that the network
# goes away, and the whole point here is to run two userspace clients and diff
# their output over ssh.
CONFIG_LOCALVERSION=""
