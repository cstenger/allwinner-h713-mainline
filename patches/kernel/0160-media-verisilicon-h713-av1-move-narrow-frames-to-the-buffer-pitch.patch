--- a/drivers/media/platform/verisilicon/hantro_v4l2.c
+++ b/drivers/media/platform/verisilicon/hantro_v4l2.c
@@ -1017,10 +1017,54 @@
 	return 0;
 }
 
+/*
+ * Move a picture written at restride_pitch to the CAPTURE format's layout:
+ * luma rows from the top of the plane, chroma rows from the chroma base the
+ * core was given (bytesperline x height). The written pitch is the smaller,
+ * so going from the last row up never overwrites a row not yet moved.
+ */
+static void hantro_buf_finish(struct vb2_buffer *vb)
+{
+	struct hantro_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+	struct hantro_decoded_buffer *buf;
+	u32 pitch, bpl, rows, chroma_rows;
+	u8 *luma, *chroma;
+	int y;
+
+	if (V4L2_TYPE_IS_OUTPUT(vb->vb2_queue->type))
+		return;
+
+	buf = vb2_to_hantro_decoded_buf(vb);
+	pitch = buf->restride_pitch;
+	rows = buf->restride_rows;
+	buf->restride_pitch = 0;
+	if (!pitch || vb->state != VB2_BUF_STATE_DONE)
+		return;
+
+	bpl = ctx->dst_fmt.plane_fmt[0].bytesperline;
+	if (pitch >= bpl || rows > ctx->dst_fmt.height)
+		return;
+
+	luma = vb2_plane_vaddr(vb, 0);
+	if (!luma) {
+		dev_warn_ratelimited(ctx->dev->dev,
+				     "cannot map buffer %u to restride it\n", vb->index);
+		return;
+	}
+	chroma = luma + bpl * ctx->dst_fmt.height;
+	chroma_rows = (rows + 1) / 2;
+
+	for (y = rows - 1; y > 0; y--)
+		memmove(luma + y * bpl, luma + y * pitch, pitch);
+	for (y = chroma_rows - 1; y > 0; y--)
+		memmove(chroma + y * bpl, chroma + y * pitch, pitch);
+}
+
 const struct vb2_ops hantro_queue_ops = {
 	.queue_setup = hantro_queue_setup,
 	.buf_prepare = hantro_buf_prepare,
 	.buf_queue = hantro_buf_queue,
+	.buf_finish = hantro_buf_finish,
 	.buf_out_validate = hantro_buf_out_validate,
 	.buf_request_complete = hantro_buf_request_complete,
 	.start_streaming = hantro_start_streaming,
