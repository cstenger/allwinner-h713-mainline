+static void h713_proc_rmw(struct h713_afbd *h, u32 off, u32 mask, u32 val)
+{
+	u32 reg = readl(h->proc_regs + off);
+
+	writel((reg & ~mask) | (val & mask), h->proc_regs + off);
+}
+
+static void h713_proc_save(struct h713_afbd *h)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(h713_proc_saved_regs); i++)
+		h->proc_saved[i] = readl(h->proc_regs +
+					 h713_proc_saved_regs[i]);
+}
+
+static void h713_proc_restore(struct h713_afbd *h)
+{
+	unsigned int i;
+
+	if (!h->proc_engaged)
+		return;
+
+	for (i = 0; i < ARRAY_SIZE(h713_proc_saved_regs); i++)
+		writel(h->proc_saved[i],
+		       h->proc_regs + h713_proc_saved_regs[i]);
+	h->proc_engaged = false;
+}
+
+/*
+ * Magnify in_w x in_h up to out_w x out_h.
+ *
+ * The ratio is a source step in 16.16: unity walks the source one pixel per
+ * output pixel, and anything below unity magnifies by 1/ratio. Phase is the
+ * initial sample position, and the two axes shift it differently -- H by two
+ * bits, V by one -- which is the firmware's own arithmetic, not a guess.
+ *
+ * PROC_IN_WIN is the register this whole route turned on. Left at the panel
+ * size while the ratio says magnify, the block confines its output to a
+ * hard-edged rectangle with flat grey around it, which is what every earlier
+ * magnification attempt saw and misread as a broken scaler.
+ */
+static void h713_proc_configure(struct h713_afbd *h,
+				unsigned int in_w, unsigned int in_h,
+				unsigned int out_w, unsigned int out_h)
+{
+	u32 ratio_h = ((u32)in_w << 16) / out_w;
+	u32 ratio_v = ((u32)in_h << 16) / out_h;
+
+	h713_proc_rmw(h, PROC_IN_WIN, ~0u, (in_w << 16) | in_h);
+	h713_proc_rmw(h, PROC_OUT_W, PROC_FIELD16_MASK, out_w);
+	h713_proc_rmw(h, PROC_OUT_H, PROC_FIELD16_MASK, out_h);
+	h713_proc_rmw(h, PROC_RATIO_H, PROC_RATIO_MASK, ratio_h);
+	h713_proc_rmw(h, PROC_RATIO_V, PROC_RATIO_MASK, ratio_v);
+	h713_proc_rmw(h, PROC_PHASE_H, PROC_PHASE_MASK,
+		      (PROC_UNITY + ratio_h) >> 2);
+	h713_proc_rmw(h, PROC_PHASE_V, PROC_PHASE_MASK,
+		      (PROC_UNITY + ratio_v) >> 1);
+
+	/* Engage last, once the geometry it will act on is already in place. */
+	h713_proc_rmw(h, PROC_BYPASS, PROC_BYPASS_BIT, 0);
+	h->proc_engaged = true;
+
+	drm_dbg_kms(&h->drm,
+		    "proc: %ux%u -> %ux%u, ratio %#x/%#x, phase %#x/%#x\n",
+		    in_w, in_h, out_w, out_h, ratio_h, ratio_v,
+		    (u32)(((PROC_UNITY + ratio_h) >> 2) & PROC_PHASE_MASK),
+		    (u32)(((PROC_UNITY + ratio_v) >> 1) & PROC_PHASE_MASK));
+}
