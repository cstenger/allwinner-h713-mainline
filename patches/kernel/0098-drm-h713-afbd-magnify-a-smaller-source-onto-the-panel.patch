 #define H713_VIDEO_GAIN		0x144c0000
 #define H713_VIDEO_SELECTOR	0x39000000
 
+/*
+ * Proc upscaler, instance 0 of four at 0x100 stride. Two independent axes.
+ * The block MAGNIFIES by 1/ratio and cannot shrink: ProcWinNode::CalcScaleRatio
+ * in the MIPS firmware only ever yields <= unity, the field clamps at unity,
+ * and a sweep of above-unity ratios was pixel-for-pixel identical to bypass.
+ * The firmware's own name for the stages is proc-vs_upscaler.
+ *
+ * Every one of these registers carries live upper bits that belong to
+ * something else (PROC_RATIO_H reads 0x43010000, PROC_PHASE_H reads
+ * 0x0F008000), so each field is read-modify-written. A bare store clobbers
+ * state we do not own and have never decoded.
+ */
+#define PROC_INSTANCE_STRIDE	0x100
+#define PROC_PHASE_H		0x00	/* [15:0] */
+#define PROC_RATIO_H		0x08	/* [21:0], 16.16, unity 0x10000 */
+#define PROC_BYPASS		0x14	/* bit 27: 1 = pass through */
+#define PROC_OUT_W		0x2c	/* [15:0] */
+#define PROC_OUT_H		0x30	/* [15:0] */
+#define PROC_IN_WIN		0x34	/* (w << 16) | h */
+#define PROC_PHASE_V		0x38	/* [15:0] */
+#define PROC_RATIO_V		0x3c	/* [21:0] */
+
+/*
+ * DRM expresses plane scale as SOURCE over DESTINATION in 16.16, so a
+ * magnifying plane wants values BELOW DRM_PLANE_NO_SCALING, not above:
+ * 960 -> 1280 is (960 << 16) / 1280 = 0xC000. The bound that forbids
+ * shrinking is therefore the MAXIMUM, and the magnification limit is the
+ * MINIMUM. Getting this backwards rejects every source except one exactly
+ * the size of the panel, with -ERANGE from the helper rather than from here.
+ *
+ * 4x is the largest magnification with a measurement behind it: a ratio of
+ * 0x4000 produced 4.17x against 4.00x commanded. The field itself would go
+ * further; nothing has looked at what the line buffers do there.
+ */
+#define H713_VIDEO_MIN_SCALE	(DRM_PLANE_NO_SCALING / 4)
+
+#define PROC_BYPASS_BIT		BIT(27)
+#define PROC_RATIO_MASK		GENMASK(21, 0)
+#define PROC_PHASE_MASK		GENMASK(15, 0)
+#define PROC_FIELD16_MASK	GENMASK(15, 0)
+#define PROC_UNITY		0x10000u
+
+/* Registers saved at probe so the block can be handed back untouched. */
+static const u16 h713_proc_saved_regs[] = {
+	PROC_PHASE_H, PROC_RATIO_H, PROC_BYPASS, PROC_OUT_W,
+	PROC_OUT_H, PROC_IN_WIN, PROC_PHASE_V, PROC_RATIO_V,
+};
+
 /* The four queue slots are 4 bytes apart in each address ring. */
 #define H713_VIDEO_SLOTS	4
 
