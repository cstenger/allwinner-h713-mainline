-		if (elog_ctl)
-			iounmap(elog_ctl);
+		}
 	}
 
 	/* Create proc entries */
--- a/drivers/soc/sunxi/cpu_comm/cpu_comm_proto.c
+++ b/drivers/soc/sunxi/cpu_comm/cpu_comm_proto.c
@@ -22,7 +22,8 @@
 /*
  * Firmware channel to address CALLs to. Read a live row out of the
  * channel table (U-Boot: `h713_disp commdev`; from Linux the table is at
- * *(0x4b22efe4) + 0xa8, 16 rows of 48 bytes, key 0xffffffff = free).
+ * *(dev_ptr) + 0xa8, 16 rows of 48 bytes, key 0xffffffff = free, with
+ * dev_ptr taken from the identified firmware build below).
  * Zero pid keeps the pre-existing behaviour.
  */
 static unsigned int cc_channel_pid;
@@ -41,7 +42,7 @@
  * The table is firmware-owned, so read it rather than be told about it.
  *
  * Layout, same as U-Boot's `h713_disp commdev`:
- *   *(0x8b22efe4)          -> pcpu_comm_dev (a KSEG pointer)
+ *   *(dev_ptr)             -> pcpu_comm_dev (a KSEG pointer)
  *   dev + 0xa8             -> 16 rows of 48 bytes
  *   row +0x00 >> 16        -> chan
  *   row +0x08              -> pid
@@ -54,16 +55,64 @@
  * ══════════════════════════════════════════════════════════════
  */
 
-#define CC_FW_DEV_PTR_MIPS	0x8b22efe4u
-#define CC_FW_SELFTEST_MIPS	0x8b1227b4u	/* getCurCPUID: jr ra; li v0,1 */
-#define CC_FW_SELFTEST_W0	0x03e00008u
-#define CC_FW_SELFTEST_W1	0x24020001u
+#define CC_FW_SELFTEST_W0	0x03e00008u	/* getCurCPUID: jr ra */
+#define CC_FW_SELFTEST_W1	0x24020001u	/*              li v0,1 */
 #define CC_FW_CHAN_OFF		0xa8u
 #define CC_FW_CHAN_STRIDE	48u
 #define CC_FW_CHAN_SLOTS	16u
 #define CC_CHAN_FREE		0xffffffffu
 
-static phys_addr_t cc_kseg_to_phys(u32 kseg)
+/*
+ * ══════════════════════════════════════════════════════════════
+ * Display firmware identity
+ *
+ * The A1 bench board runs display.bin 4380f1b3...; the V2 projector runs
+ * its native 16c74a28.... They are one source relinked: code slides by a
+ * few hundred bytes and data by a different amount, so every address this
+ * driver reads out of the firmware is build-specific. Each build below
+ * was mapped from A1 by matching the code that uses each address
+ * (tools/mips/map-fw-pins.py; every A1 reference agrees) and checked
+ * against the live V2.
+ *
+ * A build is recognised by the firmware's own code, not by the board:
+ *   cpuid    getCurCPUID, `jr ra; li v0,1` -- also the reader self-test
+ *   dev_ref  `lui v0,0x8b23; lw a0,lo(v0)` loading the dev_ptr global
+ *   elog_ref `lui v0,0x8b49; sb zero,lo(v0)`, `elog -m sync` storing the
+ *            elog mode byte
+ * All three must hold, and each ref must form its own global. A firmware
+ * that matches no entry is unknown: nothing is read from its data.
+ *
+ * elog (display_cfg.xml elog_init_setting): mode 0 sync, 1 async, 2 buf.
+ * Only buf mode fills the 2 MiB ring at elog_buf: buf_en gates it and
+ * buf_wp is the write offset, wrapping to 0 at 2 MiB.
+ * ══════════════════════════════════════════════════════════════
+ */
+static const struct cc_fw_build cc_fw_builds[] = {
+	{
+		.name		= "A1 display.bin 4380f1b3",
+		.cpuid		= 0x8b1227b4,
+		.dev_ref	= { 0x8b11e7a0, 0x3c028b23, 0x8c44efe4 },
+		.dev_ptr	= 0x8b22efe4,
+		.elog_ref	= { 0x8b151c7c, 0x3c028b49, 0xa040beaf },
+		.elog_mode	= 0x8b48beaf,
+		.elog_buf_en	= 0x8b48c2c1,
+		.elog_buf_wp	= 0x8b48c2cc,
+		.elog_buf	= 0x8b28bdb0,
+	},
+	{
+		.name		= "V2 display.bin 16c74a28",
+		.cpuid		= 0x8b122688,
+		.dev_ref	= { 0x8b11e674, 0x3c028b23, 0x8c44f1f4 },
+		.dev_ptr	= 0x8b22f1f4,
+		.elog_ref	= { 0x8b15139c, 0x3c028b49, 0xa040be9b },
+		.elog_mode	= 0x8b48be9b,
+		.elog_buf_en	= 0x8b48c2ad,
+		.elog_buf_wp	= 0x8b48c2b8,
+		.elog_buf	= 0x8b28bd9c,
+	},
+};
+
+phys_addr_t cc_kseg_to_phys(u32 kseg)
 {
 	return (phys_addr_t)(kseg & 0x1fffffff) + 0x40000000;
 }
@@ -74,7 +123,7 @@
 }
 
 /* Read one u32 of firmware memory named by its MIPS KSEG address. */
-static int cc_fw_read(u32 kseg, u32 *out)
+int cc_fw_read(u32 kseg, u32 *out)
 {
 	void __iomem *p = ioremap(cc_kseg_to_phys(kseg), sizeof(u32));
 
@@ -85,10 +134,105 @@
 	return 0;
 }
 
+int cc_fw_readb(u32 kseg, u8 *out)
+{
+	u32 w;
+	int ret = cc_fw_read(kseg & ~3u, &w);
+
+	if (!ret)
+		*out = w >> (8 * (kseg & 3));
+	return ret;
+}
+
+/* The address `lui rX,hi; <op> rY,lo(rX)` forms. */
+static u32 cc_fw_pair_addr(u32 lui, u32 op)
+{
+	return (lui << 16) + (u32)(s32)(s16)(op & 0xffff);
+}
+
+static bool cc_fw_site_matches(const struct cc_fw_site *s, u32 global)
+{
+	u32 w0, w1;
+
+	if (cc_fw_pair_addr(s->w0, s->w1) != global)
+		return false;	/* table typo: the site must form its own global */
+	if (cc_fw_read(s->addr, &w0) || cc_fw_read(s->addr + 4, &w1))
+		return false;
+	return w0 == s->w0 && w1 == s->w1;
+}
+
+static bool cc_fw_build_matches(const struct cc_fw_build *b)
+{
+	u32 w0, w1;
+
+	if (cc_fw_read(b->cpuid, &w0) || cc_fw_read(b->cpuid + 4, &w1))
+		return false;
+	return w0 == CC_FW_SELFTEST_W0 && w1 == CC_FW_SELFTEST_W1 &&
+	       cc_fw_site_matches(&b->dev_ref, b->dev_ptr) &&
+	       cc_fw_site_matches(&b->elog_ref, b->elog_mode);
+}
+
+/*
+ * Which display firmware is loaded, or NULL if none we know. Firmware
+ * code does not change after U-Boot loads it, so a match is cached; a
+ * miss is not, because an unloaded image can become loaded later. A miss
+ * is reported once.
+ */
+const struct cc_fw_build *cc_fw_identify(void)
+{
+	static const struct cc_fw_build *known;
+	static bool reported;
+	const struct cc_fw_build *hit = NULL;
+	unsigned int i;
+
+	if (known)
+		return known;
+
+	for (i = 0; i < ARRAY_SIZE(cc_fw_builds); i++) {
+		if (!cc_fw_build_matches(&cc_fw_builds[i]))
+			continue;
+		if (hit) {
+			pr_err("cpu_comm: display firmware matches both %s and %s -- treating it as unknown\n",
+			       hit->name, cc_fw_builds[i].name);
+			return NULL;
+		}
+		hit = &cc_fw_builds[i];
+	}
+
+	if (!hit && reported)
+		return NULL;
+	if (!hit) {
+		/*
+		 * The reader self-test, per known build. If no getCurCPUID
+		 * reads back, the KSEG mapping is wrong or no image is loaded;
+		 * if one does but its refs do not, the build is new.
+		 */
+		for (i = 0; i < ARRAY_SIZE(cc_fw_builds); i++) {
+			const struct cc_fw_build *b = &cc_fw_builds[i];
+			u32 w0 = 0, w1 = 0;
+
+			cc_fw_read(b->cpuid, &w0);
+			cc_fw_read(b->cpuid + 4, &w1);
+			pr_err("cpu_comm: firmware reader self-test (%s) @0x%08x: %08x %08x, expect %08x %08x\n",
+			       b->name, b->cpuid, w0, w1,
+			       CC_FW_SELFTEST_W0, CC_FW_SELFTEST_W1);
+		}
+		pr_err("cpu_comm: unknown display firmware -- not reading its data\n");
+		reported = true;
+		return NULL;
+	}
+
+	pr_info("cpu_comm: display firmware is %s (getCurCPUID 0x%08x, dev_ptr 0x%08x)\n",
+		hit->name, hit->cpuid, hit->dev_ptr);
+	known = hit;
+	return known;
+}
+
 int cc_discover_channel(void)
 {
+	const struct cc_fw_build *fw;
 	void __iomem *tbl;
-	u32 w0, w1, dev;
+	u32 dev;
 	unsigned int i;
 	int found = -1;
 
@@ -104,20 +248,18 @@
 	}
 
 	/*
-	 * Prove the reader before trusting anything it returns. These two
-	 * words are getCurCPUID and are known byte for byte; if they do not
-	 * match, the KSEG mapping is wrong and every row below is noise.
+	 * Prove the reader before trusting anything it returns. The
+	 * identity check includes getCurCPUID, known byte for byte; if no
+	 * build matches, the KSEG mapping is wrong or the firmware is one
+	 * whose dev_ptr we do not know, and every row below would be noise.
 	 */
-	if (cc_fw_read(CC_FW_SELFTEST_MIPS, &w0) ||
-	    cc_fw_read(CC_FW_SELFTEST_MIPS + 4, &w1))
-		return -EIO;
-	if (w0 != CC_FW_SELFTEST_W0 || w1 != CC_FW_SELFTEST_W1) {
-		pr_err("cpu_comm: firmware reader self-test failed (%08x %08x, expect %08x %08x) — not reading the channel table\n",
-		       w0, w1, CC_FW_SELFTEST_W0, CC_FW_SELFTEST_W1);
+	fw = cc_fw_identify();
+	if (!fw) {
+		pr_err("cpu_comm: not reading the channel table\n");
 		return -EIO;
 	}
 
-	if (cc_fw_read(CC_FW_DEV_PTR_MIPS, &dev))
+	if (cc_fw_read(fw->dev_ptr, &dev))
 		return -EIO;
 	if (!cc_kseg_valid(dev)) {
 		pr_err("cpu_comm: pcpu_comm_dev 0x%08x is not a KSEG address\n",
