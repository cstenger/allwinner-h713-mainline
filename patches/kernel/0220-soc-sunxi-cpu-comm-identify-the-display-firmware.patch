+
+		if (fw && !cc_fw_readb(fw->elog_mode, &cur_mode) &&
+		    !cc_fw_read(fw->elog_buf_wp, &wp2))
+			elog_buf = ioremap(cc_kseg_to_phys(fw->elog_buf),
+					   0x200000);
 
-			pr_info("cpu_comm: MIPS elog AFTER: mode=%u wp2=%u\n",
+		if (elog_buf) {
+			pr_info("cpu_comm: MIPS elog after init: mode %u, write offset %u\n",
 				cur_mode, wp2);
 
 			if (wp2 > 0 && wp2 <= 0x200000) {
@@ -1532,14 +1520,10 @@
 				}
 				pr_info("cpu_comm: === END MIPS ELOG ===\n");
 			} else {
-				pr_info("cpu_comm: MIPS elog Mode 2 buffer empty (wp2=%u)\n", wp2);
+				pr_info("cpu_comm: MIPS elog buf ring empty (write offset %u)\n", wp2);
 			}
-		}
-
-		if (elog_buf)
