-	 *   Mode2 write ptr: MIPS 0x8B48C2B8 → phys 0x4B48C2B8
-	 *   Mode2 buffer:    MIPS 0x8B28BD9C → phys 0x4B28BD9C (2MB)
+	 * Report the firmware's elog settings as found. Nothing is changed:
+	 * display_cfg.xml chooses them. The addresses are build-specific
+	 * (see cc_fw_identify()); the pre-2026-11-22 fixed addresses were
+	 * the V2 build's and read unrelated bytes on the A1.
 	 */
 	{
-		void __iomem *elog_ctl;
-
-		/* Map MIPS elog control region (flags + pointers) */
-		elog_ctl = ioremap(0x4B48BE00, 0x500);
-		if (elog_ctl) {
-			u8 old_mode = readb(elog_ctl + 0x9B);  /* 0x4B48BE9B */
