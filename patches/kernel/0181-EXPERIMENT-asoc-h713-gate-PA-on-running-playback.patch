From: Christopher Stenger <chris.h.stenger@gmail.com>
Subject: [PATCH EXPERIMENT] ASoC: h713: gate the external PA on running playback

The 0180 trace still shows PA high before PCM RUNNING, and five seconds after
PCM close due to DAPM power-down delay. Require both the powered Speaker widget
and a playback trigger. Enable PA 200 ms after START; STOP immediately disables
it before DRQ is cleared. Leave gain, registers and other codec variants alone.

Serialize the delayed enable and trigger/DAPM state with a spinlock, require
a non-sleeping PA GPIO, cancel pending work on stop and drain it on teardown.
This is an acoustic test candidate; click elimination is not yet established.

---
--- a/sound/soc/sunxi/sun4i-codec.c
+++ b/sound/soc/sunxi/sun4i-codec.c
@@ -20,6 +20,9 @@
 #include <linux/regmap.h>
 #include <linux/reset.h>
 #include <linux/gpio/consumer.h>
+#include <linux/spinlock.h>
+#include <linux/workqueue.h>
+#include <linux/jiffies.h>
 
 #include <sound/core.h>
 #include <sound/jack.h>
@@ -343,6 +346,14 @@
 	struct gpio_desc *gpio_pa;
 	struct gpio_desc *gpio_hp;
 
+	/* H713 PA GPIO is non-sleeping; trigger and work share this lock. */
+	bool pa_on_playback;
+	bool pa_speaker_on;
+	bool pa_playback_on;
+	unsigned long pa_ready_at;
+	spinlock_t pa_lock;
+	struct delayed_work pa_work;
+
 	/* ADC_FIFOC register is at different offset on different SoCs */
 	struct regmap_field *reg_adc_fifoc;
 	/* DAC_FIFOC register is at different offset on different SoCs */
@@ -354,6 +365,60 @@
 	struct snd_dmaengine_dai_dma_data	playback_dma_data;
 };
 
+/* Enable PA only after the running DAC has consumed its initial samples. */
+static void sun50i_h713_codec_pa_work(struct work_struct *work)
+{
+	struct sun4i_codec *scodec = container_of(to_delayed_work(work),
+						struct sun4i_codec, pa_work);
+	unsigned long flags, now;
+
+	spin_lock_irqsave(&scodec->pa_lock, flags);
+	now = jiffies;
+	if (scodec->pa_speaker_on && scodec->pa_playback_on) {
+		/* A previous callback may race with a fresh START. */
+		if (time_before(now, scodec->pa_ready_at))
+			mod_delayed_work(system_wq, &scodec->pa_work,
+					 scodec->pa_ready_at - now);
+		else
+			gpiod_set_value(scodec->gpio_pa, 1);
+	}
+	spin_unlock_irqrestore(&scodec->pa_lock, flags);
+}
+
+static void sun50i_h713_codec_pa_update_locked(struct sun4i_codec *scodec)
+{
+	if (scodec->pa_speaker_on && scodec->pa_playback_on) {
+		/* Longer than the consumer's 80 ms playback ring. */
+		scodec->pa_ready_at = jiffies + msecs_to_jiffies(200);
+		mod_delayed_work(system_wq, &scodec->pa_work,
+				 msecs_to_jiffies(200));
+	} else {
+		cancel_delayed_work(&scodec->pa_work);
+		gpiod_set_value(scodec->gpio_pa, 0);
+	}
+}
+
+static void sun50i_h713_codec_pa_playback(struct sun4i_codec *scodec, bool on)
+{
+	unsigned long flags;
+
+	if (!scodec->pa_on_playback)
+		return;
+
+	spin_lock_irqsave(&scodec->pa_lock, flags);
+	scodec->pa_playback_on = on;
+	sun50i_h713_codec_pa_update_locked(scodec);
+	spin_unlock_irqrestore(&scodec->pa_lock, flags);
+}
+
+static void sun50i_h713_codec_pa_cleanup(void *data)
+{
+	struct sun4i_codec *scodec = data;
+
+	sun50i_h713_codec_pa_playback(scodec, false);
+	cancel_delayed_work_sync(&scodec->pa_work);
+}
+
 static void sun4i_codec_start_playback(struct sun4i_codec *scodec)
 {
 	/* Flush TX FIFO */
@@ -363,10 +428,12 @@
 	/* Enable DAC DRQ */
 	regmap_field_set_bits(scodec->reg_dac_fifoc,
 			      BIT(SUN4I_CODEC_DAC_FIFOC_DAC_DRQ_EN));
+	sun50i_h713_codec_pa_playback(scodec, true);
 }
 
 static void sun4i_codec_stop_playback(struct sun4i_codec *scodec)
 {
+	sun50i_h713_codec_pa_playback(scodec, false);
 	/* Disable DAC DRQ */
 	regmap_field_clear_bits(scodec->reg_dac_fifoc,
 				BIT(SUN4I_CODEC_DAC_FIFOC_DAC_DRQ_EN));
