 /*
+ * The installation mode, at run time: write 0-3 and the panel follows at
+ * once -- every plane is re-committed with its current state, so a running
+ * client (kmssink, mpv, the console) needs no help. A warm reboot would cost
+ * the display, so this, not the command line, is how the mode changes.
+ */
+static ssize_t mirror_mode_show(struct device *dev, struct device_attribute *attr,
+				char *buf)
+{
+	struct h713_afbd *h = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%u\n", h->mirror_mode);
+}
+
+static ssize_t mirror_mode_store(struct device *dev, struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	struct h713_afbd *h = dev_get_drvdata(dev);
+	struct drm_modeset_acquire_ctx ctx;
+	struct drm_atomic_state *state;
+	unsigned int mode, old = h->mirror_mode;
+	int ret;
+
+	ret = kstrtouint(buf, 0, &mode);
+	if (ret)
+		return ret;
+	if (mode > 3)
+		return -EINVAL;
+	if (!h->mirror_ok)
+		return mode ? -EOPNOTSUPP : count;
+
+	DRM_MODESET_LOCK_ALL_BEGIN((&h->drm), ctx, 0, ret);
+	h->mirror_mode = mode;
+	state = drm_atomic_helper_duplicate_state(&h->drm, &ctx);
+	if (IS_ERR(state)) {
+		ret = PTR_ERR(state);
+	} else {
+		/* duplicate_state hands the state back without its context */
+		state->acquire_ctx = &ctx;
+		ret = drm_atomic_commit(state);
+		drm_atomic_state_put(state);
+	}
+	if (ret)
+		h->mirror_mode = old;
+	DRM_MODESET_LOCK_ALL_END((&h->drm), ctx, ret);
+	if (ret)
+		return ret;
+	drm_info(&h->drm, "installation mirror mode %u\n", mode);
+	return count;
+}
+static DEVICE_ATTR_RW(mirror_mode);
