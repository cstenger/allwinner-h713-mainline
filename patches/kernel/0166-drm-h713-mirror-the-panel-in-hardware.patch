 /*
+ * MIRROR: the projector's installation mode (rear and ceiling projection),
+ * done in display hardware as the stock firmware does it -- the GPU is not
+ * involved. Recipe: docs/reference/mirror-recipe-2026-10-06.md (static RE of
+ * display.bin, self-tested against the stock captures of all four modes);
+ * checked on the panel and with the panel histogram in
+ * docs/reference/mirror-phase1-2026-10-06.md.
+ *
+ *  - H is the panel's line reversal, lvds+0x0a0[0]. It is global: it reverses
+ *    whatever the selector feeds the panel, picture AND position, bars
+ *    included. It costs one line, so the picture must reach it one line
+ *    earlier than the window that consumes it: the video route moves
+ *    everything upstream one line up (the firmware's vde - 1: the dy-timed
+ *    fields and the overlay y), the RGB route, which has no upstream to
+ *    move, starts the panel's program window (lvds+0x0c0) one line later.
+ *    Without either, one edge row of the picture is lost (histogram).
+ *  - V is a bottom-up fetch: AFBD source 0's CTRL[3:2] = 2 with comp+0x040[3]
+ *    cleared, inside NR's hold (fw 0x8b1a43f0, source mode 2), for video;
+ *    OSD CTRL bit 3 for the RGB route (stock's ge2d_dev.ko). It flips the
+ *    picture in place and moves nothing; OSD bit 2 does nothing at all.
+ *
+ * Two inputs, combined by XOR: the installation mode (sysfs mirror_mode,
+ * default from the mirror_mode module parameter) mirrors the WHOLE screen, so
+ * clients never see it; a plane's DRM rotation property (REFLECT_X/Y,
+ * ROTATE_180) mirrors only that plane's picture inside its rectangle. Hence
+ * x is pre-mirrored for a plane REFLECT_X (the panel would move it) and y
+ * for the installation V (the fetch would not):
+ *
+ *	hflip = mode_H ^ REFLECT_X	dx = REFLECT_X ? 1280 - x - w : x
+ *	vflip = mode_V ^ REFLECT_Y	dy = mode_V    ? 720  - y - h : y
+ *
+ * The panel bit and window are shared by both routes; whichever owns the
+ * exclusive mux writes them (h713_panel_set).
+ */
+static unsigned int h713_mirror_param;
+module_param_named(mirror_mode, h713_mirror_param, uint, 0444);
+MODULE_PARM_DESC(mirror_mode,
+		 "installation mirror at boot: 0 front, 1 rear (H), 2 rear ceiling (V), 3 ceiling (H+V)");
+
+#define LVDS_PANEL_MIRROR	0x0a0	/* bit 0 = H */
+#define LVDS_PROGRAM_WIN	0x0c0	/* [31:16] height, [15:0] y */
+#define AFBD_CTRL_VFLIP		BIT(3)	/* source 0 and OSD alike: [3:2] = 2 */
+#define COMP_SRC_MODE		0x030	/* [11:10] = 3: source mode 2 */
+#define COMP_VBIT		BIT(3)	/* in NR_ENABLE: cleared for V */
+
+static void h713_plane_flips(struct h713_afbd *h, const struct drm_plane_state *s,
+			     bool *rx, bool *ry)
+{
+	unsigned int rot = drm_rotation_simplify(s->rotation, DRM_MODE_ROTATE_0 |
+						 DRM_MODE_REFLECT_X | DRM_MODE_REFLECT_Y);
+
+	*rx = rot & DRM_MODE_REFLECT_X;
+	*ry = rot & DRM_MODE_REFLECT_Y;
+}
+
+/* Panel bit and program window for the route now on the mux. */
+static void h713_panel_set(struct h713_afbd *h, bool hflip, bool rgb)
+{
+	u32 a0 = (h->panel_hw & ~BIT(0)) | hflip;
+	u32 c0 = h->panel_win_native + (rgb && hflip);
+
+	if (!h->mirror_ok)
+		return;
+	if (c0 != h->panel_win_hw) {
+		writel(c0, h->lvds_regs + LVDS_PROGRAM_WIN);
+		h->panel_win_hw = c0;
+	}
+	if (a0 != h->panel_hw) {
+		writel(a0, h->lvds_regs + LVDS_PANEL_MIRROR);
+		h->panel_hw = a0;
+	}
+}
+
+/* The RGB route's flips for this primary-plane state. */
+static void h713_rgb_flips(struct h713_afbd *h, const struct drm_plane_state *s,
+			   bool *hflip, bool *vflip)
+{
+	bool rx = false, ry = false;
+
+	*hflip = *vflip = false;
+	if (!h->mirror_ok)
+		return;
+	h713_plane_flips(h, s, &rx, &ry);
+	*hflip = (h->mirror_mode & 1) ^ rx;
+	*vflip = !!(h->mirror_mode & 2) ^ ry;
+}
