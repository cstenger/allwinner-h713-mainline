--- a/drivers/misc/sunxi_decd/decd_frame.c
+++ b/drivers/misc/sunxi_decd/decd_frame.c
@@ -711,6 +711,19 @@
 }
 
 /*
+ * auto_route: program the source geometry, enable and two-plane format byte
+ * from the submitted descriptor, instead of requiring a shell script to poke
+ * them before every run.  See dec_reg_route_nv12().
+ *
+ * Only the descriptor-format-6 -> hardware-format-3 (linear 8-bit NV12) path is
+ * hardware-verified.  Other entries come from fmt_attr_tbl column 8 and are
+ * untested, so this can be turned off to fall back to manual routing.
+ */
+static int auto_route = 1;
+module_param(auto_route, int, 0644);
+MODULE_PARM_DESC(auto_route, "program source geometry/format on submit (default 1)");
+
+/*
  * fmt_attr_tbl — IDA global at 0x81a0
  * 8 entries × 10 dwords each. Entry[0]=format_id, Entry[1]=bpp_class.
  * If entry[1]==8 → multiplier=1, else multiplier=2.
@@ -807,7 +820,39 @@
 	item->y_aux = 0;
 	item->c_addr = y_dma + c_offset;
 	item->c_aux = 0;
-	item->format_shadow = 0;
+	/*
+	 * The hardware format byte, not the descriptor's selector.  This was
+	 * hardcoded to 0 (= RGB888), which is why every trace reported format 0
+	 * while the panel was fed NV12 -- the byte was only ever traced, never
+	 * programmed, so whatever U-Boot left in 0x05600011 stayed.
+	 */
+	item->format_shadow = (i < 8) ? (u8)fmt_attr_tbl[i][8] : 0;
+
+	/*
+	 * Apply the source route once per stream rather than per frame: it is
+	 * per-stream state, and rewriting it every frame would re-commit the
+	 * config underneath a running fetch.
+	 */
+	/*
+	 * STAGE the route; do not apply it here.  frame_item_create() runs from
+	 * the submit ioctl BEFORE dec_reg_enable(), and committing the source
+	 * config via 0x05600014 before the source is enabled latches a
+	 * 2-bytes-per-pixel interpretation: the frame renders doubled side by
+	 * side in the top half (test_81).  The register values end up identical
+	 * either way, so a dump cannot see it -- only the order matters.
+	 *
+	 * docs/ge2d-plane-open-re.md records that the vendor never writes the
+	 * format selector alone; it is always accompanied by dec_reg_mux_select(),
+	 * dec_reg_top_enable() and dec_reg_enable().  The recorded ordering rule
+	 * is likewise "after dec_reg_enable()".  So the apply happens there.
+	 */
+	if (auto_route && i < 8 && stride && dec->regs && dec->regs->afbd) {
+		dec->route_w = desc->width;
+		dec->route_h = desc->height;
+		dec->route_stride = stride;
+		dec->route_format = item->format_shadow;
+		dec->route_pending = true;
+	}
 
 	/* IDA: split-field handling at desc byte 96 */
 	if (desc->split_fields) {
--- a/drivers/misc/sunxi_decd/decd_ioctl.c
+++ b/drivers/misc/sunxi_decd/decd_ioctl.c
@@ -78,6 +78,31 @@
 	}
 	dec_reg_blue_en(dec->regs, desc->blue_en);
 	dec_reg_enable(dec->regs, true);
+
+	/*
+	 * Apply the staged source route AFTER dec_reg_enable().  Committing the
+	 * config before the source is enabled latches 2 bytes/pixel and renders
+	 * the frame doubled -- see the comment in frame_item_create().
+	 */
+	if (dec->route_pending) {
+		dec->route_pending = false;
+		if ((readl(dec->regs->afbd + 0x10) & 0x3) != 0x3 ||
+		    dec->routed_w != dec->route_w ||
+		    dec->routed_h != dec->route_h ||
+		    dec->routed_stride != dec->route_stride ||
+		    dec->routed_format != dec->route_format) {
+			dec_reg_route_nv12(dec->regs, dec->route_w, dec->route_h,
+					   dec->route_stride, dec->route_format);
+			dec->routed_w = dec->route_w;
+			dec->routed_h = dec->route_h;
+			dec->routed_stride = dec->route_stride;
+			dec->routed_format = dec->route_format;
+			dev_info(dec->dev,
+				 "DECD route: %ux%u stride %u hw-format %u\n",
+				 dec->route_w, dec->route_h, dec->route_stride,
+				 dec->route_format);
+		}
+	}
 out:
 	mutex_unlock(&dec->lock);
 	return 0;
