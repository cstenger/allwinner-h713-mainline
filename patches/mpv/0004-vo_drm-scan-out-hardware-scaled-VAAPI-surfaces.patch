From e382cf2a9ea3ce10860335acdbaf2d66cb014cd5 Mon Sep 17 00:00:00 2001
From: build <build@localhost>
Date: Thu, 17 Sep 2026 13:37:47 -0700
Subject: [PATCH] vo_drm: scan out hardware-scaled VAAPI surfaces

The H713's video engine can downscale while it decodes, so a 1080p file can
arrive at the 1280x720 panel already the size of the panel. Until now mpv could
not use that, and refused the file instead: the video plane cannot scale, the
decoder produced a full-size picture, and reconfig() correctly called the
combination undisplayable.

Three things had to meet for this to work.

The VO says what it scans out. vo_drm is the only component that knows the mode,
so it publishes it on the hwdec context; a VO that composites has no business
asking a decoder to shrink anything, and leaves the field at zero.

The decoder turns that into a request, because neither side can do it alone: the
VO does not know the stream and the decoder does not know where its frames are
going, and they meet only in init_generic_hwaccel(), just before the surfaces
are allocated. What it asks for is a SIZE. A ratio would be the more natural
expression of what the hardware does, but it cannot land on the answer: VA-API
surfaces are allocated at the CODED size, so a 1080p H.264 stream is a 1920x1088
buffer, and 1088 rows and the visible 1080 do not reach 720 by the same factor.
The hardware scales each axis independently, so an exact size is expressible
where a ratio is not. libva-v4l2-request has no VA-API entry point for this, so
its driver reads the environment; setting it before av_hwframe_ctx_init() is
what makes it apply. A pool allocated under a different request is dropped,
because nothing in the existing comparison would notice -- the request changes
what the hardware writes, not the dimensions libavcodec asked for.

It also publishes the VISIBLE size, which is the other thing only the decoder
knows. The eight rows between 1080 and 1088 are encoder padding, and a scaler
fed the whole coded raster spends part of the height budget on them: the picture
comes out 0.74% short and, because encoders pad by replicating the last row, the
bottom edge of the frame is smeared to nearly twice its thickness. Told the
visible rectangle, the driver can point the hardware at the picture instead.

The VO reads the geometry back from VA-API rather than from the frame.
av_hwframe_map() cannot answer this: it copies the objects and layers out of the
VA descriptor but carries the AVFrame's own dimensions forward, so a scaled
surface arrives as 1280x720 of memory described as 1920x1080, and
drmModeAddFB2() would be told about storage that does not exist.
vaExportSurfaceHandle() reports the truth, so call it directly and keep a
reference to the surface itself; the GEM handles hold the storage, so the
exported fds close as soon as the framebuffer exists.

The geometry check is not relaxed, only re-pointed: it still demands that what
the plane shows is exactly the destination rectangle, because that is the
property whose absence cost 890,454 rejected commits. It is now compared against
what the decoder was asked to produce. A buffer smaller than the configured
rectangle abandons the direct path the same way a permanently rejected flip
does, rather than reporting the failure once per frame.

Nothing changes without a decoder that scales: the request is then 0, the
rectangle is the stream's own size, and the same file that was refused before is
refused with the same message.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 video/decode/vd_lavc.c |  80 ++++++++++++++
 video/hwdec.h          |  12 +++
 video/out/vo_drm.c     | 234 +++++++++++++++++++++++++++++++++--------
 3 files changed, 285 insertions(+), 41 deletions(-)

diff --git a/video/decode/vd_lavc.c b/video/decode/vd_lavc.c
index 3045af9917..5ab166c3d3 100644
--- a/video/decode/vd_lavc.c
+++ b/video/decode/vd_lavc.c
@@ -906,6 +906,80 @@ static void uninit_avctx(struct mp_filter *vd)
     ctx->use_hwdec = false;
 }
 
+// Tell a hardware decoder that can downscale while it decodes what size the VO
+// is going to scan out, so it can produce that size instead of a full picture
+// the display then has to shrink again.
+//
+// The decision needs both halves and they only meet here: the VO knows the
+// scanout size but not the stream, and the decoder knows the stream but not
+// where its frames are going.
+//
+// What is asked for is a size, not a ratio, because a size is what the consumer
+// is constrained by -- the H713 video plane accepts one framebuffer geometry and
+// no other. A ratio could not land on it in any case: the surfaces are allocated
+// at the CODED size, so a 1080p stream is a 1920x1088 buffer, and its 1088 rows
+// and its visible 1080 do not reach 720 by the same factor. The hardware scales
+// each axis independently, so the exact size is expressible and the ratio is
+// not. The cost is that the coded padding is scaled along with the picture
+// rather than cropped away, which is what an input crop in the VE would fix.
+//
+// v4l2-request has no VA-API entry point for this, so its driver reads the
+// environment. Set it before the frame pool is allocated -- the surfaces are
+// created by av_hwframe_ctx_init() below, and that is when the driver looks.
+// Returns whether the request changed, which invalidates any frame pool
+// allocated under the old one.
+static bool request_scanout_scale(struct mp_filter *vd)
+{
+    struct lavc_ctx *ctx = vd->priv;
+
+    if (!ctx->hwdec_devs || ctx->hwdec.pix_fmt != AV_PIX_FMT_VAAPI)
+        return false;
+
+    struct mp_hwdec_ctx *hw =
+        hwdec_devices_get_by_imgfmt_and_type(ctx->hwdec_devs, IMGFMT_VAAPI,
+                                             ctx->hwdec.lavc_device);
+    if (!hw)
+        return false;
+
+    int old_w = hw->scaled_w, old_h = hw->scaled_h;
+    hw->scaled_w = hw->scaled_h = 0;
+    unsetenv("V4L2_REQUEST_SCALE");
+    unsetenv("V4L2_REQUEST_CROP");
+
+    int vis_w = ctx->avctx->width, vis_h = ctx->avctx->height;
+    if (hw->scanout_w <= 0 || hw->scanout_h <= 0 || vis_w <= 0 || vis_h <= 0)
+        return old_w != 0;
+
+    // Only shrink. Asking for a larger picture than the stream has is not this
+    // hardware's job, and the driver would clamp it back anyway.
+    if (vis_w <= hw->scanout_w && vis_h <= hw->scanout_h)
+        return old_w != 0;
+
+    // The decoder's surfaces are allocated at the CODED size, which for H.264
+    // 1080p is 1920x1088 -- eight rows of encoder padding that are not picture.
+    // Only we know the difference, having parsed the stream, so say so: the
+    // hardware can then scale from the visible rectangle and land on an exact
+    // ratio, instead of spending part of the height budget on padding and
+    // smearing the bottom edge of the frame.
+    char visible[32];
+    snprintf(visible, sizeof(visible), "%dx%d", vis_w, vis_h);
+    setenv("V4L2_REQUEST_CROP", visible, 1);
+
+    char size[32];
+    snprintf(size, sizeof(size), "%dx%d", hw->scanout_w, hw->scanout_h);
+    if (setenv("V4L2_REQUEST_SCALE", size, 1) < 0) {
+        unsetenv("V4L2_REQUEST_CROP");
+        return old_w != 0;
+    }
+
+    hw->scaled_w = hw->scanout_w;
+    hw->scaled_h = hw->scanout_h;
+    MP_VERBOSE(ctx, "Asking the decoder to produce %s from %s visible.\n",
+               size, visible);
+
+    return hw->scaled_w != old_w || hw->scaled_h != old_h;
+}
+
 static int init_generic_hwaccel(struct mp_filter *vd, enum AVPixelFormat hw_fmt)
 {
     struct lavc_ctx *ctx = vd->priv;
@@ -942,6 +1016,12 @@ static int init_generic_hwaccel(struct mp_filter *vd, enum AVPixelFormat hw_fmt)
     if (fns && fns->refine_hwframes)
         fns->refine_hwframes(new_frames_ctx);
 
+    // A pool allocated under a different downscale holds surfaces of the wrong
+    // size, and nothing in the comparison below would notice: the ratio changes
+    // what the hardware writes, not the dimensions libavcodec asked for.
+    if (request_scanout_scale(vd))
+        av_buffer_unref(&ctx->cached_hw_frames_ctx);
+
     // We might be able to reuse a previously allocated frame pool.
     if (ctx->cached_hw_frames_ctx) {
         AVHWFramesContext *old_fctx = (void *)ctx->cached_hw_frames_ctx->data;
diff --git a/video/hwdec.h b/video/hwdec.h
index c83d20783d..13d04b4e00 100644
--- a/video/hwdec.h
+++ b/video/hwdec.h
@@ -45,6 +45,18 @@ struct mp_hwdec_ctx {
     // The libavutil hwconfig to be used when querying constraints for the
     // conversion filter. Can be NULL if no special config is required.
     void *conversion_config;
+
+    // Size this VO scans out hardware frames at directly, or 0 if it does not
+    // scan them out at all. A decoder whose hardware can downscale while it
+    // decodes uses this to produce the displayed size in the first place,
+    // rather than a full-size picture the display has to shrink again.
+    int scanout_w, scanout_h;
+
+    // The output size the decoder actually asked its hardware for, or 0 if it
+    // asked for nothing. Written back by the decoder: a scaled buffer no longer
+    // has the frame's dimensions, and this is how the VO knows what it is
+    // really going to be handed.
+    int scaled_w, scaled_h;
 };
 
 // Used to communicate hardware decoder device handles from VO to video decoder.
diff --git a/video/out/vo_drm.c b/video/out/vo_drm.c
index e4d20f7e23..36bf267b0c 100644
--- a/video/out/vo_drm.c
+++ b/video/out/vo_drm.c
@@ -38,6 +38,11 @@
 #include "video/fmt-conversion.h"
 #include "video/hwdec.h"
 #include "video/mp_image.h"
+#if HAVE_VAAPI
+#include <va/va_drmcommon.h>
+#include <libavutil/hwcontext_vaapi.h>
+#include "video/vaapi.h"
+#endif
 #include "video/out/present_sync.h"
 #include "video/sws_utils.h"
 #include "vo.h"
@@ -83,6 +88,9 @@ struct priv {
     bool prime_mode;
     int prime_flip_fails;
     bool prime_broken;
+    // The rectangle of the decoded buffer the plane shows, at its top-left
+    // corner. Smaller than the stream when the decoder downscaled for us.
+    int prime_src_w, prime_src_h;
 
 #if HAVE_VAAPI
     struct mp_hwdec_ctx vaapi_ctx;
@@ -128,36 +136,94 @@ static void disable_video_plane(struct vo *vo)
     drmModeAtomicFree(request);
 }
 
-static struct mp_image *map_to_drmprime(struct vo *vo, struct mp_image *src)
+#if HAVE_VAAPI
+// Export a VA surface's dma-bufs together with the geometry they actually have.
+//
+// av_hwframe_map() cannot answer the second half. It copies the objects and
+// layers out of the VA descriptor but carries the AVFrame's own width and
+// height forward, and a decoder that scaled while it decoded produces a buffer
+// smaller than the frame claims -- 1280x726 of memory described as 1920x1080.
+// A framebuffer built from that pair describes storage that does not exist.
+// vaExportSurfaceHandle is the only place the truth appears, so ask it directly.
+//
+// On success the caller owns the object fds and must close them once the
+// framebuffer holds its own reference to the storage.
+static bool export_vaapi_surface(struct vo *vo, struct mp_image *src,
+                                 AVDRMFrameDescriptor *desc,
+                                 int *width, int *height)
 {
-    if (src->imgfmt == IMGFMT_DRMPRIME)
-        return mp_image_new_ref(src);
-    if (src->imgfmt != IMGFMT_VAAPI)
-        return NULL;
+    struct priv *p = vo->priv;
+    AVHWDeviceContext *dev = (void *)p->vaapi_ctx.av_device_ref->data;
+    AVVAAPIDeviceContext *vactx = dev->hwctx;
+    VASurfaceID id = va_surface_id(src);
+    VADRMPRIMESurfaceDescriptor va = {0};
 
-    AVFrame *src_frame = mp_image_to_av_frame(src);
-    AVFrame *dst_frame = av_frame_alloc();
-    struct mp_image *dst = NULL;
-    if (!src_frame || !dst_frame)
-        goto done;
+    if (id == VA_INVALID_ID) {
+        MP_ERR(vo, "VAAPI frame carries no surface\n");
+        return false;
+    }
 
-    dst_frame->format = AV_PIX_FMT_DRM_PRIME;
-    int ret = av_hwframe_map(dst_frame, src_frame,
-                             AV_HWFRAME_MAP_READ | AV_HWFRAME_MAP_DIRECT);
-    if (ret < 0) {
-        MP_ERR(vo, "Failed to export VAAPI frame as DRM PRIME: %s\n",
-               av_err2str(ret));
-        goto done;
+    // Exporting does not wait for the decoder to finish writing the surface.
+    VAStatus status = vaSyncSurface(vactx->display, id);
+    if (status != VA_STATUS_SUCCESS) {
+        MP_ERR(vo, "Failed to sync VAAPI surface: %s\n", vaErrorStr(status));
+        return false;
+    }
+
+    status = vaExportSurfaceHandle(vactx->display, id,
+                                   VA_SURFACE_ATTRIB_MEM_TYPE_DRM_PRIME_2,
+                                   VA_EXPORT_SURFACE_READ_ONLY |
+                                   VA_EXPORT_SURFACE_COMPOSED_LAYERS, &va);
+    if (status != VA_STATUS_SUCCESS) {
+        MP_ERR(vo, "Failed to export VAAPI surface: %s\n", vaErrorStr(status));
+        return false;
     }
 
-    dst = mp_image_from_av_frame(dst_frame);
-    if (dst)
-        mp_image_copy_attributes(dst, src);
+    if (va.num_layers < 1 || va.num_objects < 1 ||
+        va.num_objects > AV_DRM_MAX_PLANES ||
+        va.layers[0].num_planes > AV_DRM_MAX_PLANES)
+    {
+        MP_ERR(vo, "VAAPI surface exported %u objects in %u layers, which this "
+                   "path cannot describe\n", va.num_objects, va.num_layers);
+        for (uint32_t i = 0; i < va.num_objects; i++)
+            close(va.objects[i].fd);
+        return false;
+    }
 
-done:
-    av_frame_free(&src_frame);
-    av_frame_free(&dst_frame);
-    return dst;
+    *desc = (AVDRMFrameDescriptor){
+        .nb_objects = va.num_objects,
+        .nb_layers = 1,
+    };
+
+    for (uint32_t i = 0; i < va.num_objects; i++) {
+        desc->objects[i] = (AVDRMObjectDescriptor){
+            .fd = va.objects[i].fd,
+            .size = va.objects[i].size,
+            .format_modifier = va.objects[i].drm_format_modifier,
+        };
+    }
+
+    desc->layers[0].format = va.layers[0].drm_format;
+    desc->layers[0].nb_planes = va.layers[0].num_planes;
+    for (uint32_t i = 0; i < va.layers[0].num_planes; i++) {
+        desc->layers[0].planes[i] = (AVDRMPlaneDescriptor){
+            .object_index = va.layers[0].object_index[i],
+            .offset = va.layers[0].offset[i],
+            .pitch = va.layers[0].pitch[i],
+        };
+    }
+
+    *width = va.width;
+    *height = va.height;
+    return true;
+}
+#endif
+
+static struct mp_image *map_to_drmprime(struct vo *vo, struct mp_image *src)
+{
+    if (src->imgfmt == IMGFMT_DRMPRIME)
+        return mp_image_new_ref(src);
+    return NULL;
 }
 
 static void destroy_framebuffer(int fd, struct framebuffer *fb)
@@ -293,6 +359,18 @@ static int reconfig(struct vo *vo, struct mp_image_params *params)
             MP_ERR(vo, "DRM PRIME plane requires uncropped, unrotated fullscreen video\n");
             return -1;
         }
+        // What the plane will show from the decoded buffer. When the decoder
+        // was asked to downscale, that is the size it was asked for and no
+        // longer the frame's own.
+        p->prime_src_w = mp_rect_w(p->src);
+        p->prime_src_h = mp_rect_h(p->src);
+#if HAVE_VAAPI
+        if (p->vaapi_ctx.scaled_w > 0 && p->vaapi_ctx.scaled_h > 0) {
+            p->prime_src_w = p->vaapi_ctx.scaled_w;
+            p->prime_src_h = p->vaapi_ctx.scaled_h;
+        }
+#endif
+
         // The tests above establish "uncropped" and "fullscreen" but NOT that
         // the two are the same size, so any video whose resolution differs from
         // the mode passed them and asked the plane to scale. A plane that
@@ -300,11 +378,15 @@ static int reconfig(struct vo *vo, struct mp_image_params *params)
         // failed flip is not fatal the player then retries forever without
         // advancing -- observed at 890,454 failures on one 1080p file, which
         // wedged the display hardware.
-        if (mp_rect_w(p->src) != mp_rect_w(p->dst) ||
-            mp_rect_h(p->src) != mp_rect_h(p->dst)) {
+        //
+        // What has changed is where the two can now agree: a decoder that
+        // scaled has already produced the displayed size, so compare against
+        // that rather than against the stream's dimensions.
+        if (p->prime_src_w != mp_rect_w(p->dst) ||
+            p->prime_src_h != mp_rect_h(p->dst)) {
             MP_ERR(vo, "DRM PRIME plane cannot scale %dx%d video to a %dx%d "
                        "mode. Use --hwdec=vaapi-copy or --hwdec=no.\n",
-                   mp_rect_w(p->src), mp_rect_h(p->src),
+                   p->prime_src_w, p->prime_src_h,
                    mp_rect_w(p->dst), mp_rect_h(p->dst));
             return -1;
         }
@@ -419,24 +501,87 @@ static bool enqueue_prime_frame(struct vo *vo, struct mp_image *image)
 {
     struct priv *p = vo->priv;
     struct vo_drm_state *drm = vo->drm;
-    struct mp_image *mapped = map_to_drmprime(vo, image);
-    if (!mapped)
+    AVDRMFrameDescriptor exported;
+    AVDRMFrameDescriptor *desc = NULL;
+    struct mp_image *held = NULL;
+    bool owns_fds = false;
+    int fb_w = 0, fb_h = 0;
+
+    if (p->prime_broken)
         return false;
 
-    AVDRMFrameDescriptor *desc = (AVDRMFrameDescriptor *)mapped->planes[0];
+#if HAVE_VAAPI
+    if (image->imgfmt == IMGFMT_VAAPI) {
+        if (!export_vaapi_surface(vo, image, &exported, &fb_w, &fb_h))
+            return false;
+        // Hold the SURFACE, not a mapping of it: the decoder must not reuse it
+        // while the plane is scanning it out.
+        held = mp_image_new_ref(image);
+        desc = &exported;
+        owns_fds = true;
+    }
+#endif
+
+    if (!desc) {
+        held = map_to_drmprime(vo, image);
+        if (!held)
+            return false;
+        desc = (AVDRMFrameDescriptor *)held->planes[0];
+        fb_w = held->w;
+        fb_h = held->h;
+    }
+
     struct drm_frame *frame = talloc_zero(p, struct drm_frame);
     frame->prime = true;
-    frame->prime_image = mapped;
-    if (!desc || drm_prime_create_framebuffer(vo->log, drm->fd, desc,
-                                               mapped->w, mapped->h,
-                                               &frame->prime_fb,
-                                               &p->handle_refs)) {
-        destroy_drm_frame(vo, frame);
-        return false;
+    frame->prime_image = held;
+
+    // This is where the size the hardware really produced is finally known, so
+    // it is the only place the request can be checked against the result.
+    //
+    // Test for a buffer that is too BIG as well as too small. A decoder that
+    // silently ignored the downscale hands back a full-size buffer, which
+    // passes any "is it large enough" test and is then rejected much later by
+    // the kernel, as an EINVAL on every flip and a black screen -- with nothing
+    // anywhere naming the decoder as the cause. Say it here instead.
+    bool scaled = false;
+#if HAVE_VAAPI
+    scaled = p->vaapi_ctx.scaled_w > 0;
+#endif
+    if (!desc || fb_w < p->prime_src_w || fb_h < p->prime_src_h ||
+        (scaled && (fb_w != p->prime_src_w || fb_h != p->prime_src_h)))
+    {
+        MP_ERR(vo, "Decoded buffer is %dx%d, but the video plane is configured "
+                   "to show %dx%d%s; giving up on the direct path.\n",
+               fb_w, fb_h, p->prime_src_w, p->prime_src_h,
+               scaled ? " and the decoder was asked to produce exactly that"
+                      : "");
+        // Never satisfiable by a later frame, and repeating it once per frame
+        // is the retry storm PRIME_FLIP_FAIL_LIMIT exists to prevent.
+        p->prime_broken = true;
+        disable_video_plane(vo);
+        goto fail;
+    }
+
+    if (drm_prime_create_framebuffer(vo->log, drm->fd, desc, fb_w, fb_h,
+                                     &frame->prime_fb, &p->handle_refs))
+        goto fail;
+
+    // The GEM handles hold their own references to the storage now.
+    if (owns_fds) {
+        for (int i = 0; i < desc->nb_objects; i++)
+            close(desc->objects[i].fd);
     }
 
     MP_TARRAY_APPEND(p, p->fb_queue, p->fb_queue_len, frame);
     return true;
+
+fail:
+    if (owns_fds && desc) {
+        for (int i = 0; i < desc->nb_objects; i++)
+            close(desc->objects[i].fd);
+    }
+    destroy_drm_frame(vo, frame);
+    return false;
 }
 
 static void dequeue_frame(struct vo *vo)
@@ -500,10 +645,12 @@ static void queue_flip(struct vo *vo, struct drm_frame *frame)
 
         drm_object_set_property(request, plane, "FB_ID", frame->prime_fb.fb_id);
         drm_object_set_property(request, plane, "CRTC_ID", drm->crtc_id);
-        drm_object_set_property(request, plane, "SRC_X", p->src.x0 << 16);
-        drm_object_set_property(request, plane, "SRC_Y", p->src.y0 << 16);
-        drm_object_set_property(request, plane, "SRC_W", mp_rect_w(p->src) << 16);
-        drm_object_set_property(request, plane, "SRC_H", mp_rect_h(p->src) << 16);
+        // In BUFFER coordinates, which are the stream's only when nothing
+        // scaled on the way here.
+        drm_object_set_property(request, plane, "SRC_X", 0);
+        drm_object_set_property(request, plane, "SRC_Y", 0);
+        drm_object_set_property(request, plane, "SRC_W", p->prime_src_w << 16);
+        drm_object_set_property(request, plane, "SRC_H", p->prime_src_h << 16);
         drm_object_set_property(request, plane, "CRTC_X", p->dst.x0);
         drm_object_set_property(request, plane, "CRTC_Y", p->dst.y0);
         drm_object_set_property(request, plane, "CRTC_W", mp_rect_w(p->dst));
@@ -671,6 +818,11 @@ static int preinit(struct vo *vo)
                 .driver_name = "vaapi-drm",
                 .av_device_ref = p->vaapi_ctx.av_device_ref,
                 .hw_imgfmt = IMGFMT_VAAPI,
+                // Frames reach the panel through the video plane untouched, so
+                // a decoder that can downscale should aim straight at the mode
+                // rather than produce a picture nothing is able to shrink.
+                .scanout_w = drm->mode.mode.hdisplay,
+                .scanout_h = drm->mode.mode.vdisplay,
             };
             vo->hwdec_devs = hwdec_devices_create();
             hwdec_devices_add(vo->hwdec_devs, &p->vaapi_ctx);
-- 
2.55.0

