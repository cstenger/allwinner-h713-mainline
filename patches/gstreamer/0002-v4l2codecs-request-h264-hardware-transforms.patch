+gboolean
+gst_v4l2_decoder_set_transform (GstV4l2Decoder * self, guint width,
+    guint height, guint rotation)
+{
+  struct v4l2_format format = {
+    .type = self->src_buf_type,
+  };
+  struct v4l2_control control = {
+    .id = V4L2_CID_ROTATE,
+    .value = rotation,
+  };
+  struct v4l2_selection selection = {
+    .type = self->src_buf_type,
+    .target = V4L2_SEL_TGT_COMPOSE,
+    .r.width = width,
+    .r.height = height,
+  };
+
+  g_return_val_if_fail (self->opened, FALSE);
+
+  if (rotation != 0 && rotation != 90 && rotation != 180 && rotation != 270) {
+    errno = EINVAL;
+    return FALSE;
+  }
+  if (rotation && ioctl (self->video_fd, VIDIOC_S_CTRL, &control) < 0) {
+    GST_ERROR_OBJECT (self, "VIDIOC_S_CTRL(ROTATE=%u) failed: %s",
+        rotation, g_strerror (errno));
+    return FALSE;
+  }
+
+  if (!width && !height)
+    return TRUE;
+  if (!width || !height) {
+    errno = EINVAL;
+    return FALSE;
+  }
+  if (ioctl (self->video_fd, VIDIOC_S_SELECTION, &selection) < 0) {
+    GST_ERROR_OBJECT (self, "VIDIOC_S_SELECTION(COMPOSE=%ux%u) failed: %s",
+        width, height, g_strerror (errno));
+    return FALSE;
+  }
+
+  if (ioctl (self->video_fd, VIDIOC_G_FMT, &format) < 0) {
+    GST_ERROR_OBJECT (self, "VIDIOC_G_FMT after COMPOSE failed: %s",
+        g_strerror (errno));
+    return FALSE;
+  }
+  if (V4L2_TYPE_IS_MULTIPLANAR (self->src_buf_type)) {
+    format.fmt.pix_mp.width = width;
+    format.fmt.pix_mp.height = height;
+    format.fmt.pix_mp.plane_fmt[0].bytesperline = 0;
+    format.fmt.pix_mp.plane_fmt[0].sizeimage = 0;
+  } else {
+    format.fmt.pix.width = width;
+    format.fmt.pix.height = height;
+    format.fmt.pix.bytesperline = 0;
+    format.fmt.pix.sizeimage = 0;
+  }
+  if (ioctl (self->video_fd, VIDIOC_S_FMT, &format) < 0) {
+    GST_ERROR_OBJECT (self, "VIDIOC_S_FMT transform canvas=%ux%u failed: %s",
+        width, height, g_strerror (errno));
+    return FALSE;
+  }
+
+  GST_INFO_OBJECT (self,
+      "Requested transform canvas=%ux%u rotation=%u, active=%dx%d",
+      width, height, rotation, selection.r.width, selection.r.height);
+  return TRUE;
+}
