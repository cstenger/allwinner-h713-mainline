 }
 
+gboolean
+gst_v4l2_decoder_get_compose (GstV4l2Decoder * self, guint * width,
+    guint * height)
+{
+  struct v4l2_selection selection = {
+    .type = self->src_buf_type,
+    .target = V4L2_SEL_TGT_COMPOSE,
+  };
+
+  g_return_val_if_fail (self->opened, FALSE);
+  g_return_val_if_fail (width != NULL, FALSE);
+  g_return_val_if_fail (height != NULL, FALSE);
+
+  if (ioctl (self->video_fd, VIDIOC_G_SELECTION, &selection) < 0) {
+    GST_DEBUG_OBJECT (self, "VIDIOC_G_SELECTION(COMPOSE) failed: %s",
+        g_strerror (errno));
+    return FALSE;
+  }
+
+  if (selection.r.left != 0 || selection.r.top != 0 ||
+      selection.r.width <= 0 || selection.r.height <= 0) {
+    GST_WARNING_OBJECT (self,
+        "Ignoring unsupported compose rectangle %dx%d%+d%+d",
+        selection.r.width, selection.r.height,
+        selection.r.left, selection.r.top);
+    return FALSE;
+  }
+
+  *width = selection.r.width;
+  *height = selection.r.height;
+  GST_DEBUG_OBJECT (self, "Compose rectangle is %ux%u", *width, *height);
+  return TRUE;
+}
