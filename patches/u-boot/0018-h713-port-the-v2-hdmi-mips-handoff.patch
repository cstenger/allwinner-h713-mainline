+/* Explicit V2 bench operation. Leave the normal logo-only path alone. */
+static int h713_disp_v2_hdmi_source(void)
+{
+	ulong trace = H713_MIPS_COMM_TRACE_ADDR;
+	ulong dev, table;
+	u32 pid = 0, source = 3;
+	uint i, live = 0;
+	int ret;
+
+	if (!h713_display_v2() || !h713_comm_trace_active ||
+	    readl(H713_MIPS_STATUS_REG) != 1)
+		return -ENODEV;
+
+	if (env_get("h713_v2_hdmi_pid") && env_set("h713_v2_hdmi_pid", NULL))
+		return -EIO;
+	invalidate_dcache_range(trace, trace + H713_MIPS_COMM_TRACE_SIZE);
+	if (readl(trace + 4) != H713_MIPS_COMM_TRACE_MAGIC ||
+	    readl(trace + 0x80) != H713_MIPS_COMM_TRACE_CANARY ||
+	    readl(trace + 0xffc) != H713_MIPS_COMM_TRACE_CANARY ||
+	    readl(trace + 0x7c))
+		return -EIO;
+	if (h713_mips_read_fw(0x8b122688UL) != 0x03e00008 ||
+	    h713_mips_read_fw(0x8b12268cUL) != 0x24020001)
+		return -EIO;
+	dev = h713_mips_read_fw(H713_COMM_V2_DEV_PTR);
+	if (dev < 0x8b100000UL || dev >= 0x8bffff00UL)
+		return -EINVAL;
+
+	table = dev + H713_COMM_CHAN_OFF;
+	for (i = 0; i < H713_COMM_CHAN_SLOTS; i++) {
+		ulong record = table + i * H713_COMM_CHAN_STRIDE;
+		u32 chan = h713_mips_read_fw(record);
+		u32 record_pid = h713_mips_read_fw(record + 8);
+		u32 key = h713_mips_read_fw(record + 12);
+
+		if (key == ~0U || !(key || record_pid || chan))
+			continue;
+		if (chan >> 16 || !record_pid)
+			return -EINVAL;
+		pid = record_pid;
+		live++;
+	}
+	if (live != 1) {
+		printf("H713 V2 HDMI: expected one live channel, found %u\n", live);
+		return -EINVAL;
+	}
+
+	ret = h713_comm_call(0xeaf13de5, &source, 1, 0, pid, NULL);
+	if (ret)
+		return ret;
+
+	/* RETURN and the asynchronous source transition are distinct. */
+	for (i = 0; i < 1000; i++) {
+		invalidate_dcache_range(trace, trace + H713_MIPS_COMM_TRACE_SIZE);
+		if (readl(trace + 0x7c))
+			break;
+		mdelay(1);
+	}
+	if (readl(trace + 4) != H713_MIPS_COMM_TRACE_MAGIC ||
+	    readl(trace + 0x80) != H713_MIPS_COMM_TRACE_CANARY ||
+	    readl(trace + 0xffc) != H713_MIPS_COMM_TRACE_CANARY ||
+	    readl(trace + 0x78) != source || readl(trace + 0x7c) != 1)
+		return -EIO;
+
+	h713_disp_latch_panel_timing();
+	ret = h713_disp_backlight_set(75);
+	if (ret)
+		return ret;
+	h713_disp_v2_lamp_set(true);
+	ret = env_set_hex("h713_v2_hdmi_pid", pid);
+	if (!ret)
+		printf("H713 V2 HDMI: source 3 completed, PID %08x\n", pid);
+	return ret;
+}
