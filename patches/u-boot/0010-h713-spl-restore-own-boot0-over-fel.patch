From: H713 maintainers
Subject: [PATCH] h713: FEL restore SPL writes the board's own boot0 back

The bench restore SPL (H713_SPL_FORCE_MMC) writes its payload from
spl_board_prepare_for_boot(), which runs only after U-Boot proper has
been loaded from eMMC. A board whose eMMC holds no U-Boot of ours, such
as the LPDDR3 projector (HY200_QZ713_V2) before its first install,
would never reach it. Its payload is also the bench's DDR3 SPL, which
"trains OK, reads hang" on LPDDR3.

CONFIG_H713_SPL_RESTORE_BOOT0 (default n, recovery builds only) runs
from the FEL load path instead, so only a FEL-started SPL can reach it.
It brings the eMMC up as the SPL's own MMC loader does for
BOOT_DEVICE_MMC2, writes the board's stock boot0 to LBA 16..79, reads
it back and compares, and halts. It reports whether the sectors already
held the payload.

The payload is generated at build time from that board's eMMC capture
(tools/build-v2-restore-spl.sh) into the build directory's include/,
so the vendor binary never enters the source tree. The build fails if
the payload's declared DRAM type differs from the board's config.

---
--- a/arch/arm/mach-sunxi/board.c
+++ b/arch/arm/mach-sunxi/board.c
@@ -261,9 +261,106 @@
 }
 #endif
 
+#ifdef CONFIG_H713_SPL_RESTORE_BOOT0
+#include <hang.h>
+#include <mapmem.h>
+#include <linux/string.h>
+
+/*
+ * Generated by tools/build-v2-restore-spl.sh from that board's own eMMC
+ * capture, into the build directory's include/: the stock boot0 (32 KiB at
+ * LBA 16, eGON checksum verified) as h713_restore_payload[], and the DRAM
+ * type its header declares as H713_RESTORE_DRAM_TYPE. It is a vendor binary
+ * and per board, so it never enters the source tree.
+ */
+#include <h713_restore_payload.h>
+
+#if IS_ENABLED(CONFIG_SUNXI_DRAM_LPDDR3)
+#define H713_BOARD_DRAM_TYPE	7
+#elif IS_ENABLED(CONFIG_SUNXI_DRAM_DDR3)
+#define H713_BOARD_DRAM_TYPE	3
+#else
+#error "H713_SPL_RESTORE_BOOT0: unknown DRAM type for this board"
+#endif
+
+/*
+ * A boot0 trained for the other DRAM type "trains OK, reads hang" on this
+ * board: refuse to build such a restore SPL at all.
+ */
+#if H713_RESTORE_DRAM_TYPE != H713_BOARD_DRAM_TYPE
+#error "H713_SPL_RESTORE_BOOT0: payload DRAM type differs from this board's"
+#endif
+
+#define H713_RESTORE_LBA	16
+#define H713_RESTORE_BUF	0x42000000UL	/* trained DRAM, unused by SPL */
+
+/*
+ * FEL-only restore of a board's own stock first stage. Reached only when the
+ * BROM reports a FEL boot, so it never runs from eMMC. It writes the
+ * embedded boot0 to LBA 16..79, reads it back and compares, then halts for a
+ * power cycle. Unlike the bench's H713_SPL_FORCE_MMC hook it does not wait
+ * for an image load from eMMC, so it works on a board whose eMMC holds no
+ * U-Boot of ours. The eMMC is brought up exactly as the SPL's own MMC loader
+ * does for BOOT_DEVICE_MMC2: mmc_initialize(), then device 1.
+ */
+static void __noreturn h713_restore_boot0(void)
+{
+	const unsigned long size = sizeof(h713_restore_payload);
+	const unsigned long nblk = size / 512;
+	u8 *buf = map_sysmem(H713_RESTORE_BUF, size);
+	struct blk_desc *bd;
+	struct mmc *mmc;
+	unsigned long n;
+
+	printf("\n=== H713 SPL RESTORE BOOT0 (DRAM type %d) ===\n",
+	       H713_RESTORE_DRAM_TYPE);
+
+	if (mmc_initialize(NULL)) {
+		printf("mmc_initialize failed\n");
+		hang();
+	}
+	mmc = find_mmc_device(1);
+	if (!mmc || mmc_init(mmc)) {
+		printf("no mmc device 1\n");
+		hang();
+	}
+	bd = mmc_get_blk_desc(mmc);
+	if (IS_SD(mmc) || !bd || bd->lba < H713_RESTORE_LBA + nblk) {
+		printf("mmc1 is not the eMMC (sd=%d)\n", IS_SD(mmc));
+		hang();
+	}
+	printf("mmc1: eMMC, %lu sectors\n", (unsigned long)bd->lba);
+
+	n = blk_dread(bd, H713_RESTORE_LBA, nblk, buf);
+	printf("before: %s\n", n != nblk ? "read failed" :
+	       memcmp(buf, h713_restore_payload, size) ?
+	       "differs from payload" : "already identical");
+
+	n = blk_dwrite(bd, H713_RESTORE_LBA, nblk, h713_restore_payload);
+	if (n != nblk) {
+		printf("wrote %lu/%lu FAILED\n", n, nblk);
+		hang();
+	}
+
+	memset(buf, 0, size);
+	n = blk_dread(bd, H713_RESTORE_LBA, nblk, buf);
+	if (n != nblk || memcmp(buf, h713_restore_payload, size)) {
+		printf("wrote %lu/%lu, READ-BACK MISMATCH\n", nblk, nblk);
+		hang();
+	}
+	printf("wrote %lu/%lu, read back identical: RESTORED-OK\n",
+	       nblk, nblk);
+	printf("power-cycle now\n");
+	hang();
+}
+#endif
+
 static int spl_board_load_image(struct spl_image_info *spl_image,
 				struct spl_boot_device *bootdev)
 {
+#ifdef CONFIG_H713_SPL_RESTORE_BOOT0
+	h713_restore_boot0();
+#endif
 #ifdef CONFIG_H713_SPL_FEL_REENTER
 	h713_fel_reenter();
 #endif
--- a/board/sunxi/Kconfig
+++ b/board/sunxi/Kconfig
@@ -46,6 +46,19 @@
 	  and start them.  Needs a first stage that honours one of the flags.
 	  FEL rescue builds only; never enable this in a shipping image.
 
+config H713_SPL_RESTORE_BOOT0
+	bool "H713 FEL restore: write the board's stock boot0 back to eMMC"
+	depends on MACH_SUN50I_H713 && SPL_MMC_WRITE && !H713_SPL_FEL_REENTER
+	default n
+	help
+	  When started over FEL, train DRAM, then write the board's own stock
+	  boot0 (embedded at build time from that board's eMMC capture) to
+	  LBA 16..79, read it back and compare, and halt. It does not depend
+	  on anything stored on the eMMC. The build fails if the embedded
+	  boot0 declares a different DRAM type from this board's config.
+	  Build with tools/build-v2-restore-spl.sh, which generates the
+	  payload. Recovery builds only; never enable this in a shipping image.
+
 config H713_VENDOR_CHAINLOAD
 	bool "H713: one-shot chainload of the vendor boot chain"
 	depends on MACH_SUN50I_H713
