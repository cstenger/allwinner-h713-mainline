+++ b/arch/arm/mach-sunxi/h713_mips.c
@@ -1974,6 +1974,18 @@ static const struct h713_mips_patch h713_mips_trace_patches[] = {
  * the immediate commit/dirty-latch readbacks.  These stores use only t8/t9 and
  * preserve every displaced stock instruction.
  */
+/*
+ * Every comm-trace cave runs in ordinary task, HISR or interrupt-handler
+ * context, never in an exception vector. It must not use k0/k1: the
+ * firmware's interrupt exit (0x8b101c2c/0x8b101c30) loads k0 with the saved
+ * Status and k1 with the EPC immediately before eret. An interrupt between a
+ * marker's lui/ori and its store left k0 holding Status, so the store faulted
+ * and entered the stock fatal dump, whose misaligned BadVAddr store recursed
+ * until the MIPS stack overran ARM DRAM. The markers use t8 (trace base) and
+ * t9 (value) instead; patches/u-boot/tests/t8t9-liveness.py proves both are
+ * dead at every hook site in the pinned image. The apply loop refuses any
+ * cave word that names k0 or k1.
+ */
