--- /dev/null
+++ b/arch/arm/dts/sun50i-h713-hy200-qz713df-a1-u-boot.dtsi
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: GPL-2.0+
+
+#include "sun50i-h713-u-boot.dtsi"
+
+/* The HDMI trace page is another window U-Boot fills for Linux. */
+&hdmi_trace_reserved { status = "disabled"; };
+
+/*
+ * In U-Boot, regulator-boot-on means "switch on at init" (the regulator is
+ * probed after bind and enabled). The panel must come up inside the display
+ * sequence, after the logo records and the pre-delay, so U-Boot leaves the
+ * supply off until h713_disp enables it. Linux keeps the property: there it
+ * means the bootloader left the supply on.
+ */
+&reg_panel {
+	/delete-property/ regulator-boot-on;
+};
