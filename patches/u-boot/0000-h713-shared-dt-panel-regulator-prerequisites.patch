diff --git a/arch/arm/dts/sun50i-h713-u-boot.dtsi b/arch/arm/dts/sun50i-h713-u-boot.dtsi
new file mode 100644
--- /dev/null
+++ b/arch/arm/dts/sun50i-h713-u-boot.dtsi
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * U-Boot's view of the H713 device tree.
+ *
+ * The tree itself is the kernel's, copied verbatim into dts/upstream by the
+ * h713 project's tools/build/sync-uboot-dts.sh, so U-Boot and Linux share one
+ * hardware description. Only what U-Boot must see differently lives here.
+ */
+
+#include "sunxi-u-boot.dtsi"
+
+/ {
+	aliases {
+		/*
+		 * U-Boot's numbering, which the environment and every boot
+		 * script use (mmc 1:2): the eMMC is mmc 1. Linux's own alias
+		 * (eMMC = mmc0, hence mmcblk0) stays in the kernel tree.
+		 */
+		/delete-property/ mmc0;
+		mmc1 = &mmc2;
+	};
+};
+
+/*
+ * U-Boot fills these windows (display firmware, its framebuffer and the
+ * logo, the CPU_COMM shared memory) and hands them to Linux, which keeps
+ * them. In U-Boot they must stay loadable: fs_read() refuses to write into
+ * reserved memory. The BL31 reservation stays.
+ */
+&mips_reserved { status = "disabled"; };
+&decd_reserved { status = "disabled"; };
+&cpu_comm_reserved { status = "disabled"; };
+&mips_framebuf { status = "disabled"; };
+&framebuf_reserved { status = "disabled"; };
+
+/*
+ * U-Boot's sunxi clock driver has gates and resets only, no rates; the MMC
+ * driver programs its module clock itself. An assigned rate would fail the
+ * probe with -ENOSYS.
+ */
+&mmc2 {
+	/delete-property/ assigned-clocks;
+	/delete-property/ assigned-clock-rates;
+};
+
+/* The DRD port's device side, for fastboot. */
+&usb_otg {
+	dr_mode = "peripheral";
+	status = "okay";
+};
+
+/* Hardware U-Boot does not use: left unbound, as before this tree. */
+&uart1 { status = "disabled"; };
+&ehci0 { status = "disabled"; };
+&ohci0 { status = "disabled"; };
+&ehci1 { status = "disabled"; };
+&ohci1 { status = "disabled"; };
+&ehci2 { status = "disabled"; };
+&ohci2 { status = "disabled"; };
+&r_pio { status = "disabled"; };
diff --git a/arch/arm/dts/sun50i-h713-hy200-qz713df-a1-u-boot.dtsi b/arch/arm/dts/sun50i-h713-hy200-qz713df-a1-u-boot.dtsi
