+		if ((readl(H713_CCU_PWM_BGR) & (BIT(0) | BIT(16))) ==
+		    (BIT(0) | BIT(16)))
+			clrbits_le32((void *)H713_PWM_ENABLE, BIT(H713_BL_PWM_CH));
+	}
+
