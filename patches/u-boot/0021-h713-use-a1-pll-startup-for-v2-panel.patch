+static const struct h713_logo_rec h713_v2_a1_pll_startup[] = {
+	{ 0x00000000, 0x00000014, 0x00000001, 0xff },
+	{ 0x058c0014, 0x20000000, 0x20000000, 0x04 },
+	{ 0x00000000, 0x00000014, 0x00000001, 0xff },
+	{ 0x058c0014, 0x08000000, 0x08000000, 0x04 },
+	{ 0x00000000, 0x000001f4, 0x00000001, 0xff },
+	{ 0x058c0028, 0x00000000, 0xffffffff, 0x04 },
+	{ 0x058c0014, 0x0000001e, 0x0000fffe, 0x04 },
+	{ 0x00000000, 0x00003a98, 0x00000001, 0xff },
+	{ 0x058c0014, 0x00000000, 0x80000000, 0xfe },
+	{ 0x00000000, 0x00003a98, 0x00000001, 0xff },
+	{ 0x058c0014, 0x00002a00, 0x0000ffff, 0x04 },
+	{ 0x058c0028, 0x00030000, 0xffffffff, 0x04 },
+	{ 0x00000000, 0x000001f4, 0x00000001, 0xff },
 };
 
-static int h713_disp_apply_timing(ulong blob,
-				 const struct h713_disp_block *timing)
-{
-	const ulong v2_pll_restart = 0x1684;
-	u32 pll;
-	int ret;
-
-	if (timing != &h713_disp_v2_blocks[1])
-		return h713_logo_walk(blob, timing->start, timing->end, true);
+#define H713_V2_PLL_PREFIX_SIZE	(H713_V2_PLL_FIRST_DELAY - H713_V2_TIMING_START)
+#define H713_V2_TIMING_TAIL_SIZE	(H713_V2_TIMING_END - H713_V2_ROUTING_START)
 
-	/*
-	 * The native V2 table leaves the panel black with our boot sequence.
-	 * Restart the PLL after its last setup delay, before the routing
-	 * writes. A single enable pulse restores the logo on the V2.
-	 */
-	ret = h713_logo_walk(blob, timing->start, v2_pll_restart, true);
-	if (ret)
-		return ret;
-
-	pll = readl(H713_DISP_PLL_REG);
-	writel(pll & ~BIT(31), H713_DISP_PLL_REG);
-	writel(pll | BIT(31), H713_DISP_PLL_REG);
-	printf("H713 disp: restarted PLL during native V2 timing\n");
-
-	return h713_logo_walk(blob, v2_pll_restart, timing->end, true);
-}
+/* Native V2 LogoRegData revision 24-6-3-82, project 0x34. */
+static const struct h713_disp_block h713_disp_v2_blocks[] = {
+	{ 0x072c, 0x0a04 },
+	{ H713_V2_TIMING_OFFSET, H713_V2_TIMING_OFFSET + H713_V2_PLL_PREFIX_SIZE +
+	  sizeof(h713_v2_a1_pll_startup) + H713_V2_TIMING_TAIL_SIZE },
+	{ 0x34ac, 0x382c },
+};
 
 struct h713_disp_sel {
 	u32 project, prologue, timing, de;
@@ -5913,7 +5916,8 @@
 			     sel.blocks[0]->end, true);
 	if (ret)
 		return ret;
-	ret = h713_disp_apply_timing(blob, sel.blocks[1]);
+	ret = h713_logo_walk(blob, sel.blocks[1]->start,
+			     sel.blocks[1]->end, true);
 	if (ret)
 		return ret;
 
@@ -6285,9 +6289,23 @@
 				printf("H713 disp: staged A1 timing identity rejected\n");
 				return -EPERM;
 			}
-			memcpy((void *)(H713_DISP_LOGO_ADDR + H713_V2_A1_TIMING_OFFSET),
+			memcpy((void *)(H713_DISP_LOGO_ADDR + H713_V2_TIMING_OFFSET),
 			       timing, H713_V2_A1_TIMING_SIZE);
 			printf("H713 disp: using the verified A1 timing block from RAM\n");
+		} else {
+			const u8 *native = (const u8 *)H713_DISP_LOGO_ADDR;
+			u8 *timing = (u8 *)H713_DISP_LOGO_ADDR + H713_V2_TIMING_OFFSET;
+
+			/* Stage before the panel config pass adjusts the divider. */
+			memcpy(timing, native + H713_V2_TIMING_START,
+			       H713_V2_PLL_PREFIX_SIZE);
+			timing += H713_V2_PLL_PREFIX_SIZE;
+			memcpy(timing, h713_v2_a1_pll_startup,
+			       sizeof(h713_v2_a1_pll_startup));
+			timing += sizeof(h713_v2_a1_pll_startup);
+			memcpy(timing, native + H713_V2_ROUTING_START,
+			       H713_V2_TIMING_TAIL_SIZE);
+			printf("H713 disp: using A1 PLL startup with native V2 timing\n");
 		}
 	}
 
