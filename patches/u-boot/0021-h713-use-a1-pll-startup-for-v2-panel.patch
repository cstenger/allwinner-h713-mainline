Subject: sunxi: H713: use the A1 panel PLL startup on V2

Replace the single pulse in the native V2 timing path with the A1 PLL
startup sequence. Its longer delays bracket divider programming and
the PLL enable pulse. Keep the V2 clock gate, routing and TVTOP reset
records, and stage the combined timing block before the panel config
pass so both divider records use the configured panel clock.

The operator saw a logo in three HDMI-connected warm FEL trials of
this sequence after U-Boot teardown. The single-pulse controls also
showed a logo. Qualification across ordinary Linux warm reboots is
still pending.

--- a/arch/arm/mach-sunxi/h713_mips.c
+++ b/arch/arm/mach-sunxi/h713_mips.c
@@ -4743,7 +4743,11 @@
 #define H713_V2_LOGOREG_SIZE		0x382c
 #define H713_V2_A1_TIMING_ADDR		0x60000000UL
 #define H713_V2_A1_TIMING_SIZE		0x288
-#define H713_V2_A1_TIMING_OFFSET	0x4000
+#define H713_V2_TIMING_OFFSET		0x4000
+#define H713_V2_TIMING_START		0x15d4
+#define H713_V2_PLL_FIRST_DELAY		0x1634
+#define H713_V2_ROUTING_START		0x1684
+#define H713_V2_TIMING_END		0x180c
 
 static const u8 h713_v2_logoreg_sha256[SHA256_SUM_LEN] = {
 	0x15, 0x4e, 0x31, 0xe9, 0xd6, 0x22, 0x41, 0x08,
@@ -4761,41 +4765,40 @@
 };
 
 static const struct h713_disp_block h713_disp_v2_a1_timing = {
-	H713_V2_A1_TIMING_OFFSET,
-	H713_V2_A1_TIMING_OFFSET + H713_V2_A1_TIMING_SIZE,
+	H713_V2_TIMING_OFFSET,
+	H713_V2_TIMING_OFFSET + H713_V2_A1_TIMING_SIZE,
 };
 
-/* Native V2 LogoRegData revision 24-6-3-82, project 0x34. */
-static const struct h713_disp_block h713_disp_v2_blocks[] = {
-	{ 0x072c, 0x0a04 }, { 0x15d4, 0x180c }, { 0x34ac, 0x382c },
