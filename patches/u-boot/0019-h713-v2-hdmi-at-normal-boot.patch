+/*
+ * Bench command: also export the PID to a hand-written RAM boot script.
+ * Normal boots use h713_disp_v2_boot(), which keeps the PID out of the
+ * environment that bootmeth_rauc saves.
+ */
+static int h713_disp_v2_hdmi_source(void)
+{
+	u32 pid;
+	int ret;
+
+	if (env_get("h713_v2_hdmi_pid") && env_set("h713_v2_hdmi_pid", NULL))
+		return -EIO;
+	ret = h713_disp_v2_select_source(&pid);
+	if (ret)
+		return ret;
+	return env_set_hex("h713_v2_hdmi_pid", pid);
 }
 
