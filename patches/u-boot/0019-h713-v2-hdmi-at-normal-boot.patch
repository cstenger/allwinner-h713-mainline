+/*
+ * Normal V2 boot, run from PREBOOT. After power loss, or after a boot whose
+ * HDMI start Linux acknowledged, launch the display firmware once with the
+ * CPU_COMM trace and select source 3, then boot with the handoff. Otherwise
+ * show the logo with the core quiesced, as before HDMI.
+ *
+ * A failure after the latch is set resets the SoC instead of attempting a
+ * second launch in this boot. The latch then routes the next boot to the
+ * logo-only path, which the bench board recovered through after an
+ * emergency reset with the firmware running (2026-10-18). No slot attempt
+ * is spent: bootmeth_rauc has not run yet.
+ */
+static int h713_disp_v2_boot(void)
+{
+	u32 latch = readl(H713_RTC_GP6_REG);
+	u32 status = readl(H713_MIPS_STATUS_REG);
+	u32 pid;
+	int ret;
+
+	if (!h713_display_v2())
+		return -ENODEV;
+
+	if ((latch && latch != H713_HDMI_LATCH_OK) || status) {
+		printf("H713 V2 HDMI: latch %08x, MIPS status %08x: logo only "
+		       "this boot\n", latch, status);
+		return h713_disp_auto_logo(0x34, NULL);
+	}
+
+	writel(H713_HDMI_LATCH, H713_RTC_GP6_REG);
+	if (readl(H713_RTC_GP6_REG) != H713_HDMI_LATCH) {
+		printf("H713 V2 HDMI: launch latch did not stick: logo only\n");
+		return h713_disp_auto_logo(0x34, NULL);
+	}
+
+	/* PB5 also runs the fan: low only for the launch and source switch. */
+	h713_disp_v2_lamp_set(false);
+	ret = h713_disp_auto_logo_single(0x34);
+	if (!ret)
+		ret = h713_disp_comm_dev();
+	if (!ret)
+		ret = h713_disp_v2_select_source(&pid);
+	if (!ret)
+		return 0;
+
+	printf("H713 V2 HDMI: startup failed (%d); resetting for a logo-only "
+	       "boot\n", ret);
+	h713_v2_handoff_pid = 0;
+	mdelay(100);
+	reset_cpu();
+	return ret;
+}
+
+/* The kernel trees reserve 256 KiB here (hdmi-trace@4d980000, no-map). */
+#define H713_MIPS_COMM_TRACE_RESERVE	0x40000UL
+
+/*
+ * bootm FDT fixup (board/sunxi/board.c ft_board_setup).
+ *
+ * While the CPU_COMM trace is installed, the running firmware keeps writing
+ * its trace page. A kernel tree without the trace reservation (a slot built
+ * before kernel 0218) would hand that memory to Linux, so reserve it here
+ * whenever the tree does not.
+ *
+ * Then publish this boot's source 3 handoff as /chosen/h713,hdmi-boot-v1 =
+ * <"HDMI" 0 pid>, only to a V2 tree that describes the HDMI resources.
+ * Without a handoff, or on any FDT error, boot without one: the HDMI
+ * services stay off and the latch makes the next boot logo-only.
+ */
+int h713_mips_ft_setup(void *blob)
+{
+	bool described = fdt_path_offset(blob,
+		"/reserved-memory/hdmi-trace@4d980000") >= 0;
+	fdt32_t handoff[3];
+	int node, ret;
+
+	if (h713_comm_trace_active && !described) {
+		ret = fdt_add_mem_rsv(blob, H713_MIPS_COMM_TRACE_ADDR,
+				      H713_MIPS_COMM_TRACE_RESERVE);
+		printf("H713 MIPS: boot FDT lacks the trace reservation; "
+		       "/memreserve/ added (%s)\n",
+		       ret ? fdt_strerror(ret) : "ok");
+		if (ret)
+			return ret;
+	}
+	if (!h713_v2_handoff_pid)
+		return 0;
+	if (fdt_node_check_compatible(blob, 0, "cstenger,hy200-qz713-v2") ||
+	    !described || fdt_path_offset(blob, "/soc/hdmi-mips-shutdown") < 0) {
+		printf("H713 V2 HDMI: boot FDT lacks the V2 HDMI resources; "
+		       "no handoff\n");
+		return 0;
+	}
+	handoff[0] = cpu_to_fdt32(H713_HDMI_LATCH);
+	handoff[1] = cpu_to_fdt32(0);
+	handoff[2] = cpu_to_fdt32(h713_v2_handoff_pid);
+	node = fdt_find_or_add_subnode(blob, 0, "chosen");
+	ret = node < 0 ? node : fdt_setprop(blob, node, "h713,hdmi-boot-v1",
+					     handoff, sizeof(handoff));
+	if (ret)
+		printf("H713 V2 HDMI: FDT handoff failed (%s); booting without "
+		       "it\n", fdt_strerror(ret));
+	else
+		printf("H713 V2 HDMI: handoff PID %08x in /chosen\n",
+		       h713_v2_handoff_pid);
+	return 0;
+}
+
