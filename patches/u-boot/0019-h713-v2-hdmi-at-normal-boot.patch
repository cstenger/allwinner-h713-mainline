-/* Explicit V2 bench operation. Leave the normal logo-only path alone. */
-static int h713_disp_v2_hdmi_source(void)
+/*
+ * RTC GP6, the once-per-power-cycle HDMI launch latch shared with the bench
+ * board's startup script. 0 after power loss. U-Boot writes HDMI before it
+ * launches the firmware for capture; Linux's h713-hdmi-health-ack writes
+ * HDOK once the HDMI services started healthily. Any other value at the next
+ * boot means that start never finished, so that boot shows the logo only.
+ * GP7 (0x0709011c) remains the reboot-mode word.
+ */
+#define H713_RTC_GP6_REG	0x07090118UL
+#define H713_HDMI_LATCH		0x48444d49	/* "HDMI" */
+#define H713_HDMI_LATCH_OK	0x48444f4b	/* "HDOK" */
+
+/* Source 3 PID from this boot's completed handoff; 0 = no handoff. */
+static u32 h713_v2_handoff_pid;
