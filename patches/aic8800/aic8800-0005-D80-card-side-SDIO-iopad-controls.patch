From a6c774bb7727cb4f95056a0512afe9e4af72a768 Mon Sep 17 00:00:00 2001
From: h713 <build@h713>
Date: Tue, 18 Aug 2026 21:39:02 -0700
Subject: [PATCH] aic8800: expose D80 card-side SDIO iopad controls as module
 params

---
 aic8800_bsp/aicsdio.c | 54 +++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 54 insertions(+)

diff --git a/aic8800_bsp/aicsdio.c b/aic8800_bsp/aicsdio.c
index a57219d..6bde326 100644
--- a/aic8800_bsp/aicsdio.c
+++ b/aic8800_bsp/aicsdio.c
@@ -854,6 +854,30 @@ void aicbsp_sdio_release(struct aic_sdio_dev *sdiodev)
 	}
 }
 
+/*
+ * Card-side SDIO iopad controls (function 0, vendor registers).  The vendor
+ * source has these under #if 0 for the D80 path, which leaves the AIC8800 at
+ * its power-on pad timing.  They are the only knobs on the card half of the
+ * link, so expose them:
+ *
+ *   0xF0 iopad control (vendor uses 0x01 | SDIOCLK_FREE_RUNNING_BIT)
+ *   0xF1 iopad delay 1 (vendor uses 0x40)
+ *   0xF8 iopad delay 2 (vendor uses 0x00)
+ *
+ * -1 leaves the register untouched, preserving current behaviour.
+ */
+static int aic_iopad_ctrl = -1;
+module_param(aic_iopad_ctrl, int, 0644);
+MODULE_PARM_DESC(aic_iopad_ctrl, "AIC8800 fn0 0xF0 iopad control (-1 = leave alone)");
+
+static int aic_iopad_dly1 = -1;
+module_param(aic_iopad_dly1, int, 0644);
+MODULE_PARM_DESC(aic_iopad_dly1, "AIC8800 fn0 0xF1 iopad delay 1 (-1 = leave alone)");
+
+static int aic_iopad_dly2 = -1;
+module_param(aic_iopad_dly2, int, 0644);
+MODULE_PARM_DESC(aic_iopad_dly2, "AIC8800 fn0 0xF8 iopad delay 2 (-1 = leave alone)");
+
 int aicwf_sdio_readb(struct aic_sdio_dev *sdiodev, uint regaddr, u8 *val)
 {
 	int ret;
@@ -2094,6 +2118,36 @@ int aicwf_sdiov3_func_init(struct aic_sdio_dev *sdiodev)
         sdio_release_host(sdiodev->func);
         return ret;
     }
+
+    if (aic_iopad_ctrl >= 0 || aic_iopad_dly1 >= 0 || aic_iopad_dly2 >= 0) {
+        if (aic_iopad_ctrl >= 0) {
+            sdio_f0_writeb(sdiodev->func, (u8)aic_iopad_ctrl, 0xF0, &ret);
+            if (ret) {
+                sdio_err("set iopad ctrl fail %d\n", ret);
+                sdio_release_host(sdiodev->func);
+                return ret;
+            }
+        }
+        if (aic_iopad_dly2 >= 0) {
+            sdio_f0_writeb(sdiodev->func, (u8)aic_iopad_dly2, 0xF8, &ret);
+            if (ret) {
+                sdio_err("set iopad delay2 fail %d\n", ret);
+                sdio_release_host(sdiodev->func);
+                return ret;
+            }
+        }
+        if (aic_iopad_dly1 >= 0) {
+            sdio_f0_writeb(sdiodev->func, (u8)aic_iopad_dly1, 0xF1, &ret);
+            if (ret) {
+                sdio_err("set iopad delay1 fail %d\n", ret);
+                sdio_release_host(sdiodev->func);
+                return ret;
+            }
+        }
+        msleep(1);
+        sdio_dbg("iopad: ctrl=%d dly1=%d dly2=%d\n",
+                 aic_iopad_ctrl, aic_iopad_dly1, aic_iopad_dly2);
+    }
 #if 0
     if (host->ios.timing == MMC_TIMING_UHS_DDR50) {
         val = 0x21;//0x1D;//0x5;
-- 
