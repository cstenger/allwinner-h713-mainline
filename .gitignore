# Build artifacts and large binaries — never committed.
#
# build/ is generated output only; the scripts that produce it live in
# tools/build/, so the whole directory is ignored rather than enumerated
# subdirectory by subdirectory. Keep it pruned — see config/paths.sh.
/build/
*.bin
*.fit
*.img
*.ext4
*.simg
*.tar
*.dtb
Image
Image.gz
zImage*
# Pinned source trees are fetched by the build, not vendored
linux-*/
rootfs-build/
# Proprietary/local-only recovery material — keep in the workspace, never Git
local/

# Editor/OS cruft
*.swp
.DS_Store
__pycache__/
*.pyc

# User-owned Magisk boot-image backup metadata, dropped here by an Android
# extraction. Not ours to track or remove -- see docs/handoff-wifi-sdio-2026-08-17.md.
.backup/
# generated test cards -- regenerate with tools/display/make-scaler-testcard.py
local/testcards/

# Out-of-tree kernel module build products. Keep bench sources and Makefiles.
/modules/**/*.o
/modules/**/*.ko
/modules/**/.*.cmd
/modules/**/*.mod
/modules/**/*.mod.c
/modules/**/Module.symvers
/modules/**/modules.order
/modules/**/.tmp_versions/

# Raw bench media stays local; retain summaries, hashes, scripts and figures.
/docs/hdmi-evidence/**/*.wav
/docs/hdmi-evidence/**/*.nv16
/docs/hdmi-evidence/**/*.mkv
