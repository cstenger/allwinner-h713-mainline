+ set -u
+ RUN=/run/h713-standby
+ LAMP=/sys/class/backlight/lamp
+ POLICY=/sys/devices/system/cpu/cpufreq/policy0
+ PLAYERS=h713-play gst-plane-play mpv
+ enter
+ state
+ cat /run/h713-standby/state
+ echo off
+ [ off = on ]
+ [ -w /sys/class/backlight/lamp/bl_power ]
