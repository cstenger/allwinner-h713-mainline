+class EarlyDdc(unittest.TestCase):
+    def setUp(self):self.b=FakeBoard()
+    def ddc_events(self):return [e for e in self.b.events if 'ddc' in str(e).lower()]
+    def test_default_start_never_touches_ddc(self):
+        m.Session(self.b,'/bundle').start()
+        self.assertEqual(self.ddc_events(),[]);self.assertNotIn(m.EARLY_DDC,self.b.files)
+    def test_early_claim_precedes_the_edid_clock_stage(self):
+        m.Session(self.b,'/bundle',early_ddc=True).start()
+        ev=self.b.events;cc=m.BASE+m.OWNER+'/parameters/clock_count'
+        stages=[i for i,e in enumerate(ev) if e==('write',cc)]
+        self.assertEqual([self.b.writes[[j for j,w in enumerate(self.b.writes) if w[0]==cc][k]][1] for k in range(4)],['1\n','2\n','3\n','4\n'])
+        marked=ev.index(('mark',m.EARLY_DDC))
+        claimed=ev.index(('run',['insmod','/bundle/h713-ddc-pins.ko','run=1']))
+        audio=next(i for i,e in enumerate(ev) if e[0]=='run' and e[1][0]=='insmod' and e[1][1].endswith('h713-hdmi-audio.ko'))
+        self.assertTrue(stages[2] < marked < claimed < stages[3] < audio)
+        between=[e for e in ev[claimed+1:stages[3]]]
+        self.assertEqual(between,[])  # nothing between the pin claim and the EDID clock stage
+        self.assertIn(m.DDC,self.b.modules)
+    def test_early_claim_refused_when_edid_already_clocked(self):
+        s=m.Session(self.b,'/bundle',early_ddc=True)
+        orig=self.b.run
+        def run(argv,check=True,timeout=15):
+            r=orig(argv,check,timeout)
+            if argv[0]=='insmod' and argv[1].endswith('h713-hdmi-receiver.ko'):self.b.param(m.OWNER,'clock_count',4)
+            return r
+        self.b.run=run
+        with self.assertRaisesRegex(RuntimeError,'already clocked'):s.start()
+        self.assertNotIn(m.DDC,self.b.modules)
+    def test_unverified_early_claim_fails_before_audio(self):
+        self.b.fail_ddc=True
+        with self.assertRaisesRegex(RuntimeError,'early DDC claim not verified'):m.Session(self.b,'/bundle',early_ddc=True).start()
+        self.assertNotIn(m.AUDIO,self.b.modules)
+        self.assertEqual(json.loads(self.b.files[m.STATE])['phase'],'failed')
+    def test_shutdown_releases_an_unadopted_early_hold_first(self):
+        s=m.Session(self.b,'/bundle',early_ddc=True);s.start();self.b.param(m.OWNER,'shutdown_ready','Y')
+        s.shutdown()
+        ev=self.b.events
+        released=ev.index(('write',m.BASE+m.DDC+'/parameters/release'))
+        removed=ev.index(('run',['rmmod',m.DDC]))
+        audio=ev.index(('run',['rmmod',m.AUDIO]))
+        self.assertTrue(released < removed < audio)
+        self.assertNotIn(m.EARLY_DDC,self.b.files);self.assertNotIn(m.DDC,self.b.modules)
+    def test_adopted_or_foreign_hold_still_blocks_shutdown(self):
+        s=m.Session(self.b,'/bundle',early_ddc=True);s.start();self.b.param(m.OWNER,'shutdown_ready','Y')
+        del self.b.files[m.EARLY_DDC]  # the signal service adopted it
+        before=len(self.b.events)
+        with self.assertRaisesRegex(RuntimeError,'signal owner/helper'):s.shutdown()
+        self.assertEqual(len(self.b.events),before)
+        self.b.files[m.EARLY_DDC]='other-boot\n'
+        with self.assertRaisesRegex(RuntimeError,'signal owner/helper'):s.shutdown()
+
 if __name__=='__main__':unittest.main()
