index 19975d265bd..1fe941be99d 100644
--- a/arch/arm/mach-sunxi/board.c
+++ b/arch/arm/mach-sunxi/board.c
@@ -371,7 +371,7 @@ unsigned long board_spl_mmc_get_uboot_raw_sector(struct mmc *mmc,
 	return sector;
 }
 
-#ifdef CONFIG_H713_SPL_FORCE_MMC
+#if defined(CONFIG_H713_SPL_FORCE_MMC) && !defined(CONFIG_H713_SPL_RESCUE)
 #include <mmc.h>
 #include "h713_spl_payload.h"
 
@@ -436,6 +436,28 @@ void spl_board_prepare_for_boot(void)
 }
 #endif
 
+#ifdef CONFIG_H713_SPL_RESCUE
+#include <sunxi_image.h>
+
+/*
+ * Rescue: the FEL loader leaves "eGON.FEL" in the SPL header in SRAM, so
+ * U-Boot proper's sunxi_get_boot_device() reports BOOT_DEVICE_BOARD and
+ * env_get_location() finds no environment driver (ENV_IS_IN_MMC only);
+ * env_init() then fails before the console exists and the board halts
+ * silently. U-Boot proper was loaded from eMMC, so say so: restore the
+ * eGON magic and mark the boot medium as eMMC (MMC2). Proper is unchanged.
+ */
+void spl_board_prepare_for_boot(void)
+{
+	struct boot_file_head *head = (void *)(ulong)SPL_ADDR;
+
+	memcpy(head->magic, BOOT0_MAGIC, sizeof(head->magic));
+	writeb(SUNXI_BOOTED_FROM_MMC2, &head->boot_media);
+	head->fel_script_address = 0;
+	printf("H713 rescue: SPL header marked eMMC boot for U-Boot proper\n");
+}
+#endif
+
 u32 spl_boot_device(void)
 {
 #ifdef CONFIG_H713_SPL_FORCE_MMC
