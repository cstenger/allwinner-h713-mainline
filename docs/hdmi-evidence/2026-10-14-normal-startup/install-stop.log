# /etc/systemd/system/h713-hdmi-capture.service
[Unit]
Description=H713 HDMI audio capture
After=systemd-modules-load.service user@1000.service
Before=shutdown.target
RequiresMountsFor=/usr/lib/h713-hdmi /run/h713-hdmi-session
ConditionPathExists=/proc/device-tree/chosen/h713,hdmi-boot-v1

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /usr/lib/h713-hdmi/h713-hdmi-session.py start --bundle /usr/lib/h713-hdmi --boot-handoff
ExecStop=/usr/bin/python3 /usr/lib/h713-hdmi/h713-hdmi-session.py shutdown --bundle /usr/lib/h713-hdmi --terminal-shutdown
Restart=no
TimeoutStartSec=60
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target

# /run/systemd/system/h713-hdmi-capture.service.d/10-terminal-shutdown.conf
# Runtime-only opt-in for the validated --park-capable cold boot.
[Service]
ExecStop=
ExecStop=/usr/bin/python3 /tmp/h713-linux-return/h713-hdmi-session.py shutdown --terminal-shutdown
TimeoutStopSec=60
enabled
